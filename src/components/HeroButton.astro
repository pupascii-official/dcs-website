---
interface Props {
	label: string;
	href?: string;
	docRef?: string;
	pdfTitle?: string;
}

const { label, href, docRef, pdfTitle } = Astro.props;
const baseClass =
	"mt-8 inline-block rounded-full bg-white px-8 py-2 text-lg shadow-md transition-all duration-200 hover:-translate-y-1 hover:shadow-lg cursor-pointer";
---

{docRef ? (
	<button
		type="button"
		data-doc-ref={docRef}
		data-pdf-title={pdfTitle ?? label}
		class={baseClass}
	>
		<span class="main-button text-center font-bold">{label} &ThinSpace;↗</span>
	</button>
) : (
	<a href={href} class={baseClass}>
		<span class="main-button text-center font-bold">{label} &ThinSpace;↗</span>
	</a>
)}

<style>
	.main-button {
		background: linear-gradient(90deg, #800000, #B8860B, #5C0000);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}
</style>
