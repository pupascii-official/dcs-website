<div class="scrollbar" aria-hidden="true">
    <div class="scrollbar-thumb"></div>
</div>

<style>
    .scrollbar {
        position: fixed;
        right: 2px;
        z-index: 66;
        width: 14px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .scrollbar.visible {
        opacity: 1;
    }

    .scrollbar-thumb {
        position: relative;
        width: 100%;
        cursor: grab;
        touch-action: none;
    }

    .scrollbar.visible .scrollbar-thumb {
        pointer-events: auto;
    }

    .scrollbar-thumb.dragging {
        cursor: grabbing;
    }

    .scrollbar-thumb::after {
        content: "";
        position: absolute;
        top: 0;
        right: 4px;
        bottom: 0;
        width: 4px;
        border-radius: 4px;
        background-color: var(--color-maroon);
    }

    :global(html) {
        scrollbar-width: none;
    }

    :global(html::-webkit-scrollbar) {
        display: none;
    }
</style>

<script>
    const GAP = 8;
    const MIN_THUMB_HEIGHT = 32;

    const bar = document.querySelector<HTMLElement>(".scrollbar");
    const thumb = document.querySelector<HTMLElement>(".scrollbar-thumb");

    let drag: { startY: number; startScroll: number } | null = null;

    function measure() {
        const hero = document.querySelector<HTMLElement>("section.hero");
        const footer = document.querySelector<HTMLElement>("footer.site_footer");

        const view = window.innerHeight;
        const scroll = window.scrollY;
        const heroBottom = hero ? hero.getBoundingClientRect().bottom : 0;
        const footerTop = footer ? footer.getBoundingClientRect().top : view;

        const start = hero ? heroBottom + scroll : 0;
        const end = document.documentElement.scrollHeight - view;
        const total = end - start;

        const trackTop = Math.max(GAP, heroBottom + GAP);
        const trackBottom = Math.min(view - GAP, footerTop - GAP);
        const trackHeight = trackBottom - trackTop;
        const thumbHeight = Math.max(MIN_THUMB_HEIGHT, trackHeight * (view / (total + view)));

        return { view, heroBottom, start, total, position: scroll - start, trackTop, trackHeight, thumbHeight };
    }

    function update() {
        if (!bar || !thumb) return;

        const layout = measure();
        const progress = layout.total > 0 ? Math.min(Math.max(layout.position / layout.total, 0), 1) : 0;

        bar.style.top = `${layout.trackTop}px`;
        bar.style.height = `${layout.trackHeight}px`;
        thumb.style.height = `${layout.thumbHeight}px`;
        thumb.style.transform = `translateY(${progress * (layout.trackHeight - layout.thumbHeight)}px)`;

        const visible =
            drag !== null ||
            (layout.total > 0 && layout.heroBottom < layout.view / 2 && layout.trackHeight > MIN_THUMB_HEIGHT);
        bar.classList.toggle("visible", visible);
    }

    function stopDrag() {
        if (!thumb || !drag) return;
        drag = null;
        thumb.classList.remove("dragging");
    }

    if (bar && thumb) {
        thumb.addEventListener("pointerdown", (event) => {
            drag = { startY: event.clientY, startScroll: window.scrollY };
            thumb.classList.add("dragging");
            thumb.setPointerCapture(event.pointerId);
            event.preventDefault();
        });

        thumb.addEventListener("pointermove", (event) => {
            if (!drag) return;
            const layout = measure();
            const freeSpace = layout.trackHeight - layout.thumbHeight;
            if (freeSpace <= 0) return;
            const target = drag.startScroll + ((event.clientY - drag.startY) / freeSpace) * layout.total;
            window.scrollTo({ top: target, behavior: "instant" });
        });

        thumb.addEventListener("pointerup", stopDrag);
        thumb.addEventListener("pointercancel", stopDrag);

        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        new ResizeObserver(update).observe(document.body);
        update();
    }
</script>
