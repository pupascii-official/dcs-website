<div class="scrollbar" aria-hidden="true">
    <div class="scrollbar-thumb"></div>
</div>

<style>
    .scrollbar {
        position: fixed;
        right: 2px;
        z-index: 66;
        width: 14px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .scrollbar.visible {
        opacity: 1;
    }

    .scrollbar-thumb {
        position: relative;
        width: 100%;
        cursor: grab;
        touch-action: none;
    }

    .scrollbar.visible .scrollbar-thumb {
        pointer-events: auto;
    }

    .scrollbar-thumb.dragging {
        cursor: grabbing;
    }

    .scrollbar-thumb::after {
        content: "";
        position: absolute;
        top: 0;
        right: 4px;
        bottom: 0;
        width: 4px;
        border-radius: 4px;
        background-color: var(--color-maroon);
    }

    :global(.scroll-section) {
        scrollbar-width: none;
    }

    :global(.scroll-section::-webkit-scrollbar) {
        display: none;
    }
</style>

<script>
    const GAP = 8;
    const MIN_THUMB_HEIGHT = 32;

    const container = document.querySelector<HTMLElement>(".scroll-container");
    const bar = document.querySelector<HTMLElement>(".scrollbar");
    const thumb = document.querySelector<HTMLElement>(".scrollbar-thumb");

    let drag: { startY: number; startPosition: number } | null = null;

    function measure(container: HTMLElement) {
        const hero = container.querySelector<HTMLElement>(":scope > .hero");
        const footer = container.querySelector<HTMLElement>(":scope > footer");
        const sections = [...container.querySelectorAll<HTMLElement>(":scope > .scroll-section:not(.hero)")];

        const box = container.getBoundingClientRect();
        const view = container.clientHeight;
        const heroBottom = hero ? hero.getBoundingClientRect().bottom - box.top : 0;
        const footerTop = footer ? footer.getBoundingClientRect().top - box.top : view;

        const start = heroBottom + container.scrollTop;
        const end = (footer ? footerTop + container.scrollTop : container.scrollHeight) - view;

        const parts = sections.map((section) => ({
            section,
            top: section.getBoundingClientRect().top - box.top + container.scrollTop,
            innerMax: section.scrollHeight - section.clientHeight,
        }));

        const total = end - start + parts.reduce((sum, part) => sum + part.innerMax, 0);
        const position = container.scrollTop - start + parts.reduce((sum, part) => sum + part.section.scrollTop, 0);

        const trackTop = Math.max(GAP, heroBottom + GAP);
        const trackBottom = Math.min(view - GAP, footerTop - GAP);
        const trackHeight = trackBottom - trackTop;
        const thumbHeight = Math.max(MIN_THUMB_HEIGHT, trackHeight * (view / (total + view)));

        return { box, view, heroBottom, start, end, parts, total, position, trackTop, trackHeight, thumbHeight };
    }

    function scrollToPosition(container: HTMLElement, layout: ReturnType<typeof measure>, target: number) {
        let remaining = Math.min(Math.max(target, 0), layout.total);
        let mainTop = layout.start;

        layout.parts.forEach((part) => {
            const sectionTop = Math.min(Math.max(part.top, layout.start), layout.end);
            const move = Math.min(remaining, Math.max(sectionTop - mainTop, 0));
            mainTop += move;
            remaining -= move;

            const inner = Math.min(remaining, part.innerMax);
            part.section.scrollTop = inner;
            remaining -= inner;
        });

        container.scrollTop = mainTop + remaining;
    }

    function update() {
        if (!container || !bar || !thumb) return;

        const layout = measure(container);
        const progress = layout.total > 0 ? Math.min(Math.max(layout.position / layout.total, 0), 1) : 0;

        bar.style.top = `${layout.box.top + layout.trackTop}px`;
        bar.style.height = `${layout.trackHeight}px`;
        thumb.style.height = `${layout.thumbHeight}px`;
        thumb.style.transform = `translateY(${progress * (layout.trackHeight - layout.thumbHeight)}px)`;

        const visible =
            drag !== null ||
            (layout.total > 0 && layout.heroBottom < layout.view / 2 && layout.trackHeight > MIN_THUMB_HEIGHT);
        bar.classList.toggle("visible", visible);
    }

    function stopDrag() {
        if (!container || !thumb || !drag) return;
        drag = null;
        thumb.classList.remove("dragging");
        container.style.scrollSnapType = "";
    }

    if (container && thumb) {
        thumb.addEventListener("pointerdown", (event) => {
            drag = { startY: event.clientY, startPosition: measure(container).position };
            thumb.classList.add("dragging");
            thumb.setPointerCapture(event.pointerId);
            container.style.scrollSnapType = "none";
            event.preventDefault();
        });

        thumb.addEventListener("pointermove", (event) => {
            if (!drag) return;
            const layout = measure(container);
            const freeSpace = layout.trackHeight - layout.thumbHeight;
            if (freeSpace <= 0) return;
            const target = drag.startPosition + ((event.clientY - drag.startY) / freeSpace) * layout.total;
            scrollToPosition(container, layout, target);
        });

        thumb.addEventListener("pointerup", stopDrag);
        thumb.addEventListener("pointercancel", stopDrag);

        container.addEventListener("scroll", update, { capture: true, passive: true });
        window.addEventListener("resize", update);
        window.addEventListener("load", update);
        update();
    }
</script>
