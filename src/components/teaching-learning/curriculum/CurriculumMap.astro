---
import CurriculumCard from "./CurriculumCard.astro";

const categories = [
    {
        category: "General Education",
        units: 42,
        description: "Develop strong communication, critical thinking, ethical reasoning, cultural awareness, and social responsibility."
    },
    {
        category: "Common Courses",
        units: 18,
        description: "Provides fundamental concepts in computing, information technology, mathematics, and related disciplines for CS students."
    },
    {
        category: "Professional Courses",
        units: 78,
        description: "Develop the core knowledge, technical expertise, and practical competencies essential to computer science aligned with program outcomes."
    },
    {
        category: "Professional Electives",
        units: 12,
        description: "Provide opportunities for students to explore specialized and emerging areas of computer science based on their interests and career goals."
    },
    {
        category: "Math, PE & NSTP",
        units: 17,
        description: "Additional Math (3 units), Physical Education / PATHFIT (8 units), and National Service Training Program / NSTP (6 units)."
    }
];
---

<div class="mx-auto w-full mb-3">
    <!-- Total Units Banner -->
    <div class="my-4 flex flex-row items-center justify-between gap-4 rounded-2xl bg-(--color-maroon) px-8 py-3 text-white">
        <h3>
            CURRICULUM DISTRIBUTION
        </h3>
        <span class="rounded-lg bg-(--color-gold) px-4 py-2 text-center font-extrabold text-(--color-dark-maroon)">
            167 UNITS
        </span>
    </div>
    
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {categories.map((item) => (
            <CurriculumCard {...item} />
        ))}
    </div>
</div>

<style>
    h3 {
        color: white;
        font-size: large;
    }
</style>