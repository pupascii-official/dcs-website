---
const {
    label,
    image,
    imageAlt,
    title,
    imageFit = "cover",
} = Astro.props;
---

<article class="rounded-3xl h-full border border-(--color-gold) bg-white p-5 sm:p-6">

    <!-- LABEL -->
    <p class="text-xs font-extrabold uppercase text-(--color-maroon)">
        {label}
    </p>

    <!-- IMAGE -->
    <div class="mt-4 mb-4 aspect-2.25/1 w-full overflow-hidden rounded-xl border border-(--color-maroon)">
        <img
            src={image}
            alt={imageAlt}
            class="h-full w-full object-cover"
            class:list={[
                "h-full w-full",
                imageFit === "contain" ? "object-contain" : "object-cover"
            ]}
        />
    </div>

    <!-- TITLE -->
    <h3 class="text-lg font-bold sm:text-xl">
        {title}
    </h3>

    <!-- DESCRIPTION -->
    <div class="mt-3 text-sm leading-relaxed text-(--color-text-body) sm:text-base">
        <slot />
    </div>

</article>

<style>
    h3 {
        color: black;
    }
</style>