---
interface Props {
  number: string;
  date: string;
  title: string;
  description: string;
}

const { date, title, description, link } = Astro.props;
---

<article class="timeline-card w-full border border-red-200 border-t-2 bg-white p-5 text-center shadow-sm">
  <span class="inline-block rounded-full border border-red-200 bg-red-50 px-4 py-1 text-[10px] font-bold text-red-800">
    {date}
  </span>

  <h3 class="mt-3 text-base font-bold text-red-950">{title}</h3>

  <p class="mt-2 text-xs leading-relaxed text-slate-600">{description}</p>

  <a href={link} class="mt-3 text-[10px] font-bold text-red-800">
    Click to view details ↗
  </a>
</article>

<style>
  .timeline-card {
    border-color: #fecaca;
    transition: border-color 200ms ease;
  }

  :global(.timeline-item.is-active) .timeline-card {
    border-color: #d9a000;
  }
</style>
