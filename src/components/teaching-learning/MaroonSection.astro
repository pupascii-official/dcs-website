---
interface Props {
    eyebrow: string;
    title: string;
    description: string;
}

const { eyebrow, title,  description} = Astro.props;
---

<div class="content-section py-12 md:py-18 px-6 scroll-section">
    <div class="section-inner">
        <header class="section-header">
            <div class="header-top">
                <small>{eyebrow}</small>
            </div>                
            <h2 class="my-5 title">{title}</h2>
            <span class="description text-sm">
                {description}
            </span>
        </header>

        <div class="section-body">
            <slot/>
        </div>
    </div>
</div>

<style>
    .section-header {
        text-align: center;
    }

    .content-section {
        background-color: #4f0303;
        background-image: radial-gradient(
            ellipse 85% 75% at 50% 42%,
            #980d0d 0%,
            #580404 55%,
            #2b0202 100%
        );
    }

    .title {
        color: white;
    }

    .description {
        color: rgba(255, 255, 255, .8);
    }

    .section-inner {
        max-width: 1100px;
        margin: 0 auto;
    }

    .header-top {
        color: var(--color-gold);
        padding-left: 1rem;
        margin-block-end: 1rem;
    }

    .header-top small {
        color: var(--color-gold);
    }
</style>
