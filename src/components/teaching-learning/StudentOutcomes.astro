---
import "./tl-styles.css";
---

<section class="ascii-white-sec" id="tl-peo-so">
          <div class="ascii-container">

            <!-- All 10 Student Outcomes (Direct Grid, No Outer Box) -->
            <div class="so-bento-header">
              <div class="ascii-eyebrow">BSCS STUDENT OUTCOMES</div>
              <h3>Knowledge, Skills &amp; Competencies Upon Graduation</h3>
            </div>
            <div class="tl-so-bento">
              <div class="tl-so-card">
                <div class="ascii-eyebrow" style="margin-bottom:4px;">SO 01–03 • ANALYTICAL CORE</div>
                <h3>Core Computing &amp; Problem Solving</h3>
                <ul class="tl-so-list">
                  <li>
                    <span class="tl-so-label">Foundations</span>
                    <p>Apply computing fundamentals, specialization knowledge, and math/science to model defined
                      problems.</p>
                  </li>
                  <li>
                    <span class="tl-so-label">Complex Problem Solving</span>
                    <p>Analyze, research, and solve complex computing problems with substantiated conclusions.</p>
                  </li>
                  <li>
                    <span class="tl-so-label">Theory &amp; Algorithms</span>
                    <p>Apply mathematical foundations, algorithms, and CS theory to system design with clear trade-offs.
                    </p>
                  </li>
                </ul>
              </div>

              <div class="tl-so-card">
                <div class="ascii-eyebrow" style="margin-bottom:4px;">SO 04–06 • ENGINEERING &amp; IMPACT</div>
                <h3>Systems, Security &amp; Practice</h3>
                <ul class="tl-so-list">
                  <li>
                    <span class="tl-so-label">Information Security</span>
                    <p>Understand and apply information security principles in designing and using information systems.
                    </p>
                  </li>
                  <li>
                    <span class="tl-so-label">Modern Tools &amp; Practice</span>
                    <p>Select and apply modern computing techniques, resources, and tools while understanding
                      limitations.</p>
                  </li>
                  <li>
                    <span class="tl-so-label">Societal Impact</span>
                    <p>Design and evaluate computing solutions considering public health, safety, culture, society, and
                      environment.</p>
                  </li>
                </ul>
              </div>

              <div class="tl-so-card">
                <div class="ascii-eyebrow" style="margin-bottom:4px;">SO 07–10 • PROFESSIONALISM</div>
                <h3>Collaboration, Ethics &amp; Growth</h3>
                <ul class="tl-so-list">
                  <li>
                    <span class="tl-so-label">Teamwork &amp; Leadership</span>
                    <p>Function effectively as an individual, member, or leader in diverse and multidisciplinary teams.
                    </p>
                  </li>
                  <li>
                    <span class="tl-so-label">Communication</span>
                    <p>Communicate effectively via technical reports, design documentation, presentations, and clear
                      instruction.</p>
                  </li>
                  <li>
                    <span class="tl-so-label">Ethics &amp; Legal</span>
                    <p>Recognize legal, social, ethical, and professional issues and uphold ethical computing practices.
                    </p>
                  </li>
                  <li>
                    <span class="tl-so-label">Lifelong Learning</span>
                    <p>Engage in independent, lifelong learning for continual growth as a computing professional.</p>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </section>

<style>
  #tl-peo-so {
    padding-top: 1rem;
  }
</style>