---
import "./tl-styles.css";
---
<!-- 10. Retro Perspective Grid Section: Student Learning Experience & Research Colloquium -->
        <section class="ascii-retro-sec" id="tl-student-exp">
          <div class="ascii-retro-grid-bg" aria-hidden="true">
            <div class="ascii-retro-plane"></div>
          </div>

          <div class="ascii-retro-card">
            <div class="tl-retro-grid">
              <div class="tl-retro-cell">
                <div class="ascii-eyebrow">APPLIED LEARNING &amp; BSCS THESIS</div>
                <h3>Scientific Inquiry &amp; Emerging Computing</h3>
                <p>Unlike development-only projects, the BSCS Thesis emphasizes scientific inquiry, critical analysis,
                  computational methods, and evidence-based evaluation across AI, machine learning, data science, data
                  mining, cybersecurity, and software engineering.</p>
              </div>
              <div class="tl-retro-cell">
                <div class="ascii-eyebrow">RESEARCH COLLOQUIUM</div>
                <h3>Annual Computer Science Research Colloquium</h3>
                <p>Provides an academic venue for BSCS students to present and defend methodological approaches,
                  demonstrate computational solutions, and receive constructive critique from faculty evaluators and
                  peers.
                  Beyond the colloquium, students disseminate research through academic presentations, research forums,
                  and thesis defenses.</p>
              </div>
              <div class="tl-retro-cell">
                <div class="ascii-eyebrow">DOCUMENTARY EVIDENCE</div>
                <img class="tl-evidence-photo" src="public/teaching-learning-assets/evidence-page27-globe.jpg"
                  alt="BSCS students during industry exposure and learning session at Globe" loading="lazy">
                <h3>Industry Exposure at Globe</h3>
                <p>BSCS students during an industry learning session and technology immersion with Globe — connecting
                  classroom theory to real-world industry practices.</p>
              </div>
              <div class="tl-retro-cell">
                <div class="ascii-eyebrow">DOCUMENTARY EVIDENCE</div>
                <div class="tl-evidence-duo">
                  <img src="public/teaching-learning-assets/evidence-page29-cdrrmo-1.jpg"
                    alt="BSCS students presenting their thesis tool to Marikina City CDRRMO" loading="lazy">
                  <img src="public/teaching-learning-assets/evidence-page29-cdrrmo-2.jpg"
                    alt="BSCS student demonstrating the developed thesis application for Marikina City CDRRMO"
                    loading="lazy">
                </div>
                <h3>Marikina City CDRRMO Thesis Presentation</h3>
                <p>BSCS students presenting their developed Thesis Tool for Marikina City Disaster Risk Reduction and
                  Management Office — applying CS research to public service.</p>
              </div>
            </div>
          </div>
        </section>



<style>
  #tl-student-exp {
    padding-top: 1rem;
  }
</style>