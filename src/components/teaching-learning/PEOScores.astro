---
import "./tl-styles.css";
---

<!-- PEO Attainment Scores -->
        <section class="ascii-grad-band" id="tl-peo-attainment">
          <div class="ascii-container">
            <div class="ascii-grid-box">
              <div
                style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:22px;">
                <div>
                  <div class="ascii-eyebrow" style="margin-bottom:4px;">GRADUATE TRACER SURVEYS • 2017–2022 DATA SET
                  </div>
                  <h3 style="font-family:var(--font-display);font-size:1.3rem;font-weight:800;color:#111827;">Program
                    Educational Objectives Attainment</h3>
                </div>
              </div>

              <div class="tl-attainment-grid">
                <div class="tl-attainment-cell">
                  <div class="ascii-eyebrow" style="margin-bottom:6px;">PEO 01 • 2017–2022 SURVEY</div>
                  <h3>Field Expertise &amp; Specialization</h3>
                  <p>Attainment score for practicing computing expertise and succeeding in chosen specializations.
                    <em>(2017–2022 tracer score pending)</em>
                  </p>
                </div>
                <div class="tl-attainment-cell">
                  <div class="ascii-eyebrow" style="margin-bottom:6px;">PEO 02 • 2017–2022 SURVEY</div>
                  <h3>Ethical Technological Innovation</h3>
                  <p>Attainment score for contributing to technological advancements that solve real-world problems
                    ethically. <em>(2017–2022 tracer score pending)</em></p>
                </div>
                <div class="tl-attainment-cell">
                  <div class="ascii-eyebrow" style="margin-bottom:6px;">PEO 03 • 2017–2022 SURVEY</div>
                  <h3>Leadership &amp; Lifelong Growth</h3>
                  <p>Attainment score for supervisory roles, advanced degrees/certifications, and professional service.
                    <em>(2017–2022 tracer score pending)</em>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>