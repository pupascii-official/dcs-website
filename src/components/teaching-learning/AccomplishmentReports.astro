---
import "./tl-styles.css";
---

<!-- Accomplishment Reports -->
        <section class="ascii-tint-sec" id="tl-accomplishments">
          <div class="ascii-container"> 
            <div class="tl-bento">
              <div class="ascii-white-card tl-span-6">
                <div class="ascii-eyebrow">ACADEMIC &amp; FACULTY MILESTONES</div>
                <h3
                  style="font-family:var(--font-display);font-size:1.15rem;font-weight:700;color:#111827;margin-bottom:6px;">
                  Departmental Accomplishment Reports</h3>
                <p style="font-size:0.88rem;color:#4B5563;">Periodic summaries of curriculum delivery, syllabus updates,
                  faculty research output, and quality assurance deliverables.</p>
              </div>
              <div class="ascii-white-card tl-span-6">
                <div class="ascii-eyebrow">CO-CURRICULAR &amp; EXTENSION</div>
                <h3
                  style="font-family:var(--font-display);font-size:1.15rem;font-weight:700;color:#111827;margin-bottom:6px;">
                  Organization &amp; Community Reports</h3>
                <p style="font-size:0.88rem;color:#4B5563;">Event impact summaries, seminar series, community extension
                  activities, and annual student organization accomplishment filings.</p>
              </div>
            </div>
          </div>
        </section>