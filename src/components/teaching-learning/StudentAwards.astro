        <!-- Certificate Modal -->
<div class="roadmap-modal-backdrop"
  id="achieverModal"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="achieverModalName">

  <div class="roadmap-modal-dialog achiever-modal-dialog">
    <div class="roadmap-modal-header">
      <div class="roadmap-modal-badges">
        <span class="tl-award-pill" id="achieverModalPill"></span>
        <span class="tl-award-date" id="achieverModalDate"></span>
      </div>

      <button type="button"
        class="roadmap-modal-close"
        id="achieverModalClose"
        aria-label="Close certificates">
        ✕
      </button>
    </div>

    <div class="intl-modal-profile">
      <img class="intl-modal-photo"
        id="achieverModalPhoto"
        src=""
        alt="">

      <div class="intl-modal-meta">
        <h3 id="achieverModalName"></h3>
        <div class="intl-modal-univ" id="achieverModalSub"></div>
      </div>
    </div>

    <div class="roadmap-modal-body" id="achieverModalBody"></div>

    <div class="roadmap-modal-footer">
      <button type="button"
        class="roadmap-modal-nav"
        id="achieverModalPrev">
        ← Previous
      </button>

      <button type="button"
        class="roadmap-modal-nav"
        id="achieverModalNext">
        Next →
      </button>
    </div>
  </div>
</div>

<script>
  const modalCandidate = document.getElementById("achieverModal");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("#tl-student-awards .tl-achiever-card")
  );

  if (!modalCandidate || cards.length === 0) {
    console.error("Student awards modal or cards are missing.");
  } else {
    const modal: HTMLElement = modalCandidate;
    const pillCandidate = document.getElementById("achieverModalPill");
    const dateCandidate = document.getElementById("achieverModalDate");
    const photoCandidate = document.getElementById("achieverModalPhoto");
    const nameCandidate = document.getElementById("achieverModalName");
    const subCandidate = document.getElementById("achieverModalSub");
    const bodyCandidate = document.getElementById("achieverModalBody");
    const closeCandidate = document.getElementById("achieverModalClose");
    const prevCandidate = document.getElementById("achieverModalPrev");
    const nextCandidate = document.getElementById("achieverModalNext");

    if (
      !pillCandidate ||
      !dateCandidate ||
      !(photoCandidate instanceof HTMLImageElement) ||
      !nameCandidate ||
      !subCandidate ||
      !bodyCandidate ||
      !(closeCandidate instanceof HTMLButtonElement) ||
      !(prevCandidate instanceof HTMLButtonElement) ||
      !(nextCandidate instanceof HTMLButtonElement)
    ) {
      console.error("Student awards modal is missing required elements.");
    } else {
      const pillEl: HTMLElement = pillCandidate;
      const dateEl: HTMLElement = dateCandidate;
      const photoEl: HTMLImageElement = photoCandidate;
      const nameEl: HTMLElement = nameCandidate;
      const subEl: HTMLElement = subCandidate;
      const bodyEl: HTMLElement = bodyCandidate;
      const closeBtn: HTMLButtonElement = closeCandidate;
      const prevBtn: HTMLButtonElement = prevCandidate;
      const nextBtn: HTMLButtonElement = nextCandidate;

      let activeIndex = -1;
      let lastTrigger: HTMLElement | null = null;

      function renderAchiever(index: number) {
        const card = cards[index];
        if (!card) return;
        activeIndex = index;

        const image = card.querySelector<HTMLImageElement>(".tl-achiever-avatar");
        const name = card.querySelector<HTMLElement>(".tl-award-recipient")?.textContent?.trim() ?? "";
        const list = card.querySelector(".tl-faculty-list");
        const certs = card.querySelector(".tl-achiever-certs");
        const certCount = certs?.querySelectorAll(".tl-cert-figure").length ?? 0;
        const certGrid = document.createElement("div");
        certGrid.className = "achiever-cert-grid";

        certs?.querySelectorAll(".tl-cert-figure").forEach((figure) => {
          certGrid.append(figure.cloneNode(true));
        });

        pillEl.textContent = card.querySelector(".tl-award-pill")?.textContent?.trim() ?? "";
        dateEl.textContent = card.querySelector(".tl-award-date")?.textContent?.trim() ?? "";
        photoEl.src = image?.getAttribute("src") ?? "";
        photoEl.alt = image?.getAttribute("alt") ?? name;
        nameEl.textContent = name;
        subEl.textContent =
          certCount === 1 ? "1 Documented Certificate" : `${certCount} Documented Certificates`;
        bodyEl.replaceChildren(
          ...(list ? [list.cloneNode(true)] : []),
          certGrid
        );

        prevBtn.disabled = index <= 0;
        nextBtn.disabled = index >= cards.length - 1;
      }

      function openModal(index: number, trigger: HTMLElement) {
        lastTrigger = trigger;
        renderAchiever(index);
        modal.hidden = false;
        document.body.style.overflow = "hidden";
        closeBtn.focus();
      }

      function closeModal() {
        if (modal.hidden) return;
        modal.hidden = true;
        document.body.style.overflow = "";
        lastTrigger?.focus();
      }

      cards.forEach((card, index) => {
        card.addEventListener("click", () => openModal(index, card));
        card.addEventListener("keydown", (event: KeyboardEvent) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openModal(index, card);
          }
        });
      });

      closeBtn.addEventListener("click", closeModal);
      prevBtn.addEventListener("click", () => {
        if (activeIndex > 0) renderAchiever(activeIndex - 1);
      });
      nextBtn.addEventListener("click", () => {
        if (activeIndex < cards.length - 1) renderAchiever(activeIndex + 1);
      });

      modal.addEventListener("click", (event: MouseEvent) => {
        if (event.target === modal) closeModal();
      });

      document.addEventListener("keydown", (event: KeyboardEvent) => {
        if (modal.hidden) return;
        if (event.key === "Escape") {
          closeModal();
        } else if (event.key === "ArrowLeft" && activeIndex > 0) {
          renderAchiever(activeIndex - 1);
        } else if (event.key === "ArrowRight" && activeIndex < cards.length - 1) {
          renderAchiever(activeIndex + 1);
        }
      });
    }
  }
</script>

<!-- CSS FILE COMPONENT -->
<style>
    #tl-student-awards .tl-achiever-card,
    #tl-student-awards .tl-achiever-card.gold-accent {
    cursor: pointer;
    display: flex;
    flex-direction: column;
    padding: 22px 24px;
    border-radius: 20px;
    background: #FFFFFF;
    border: 1px solid rgba(128, 0, 0, 0.10);
    box-shadow: 0 4px 20px rgba(61, 0, 0, 0.045);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

    #tl-student-awards .tl-achiever-card:hover {
    transform: translateY(-4px);
    border-color: rgba(128, 0, 0, 0.28);
    box-shadow: 0 14px 32px rgba(61, 0, 0, 0.10);
    }

    #tl-student-awards .tl-achiever-card:focus-visible {
    outline: 2px solid var(--color-maroon);
    outline-offset: 2px;
    }

    #tl-student-awards .tl-award-top {
    padding: 0 0 14px;
    }

    #tl-student-awards .tl-achiever-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(128, 0, 0, 0.08);
    }

    #tl-student-awards .tl-achiever-avatar {
    width: 68px;
    height: 68px;
    border-radius: 16px;
    object-fit: cover;
    object-position: center top;
    flex-shrink: 0;
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 0 1px rgba(128, 0, 0, 0.14), 0 4px 12px rgba(61, 0, 0, 0.09);
    background: #FFFFFF;
    }

    #tl-student-awards .tl-achiever-header .tl-award-recipient {
    margin-bottom: 0;
    font-size: 1.08rem;
    line-height: 1.25;
    }

    #tl-student-awards .tl-achiever-card .tl-faculty-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 18px !important;
    padding-left: 16px;
    font-size: 0.84rem;
    line-height: 1.5;
    color: #374151;
    }

    #tl-student-awards .tl-achiever-card .tl-faculty-list li::marker {
    color: var(--color-maroon);
    }

    #tl-student-awards .tl-achiever-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 9px 14px;
    border-radius: 12px;
    background: rgba(128, 0, 0, 0.045);
    border: 1px solid rgba(128, 0, 0, 0.12);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-maroon);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    #tl-student-awards .tl-achiever-card:hover .tl-achiever-cta {
    background: var(--color-maroon);
    border-color: var(--color-maroon);
    color: #FFFFFF;
    }

    .achiever-modal-dialog {
    max-width: 780px;
    }

    .achiever-modal-dialog .roadmap-modal-body {
    max-height: 62vh;
    overflow-y: auto;
    padding-right: 4px;
    }

    .achiever-cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 14px;
    }

    .tl-cert-figure {
    margin: 0;
    padding: 10px;
    border-radius: 12px;
    background: #FAF8F5;
    border: 1px solid rgba(128, 0, 0, 0.14);
    display: flex;
    flex-direction: column;
    gap: 8px;
    }

    .tl-cert-figure img {
    width: 100%;
    max-height: 280px;
    object-fit: contain;
    border-radius: 8px;
    background: #FFFFFF;
    }

    .tl-cert-figure figcaption {
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
    line-height: 1.4;
    }
</style>

