---
interface Props {
    track: string;
    category: string;
    title: string;
    description: string;
    image: string;
    tags: string[];
}

const {
    track,
    category,
    title,
    description,
    image,
    tags,
} = Astro.props;
---

<article class="overflow-hidden rounded-2xl border border-transparent bg-white shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-xl">
    <!-- Image Header -->
    <div class="relative h-28 w-full border-b-[3px] border-(--color-gold) sm:h-32">
        <img
            src={image}
            alt={title}
            loading="lazy"
        />

        <!-- Track Number -->
        <span class="absolute left-3 top-3 rounded-full bg-(--color-gold) px-3 py-1 text-[10px] font-extrabold text-(--color-dark-maroon) shadow-sm">
            {track}
        </span>

        <!-- Category -->
        <span class="absolute right-3 top-3 max-w-[65%] truncate rounded-full bg-slate-900/60 px-3 py-1.5 text-[10px] font-semibold text-white backdrop-blur-sm">
            {category}
        </span>

    </div>

    <!-- Card Content -->
    <div class="p-5">

        <!-- Title and Icon -->
        <div class="flex items-center gap-3">

            <div class="flex size-9 shrink-0 items-center justify-center rounded-xl border border-(--color-maroon) bg-(--color-muted-maroon) text-(--color-dark-maroon)">
                <slot name="icon" />
            </div>

            <h3 class="text-lg font-extrabold leading-tight text-slate-900">
                {title}
            </h3>

        </div>

        <!-- Description -->
        <p class="mt-2 text-xs leading-relaxed text-slate-600">
            {description}
        </p>

        <!-- Tags -->
        <div class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
                <span class="rounded-full border border-(--color-maroon) bg-(--color-muted-maroon) px-2.5 py-1 text-[9px] font-bold text-(--color-dark-maroon)">
                    {tag}
                </span>
            ))}
        </div>

    </div>

</article>

<style>
    img {
        width: 100%;
        height: 8rem;
        max-width: none;
        object-fit: cover;
    }
</style>