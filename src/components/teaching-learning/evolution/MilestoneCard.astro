---
import type  { EvolutionMilestone }  from './evolutionMilestones';

interface Props {
  milestone: EvolutionMilestone;
  index: number;
}

const { milestone, index } = Astro.props;
---

<article
  class:list={[
    'roadmap-card-slot',
    milestone.stepClass,
    milestone.side === 'left' ? 'is-left' : 'is-right',
    milestone.isFinal && 'is-milestone-final',
  ]}
  data-milestone-index={index}
>
  {milestone.side === 'right' && (
    <div class="roadmap-step-num">{milestone.stepNumber}</div>
  )}

  <div
    class="ascii-soft-card roadmap-card"
    role="button"
    tabindex="0"
    aria-haspopup="dialog"
    aria-label={milestone.ariaLabel}
    data-milestone-trigger={index}
  >
    <div class="roadmap-card-meta">
      <span class="tl-timeline-year">{milestone.year}</span>
      <span class="roadmap-tech-code">{milestone.techCode}</span>
    </div>

    <div class="roadmap-card-head">
      <span class="roadmap-card-icon" aria-hidden="true">
        {milestone.icon === 'mainframe' && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m7 10 3 2.5L7 15" />
            <path d="M12 15h5" />
          </svg>
        )}
        {milestone.icon === 'ladderized' && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="6" width="12" height="12" rx="2" />
            <rect x="9" y="9" width="6" height="6" rx="1" />
            <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />
          </svg>
        )}
        {milestone.icon === 'ccmit' && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="2" width="6" height="5" rx="1" />
            <rect x="2" y="17" width="6" height="5" rx="1" />
            <rect x="16" y="17" width="6" height="5" rx="1" />
            <path d="M12 7v5M5 17v-3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3" />
          </svg>
        )}
        {milestone.icon === 'bscs' && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 4 5v6c0 5.25 3.4 10.15 8 11.5 4.6-1.35 8-6.25 8-11.5V5l-8-3z" />
            <path d="m9.5 12-2 2 2 2" />
            <path d="m14.5 12 2 2-2 2" />
            <path d="m13 11-2 6" />
          </svg>
        )}
      </span>
      <h3>{milestone.title}</h3>
    </div>

    <span class="roadmap-click-hint">Click to view details <span aria-hidden="true">↗</span></span>

    <div class="roadmap-card-details" hidden>
      <Fragment set:html={milestone.summaryHtml} />
      <div class="roadmap-highlights">
        {milestone.highlights.map((tag) => (
          <span class:list={['roadmap-tag', tag.gold && 'is-gold']}>{tag.label}</span>
        ))}
      </div>
    </div>
  </div>

  {milestone.side === 'left' && (
    <div class="roadmap-step-num">{milestone.stepNumber}</div>
  )}
</article>