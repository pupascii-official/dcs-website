---
import { EVOLUTION_MILESTONES } from './evolutionMilestones';
import RoadmapSvgTrack from './RoadmapSvgTrack.astro';
import MilestoneCard from './MilestoneCard.astro';
import MilestoneModal from './MilestoneModal.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  headingPrefix?: string;
  headingAccent?: string;
  lead?: string;
}

const {
  id = 'tl-evolution',
  eyebrow = 'PROGRAM TIMELINE',
  headingPrefix = 'Evolution of PUP’s',
  headingAccent = 'Computer Science Program',
  lead = 'Trace how computing education at PUP grew from early electronic data processing courses into an accredited Computer Science degree program.',
} = Astro.props;

const uid = `${id}-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  id={id}
  class="ascii-tint-sec evolution-section"
  data-evolution-roadmap={uid}
>
  <div class="ascii-container">
    <div class="tl-timeline roadmap-infographic">
      <RoadmapSvgTrack uid={uid} milestones={EVOLUTION_MILESTONES} />

      {EVOLUTION_MILESTONES.map((milestone, index) => (
        <MilestoneCard milestone={milestone} index={index} />
      ))}
    </div>

    <MilestoneModal uid={uid} />
  </div>
</div>

<script>
  (() => {
    const initializedRoots = new WeakSet<HTMLElement>();

    function setupEvolutionInstance(root: HTMLElement) {
      const roadmap = root.querySelector<HTMLElement>('.roadmap-infographic');
      const roadPath = root.querySelector<SVGPathElement>('path[id^="pup-road-path-"]');
      const shuttle = root.querySelector<SVGGElement>('[data-road-shuttle]');
      const anchors = Array.from(root.querySelectorAll<HTMLElement>('[data-road-anchor]'));
      const slots = Array.from(root.querySelectorAll<HTMLElement>('.roadmap-card-slot'));

      // Precompute normalized path lengths corresponding to the 4 curve bends (y ≈ 100, 300, 500, 700)
      const targetBendYs = [100, 300, 500, 700];
      let stopFractions = [0.16, 0.42, 0.67, 0.88];
      let totalLen = 0;

      if (roadPath && typeof roadPath.getTotalLength === 'function') {
        totalLen = roadPath.getTotalLength();
        if (totalLen > 0) {
          const samples = 240;
          const sampledPoints: { frac: number; y: number }[] = [];
          for (let i = 0; i <= samples; i++) {
            const frac = i / samples;
            const pt = roadPath.getPointAtLength(totalLen * frac);
            sampledPoints.push({ frac, y: pt.y });
          }

          stopFractions = targetBendYs.map((targetY, idx) => {
            let best = sampledPoints[0];
            let bestDiff = Math.abs(best.y - targetY);
            for (const p of sampledPoints) {
              const diff = Math.abs(p.y - targetY);
              if (diff < bestDiff) {
                best = p;
                bestDiff = diff;
              }
            }
            return best ? best.frac : 0.16 + idx * 0.24;
          });
        }
      }

      let rafPending = false;

      function updateShuttle() {
        rafPending = false;
        if (!roadmap || !roadPath || !shuttle || totalLen <= 0) return;

        const rect = roadmap.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;

        const vh = window.innerHeight || document.documentElement.clientHeight;
        const startAnchor = vh * 0.85;
        const endAnchor = vh * 0.28;
        const raw = (startAnchor - rect.top) / Math.max(1, rect.height + (startAnchor - endAnchor));
        const progress = Math.max(0, Math.min(1, raw));

        // Travel from early road entry (0.05) all the way through Milestone 04 (0.94)
        const travelFrac = 0.05 + progress * 0.89;
        const len = Math.max(0, Math.min(totalLen, totalLen * travelFrac));

        const pt = roadPath.getPointAtLength(len);
        const nextPt = roadPath.getPointAtLength(Math.min(totalLen, len + 2));
        const angle = (Math.atan2(nextPt.y - pt.y, nextPt.x - pt.x) * 180) / Math.PI;

        shuttle.setAttribute(
          'transform',
          `translate(${pt.x.toFixed(2)}, ${pt.y.toFixed(2)}) rotate(${angle.toFixed(2)})`
        );

        anchors.forEach((anchor, idx) => {
          const threshold = (stopFractions[idx] ?? 1) - 0.015;
          const reached = travelFrac >= threshold;
          anchor.classList.toggle('is-reached', reached);
          if (slots[idx]) {
            slots[idx].classList.toggle('is-reached', reached);
          }
        });
      }

      function requestSync() {
        if (!rafPending) {
          rafPending = true;
          window.requestAnimationFrame(updateShuttle);
        }
      }

      // Modal setup
      const modal = root.querySelector<HTMLElement>('[data-roadmap-modal]');
      const dialog = modal?.querySelector<HTMLElement>('[data-modal-dialog]') ?? null;
      const yearEl = modal?.querySelector<HTMLElement>('[data-modal-year]') ?? null;
      const codeEl = modal?.querySelector<HTMLElement>('[data-modal-code]') ?? null;
      const iconEl = modal?.querySelector<HTMLElement>('[data-modal-icon]') ?? null;
      const titleEl = modal?.querySelector<HTMLElement>('[data-modal-title]') ?? null;
      const bodyEl = modal?.querySelector<HTMLElement>('[data-modal-body]') ?? null;
      const closeBtn = modal?.querySelector<HTMLButtonElement>('[data-modal-close]') ?? null;
      const prevBtn = modal?.querySelector<HTMLButtonElement>('[data-modal-prev]') ?? null;
      const nextBtn = modal?.querySelector<HTMLButtonElement>('[data-modal-next]') ?? null;

      let activeIndex = -1;
      let lastTrigger: HTMLElement | null = null;
      let previousBodyOverflow = '';

      function renderMilestone(index: number) {
        const slot = slots[index];
        if (!slot || !modal || !dialog) return;
        activeIndex = index;

        const year = slot.querySelector('.tl-timeline-year')?.textContent?.trim() || '';
        const code = slot.querySelector('.roadmap-tech-code')?.textContent?.trim() || '';
        const icon = slot.querySelector('.roadmap-card-icon')?.innerHTML || '';
        const title = slot.querySelector('.roadmap-card-head h3')?.textContent?.trim() || '';
        const details = slot.querySelector('.roadmap-card-details')?.innerHTML || '';

        dialog.classList.toggle('is-milestone-final', slot.classList.contains('is-milestone-final'));
        if (yearEl) yearEl.textContent = year;
        if (codeEl) codeEl.textContent = code;
        if (iconEl) iconEl.innerHTML = icon;
        if (titleEl) titleEl.textContent = title;
        if (bodyEl) bodyEl.innerHTML = details;

        if (prevBtn) prevBtn.disabled = index <= 0;
        if (nextBtn) nextBtn.disabled = index >= slots.length - 1;
      }

      function openModal(index: number, triggerEl: HTMLElement | null) {
        if (!modal) return;
        lastTrigger = triggerEl;
        renderMilestone(index);
        previousBodyOverflow = document.body.style.overflow;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        closeBtn?.focus();
      }

      function closeModal() {
        if (!modal || modal.hidden) return;
        modal.hidden = true;
        document.body.style.overflow = previousBodyOverflow;
        if (lastTrigger && typeof lastTrigger.focus === 'function') {
          lastTrigger.focus();
        }
        lastTrigger = null;
      }

      if (!initializedRoots.has(root)) {
        initializedRoots.add(root);

        slots.forEach((slot, index) => {
          const card = slot.querySelector<HTMLElement>('.roadmap-card');
          if (!card) return;

          card.addEventListener('click', () => openModal(index, card));
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openModal(index, card);
            }
          });
        });

        closeBtn?.addEventListener('click', closeModal);
        prevBtn?.addEventListener('click', () => {
          if (activeIndex > 0) renderMilestone(activeIndex - 1);
        });
        nextBtn?.addEventListener('click', () => {
          if (activeIndex < slots.length - 1) renderMilestone(activeIndex + 1);
        });

        modal?.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        document.addEventListener('keydown', (e) => {
          if (!modal || modal.hidden) return;
          if (e.key === 'Escape') {
            closeModal();
          } else if (e.key === 'ArrowLeft' && activeIndex > 0) {
            renderMilestone(activeIndex - 1);
          } else if (e.key === 'ArrowRight' && activeIndex < slots.length - 1) {
            renderMilestone(activeIndex + 1);
          }
        });

        window.addEventListener('scroll', requestSync, { passive: true });
        document.addEventListener('scroll', requestSync, { passive: true, capture: true });
        window.addEventListener('resize', requestSync, { passive: true });
        window.addEventListener('roadmap-sync', requestSync);
      }

      updateShuttle();
    }

    function initAllEvolutionRoadmaps() {
      document
        .querySelectorAll<HTMLElement>('[data-evolution-roadmap]')
        .forEach(setupEvolutionInstance);
    }

    document.addEventListener('astro:page-load', initAllEvolutionRoadmaps);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAllEvolutionRoadmaps, { once: true });
    } else {
      initAllEvolutionRoadmaps();
    }
  })();
</script>

<style is:global>
  :root {
    --color-white: #FFFFFF;
    --color-maroon: #800000;
    --color-maroon-dark: #5C0000;
    --color-maroon-deep: #3D0000;
    --color-gold: #FFDE00;
    --color-dark-gold: #DAA520;

    --color-text: #1A1414;
    --color-text-muted: #5C5252;

    --font-display: 'Montserrat', sans-serif;
    --font-body: 'Inter', sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    --radius-lg: 24px;
  }

  .evolution-section,
  .evolution-section *,
  .evolution-section *::before,
  .evolution-section *::after {
    box-sizing: border-box;
  }

  .ascii-tint-sec {
    background: #FAF7F7;
    padding: 1rem;
  }

  .ascii-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ascii-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-maroon);
    margin-bottom: 10px;
  }

  .ascii-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.6vw, 2.85rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #111827;
    margin-bottom: 16px;
  }

  .ascii-h2 .accent {
    color: var(--color-maroon);
  }

  .ascii-lead {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.72;
    color: #4B5563;
  }

  .ascii-soft-card {
    border-radius: 20px;
    border: 1.5px solid rgba(128, 0, 0, 0.35);
    background: rgba(128, 0, 0, 0.04);
    padding: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .ascii-soft-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-maroon);
    box-shadow: 0 12px 28px rgba(128, 0, 0, 0.08);
  }

  .ascii-soft-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 8px;
  }

  .ascii-soft-card p,
  .ascii-soft-card li {
    font-size: 0.88rem;
    color: #4B5563;
    line-height: 1.6;
  }

  .evolution-section {
    position: relative;
    height: fit-content;
    overflow-x: clip;
    overflow-y: visible;
    z-index: 2;
  }

  .evolution-section > .ascii-container {
    position: relative;
    z-index: 1;
  }

  .evolution-section > .ascii-container > .ascii-eyebrow,
  .evolution-section > .ascii-container > .ascii-h2,
  .evolution-section > .ascii-container > .ascii-lead {
    position: relative;
    z-index: 2;
  }

  .tl-timeline.roadmap-infographic {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px minmax(0, 1fr);
    grid-template-rows: repeat(4, minmax(210px, auto));
    align-items: center;
    column-gap: 0;
    row-gap: 0;
    margin-top: 36px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
  }

  .is-step-1 {
    --step-color: var(--color-maroon);
    --step-shadow: rgba(128, 0, 0, 0.22);
  }

  .is-step-2 {
    --step-color: var(--color-maroon-dark);
    --step-shadow: rgba(92, 0, 0, 0.22);
  }

  .is-step-3 {
    --step-color: var(--color-maroon);
    --step-shadow: rgba(128, 0, 0, 0.22);
  }

  .is-step-4 {
    --step-color: var(--color-dark-gold);
    --step-shadow: rgba(218, 165, 32, 0.28);
  }

  .roadmap-infographic > .is-step-1 { grid-row: 1; }
  .roadmap-infographic > .is-step-2 { grid-row: 2; }
  .roadmap-infographic > .is-step-3 { grid-row: 3; }
  .roadmap-infographic > .is-step-4 { grid-row: 4; }

  .roadmap-infographic > .is-left { grid-column: 1; }
  .roadmap-infographic > .is-right { grid-column: 3; }

  .roadmap-road-layer {
    grid-column: 2;
    grid-row: 1 / -1;
    position: relative;
    width: 220px;
    height: 100%;
    overflow: visible;
    z-index: 1;
  }

  .roadmap-road-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .road-edge-outer {
    fill: none;
    stroke: rgba(128, 0, 0, 0.10);
    stroke-width: 54;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .road-asphalt {
    fill: none;
    stroke: #2B2D33;
    stroke-width: 44;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .road-stripes-edge {
    fill: none;
    stroke: rgba(255, 255, 255, 0.78);
    stroke-width: 35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .road-asphalt-inner {
    fill: none;
    stroke: #2B2D33;
    stroke-width: 31;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .road-center-dash {
    fill: none;
    stroke: rgba(255, 255, 255, 0.9);
    stroke-width: 2.2;
    stroke-dasharray: 12 10;
    stroke-linecap: round;
  }

  .road-node-anchor {
    position: absolute;
    transform: translateY(-50%);
    display: flex;
    flex-direction: row;
    align-items: center;
    z-index: 3;
  }

  .road-node-anchor.is-step-1 { top: 12.5%; }
  .road-node-anchor.is-step-2 { top: 37.5%; }
  .road-node-anchor.is-step-3 { top: 62.5%; }
  .road-node-anchor.is-step-4 { top: 87.5%; }

  .road-node-anchor.is-right-bend {
    right: 0;
    width: 25%;
    justify-content: flex-start;
  }

  .road-node-anchor.is-left-bend {
    left: 0;
    width: 25%;
    justify-content: flex-end;
  }

  .road-dotted-stem {
    flex: 1;
    height: 0;
    border-top: 2.5px dotted var(--step-color);
  }

  .road-donut {
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: #22252A;
    border: 6px solid var(--step-color);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
    flex-shrink: 0;
  }

  .road-node-anchor.is-reached .road-donut {
    background: var(--color-gold);
    transform: scale(1.18);
    box-shadow: 0 0 0 5px rgba(255, 222, 0, 0.35), 0 4px 12px rgba(0, 0, 0, 0.4);
  }

  .road-node-anchor.is-right-bend .road-donut {
    margin-left: -12px;
  }

  .road-node-anchor.is-left-bend .road-donut {
    margin-right: -12px;
  }

  .roadmap-card-slot {
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: center;
    min-width: 0;
    gap: 16px;
    padding: 22px 0;
    z-index: 2;
  }

  .roadmap-step-num {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--step-color);
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .roadmap-card {
    width: 100%;
    min-height: 176px;
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #FFFFFF;
    border-top: 3px solid var(--step-color);
    box-shadow: 0 10px 24px rgba(61, 0, 0, 0.06);
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .roadmap-card:focus-visible {
    outline: 3px solid var(--color-gold);
    outline-offset: 3px;
  }

  .roadmap-card-slot:hover .roadmap-card,
  .roadmap-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(61, 0, 0, 0.12);
  }

  .roadmap-card-meta {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .roadmap-card-meta .tl-timeline-year {
    margin-bottom: 0;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 6px 16px;
  }

  .roadmap-card .roadmap-tech-code {
    display: none;
  }

  .roadmap-card-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .roadmap-card-head h3 {
    margin: 0;
    font-size: 1.42rem;
    font-weight: 800;
    color: var(--color-maroon-dark);
    line-height: 1.25;
  }

  .is-milestone-final .roadmap-card-head h3 {
    color: #6B4200;
  }

  .roadmap-card-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #FBF0F0;
    border: 1px solid #E8C5C5;
    color: var(--step-color);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .is-milestone-final .roadmap-card-icon {
    background: #FEF8E6;
    border-color: #EBD28A;
    color: #7A4B00;
  }

  .roadmap-click-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--step-color);
    opacity: 0.78;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .roadmap-card-slot:hover .roadmap-click-hint,
  .roadmap-card:focus-visible .roadmap-click-hint {
    opacity: 1;
    transform: translateX(2px);
  }

  .roadmap-tech-code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    opacity: 0.78;
  }

  .roadmap-card p {
    color: #374151;
    font-size: 0.88rem;
    line-height: 1.62;
    margin-bottom: 14px;
  }

  .roadmap-card p strong {
    color: var(--step-color);
    font-weight: 700;
  }

  .roadmap-highlights {
    margin-top: auto;
    padding-top: 12px;
    width: 100%;
    border-top: 1px dashed rgba(128, 0, 0, 0.16);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .roadmap-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    border-radius: 6px;
    background: #FBF0F0;
    border: 1px solid #E8C5C5;
    color: var(--color-maroon);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .tl-timeline-year {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 9999px;
    background: #FBF0F0;
    border: 1px solid #E8C5C5;
    color: var(--color-maroon);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .is-step-1 .tl-timeline-year,
  .is-step-1 .roadmap-tag,
  .is-step-2 .tl-timeline-year,
  .is-step-2 .roadmap-tag,
  .is-step-3 .tl-timeline-year,
  .is-step-3 .roadmap-tag {
    background: #FBF0F0;
    border: 1px solid #E8C5C5;
    color: var(--color-maroon);
  }

  .is-step-4 .tl-timeline-year,
  .is-step-4 .roadmap-tag,
  .roadmap-tag.is-gold {
    background: #FEF8E6;
    border: 1px solid #EBD28A;
    color: #7A4B00;
  }

  .is-milestone-final .roadmap-card {
    border-top-color: var(--color-dark-gold);
  }

  /* Modal */
  .roadmap-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(24, 8, 8, 0.56);
    backdrop-filter: blur(4px);
  }

  .roadmap-modal-backdrop[hidden] {
    display: none;
  }

  .roadmap-modal-dialog {
    width: 100%;
    max-width: 560px;
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1.5px solid rgba(128, 0, 0, 0.16);
    border-top: 4px solid var(--color-maroon);
    box-shadow: 0 24px 56px rgba(24, 0, 0, 0.28);
    padding: 24px 26px;
    animation: roadmapModalIn 0.18s ease-out;
  }

  .roadmap-modal-dialog.is-milestone-final {
    border-top-color: var(--color-dark-gold);
  }

  .roadmap-modal-dialog.is-milestone-final .tl-timeline-year,
  .roadmap-modal-dialog.is-milestone-final .roadmap-card-icon {
    background: #FEF8E6;
    border-color: #EBD28A;
    color: #7A4B00;
  }

  @keyframes roadmapModalIn {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .roadmap-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .roadmap-modal-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
