---
interface Props {
    name: string;
    image: string;
    imageAlt: string;
    status: string;
    degrees: string[];
    specialization: string;
    courses: string;
}

const {
    name,
    image,
    imageAlt,
    status,
    degrees,
    specialization,
    courses,
} = Astro.props;
---

<article class="group flex h-full flex-col overflow-hidden rounded-2xl border shadow-lg border-(--color-maroon)/25 bg-white duration-200 hover:-translate-y-1 hover:shadow-lg">
    <!-- Top gradient banner with portrait & status badge -->
    <div
        class="relative overflow-hidden flex justify-center border-b-2 border-(--color-gold) px-6 pt-6 pb-4"
        style="background: linear-gradient(180deg, #5c0000 0%, #8a0000 48%, #c99a00 100%);"
    >
        <img
            src={image}
            alt={imageAlt}
            class="h-52! w-44 rounded-xl border border-(--color-gold) object-cover! object-top transition-transform duration-300 ease-in-out group-hover:scale-110"
        />

        {status && (
            <span class="absolute right-3 bottom-3 rounded-full border border-(--color-gold)/70 bg-black/35 px-3 py-1 text-[10px] font-bold tracking-wider text-(--color-gold) uppercase">
                {status}
            </span>
        )}
    </div>

    <!-- Faculty details -->
    <div class="flex flex-1 flex-col p-5">
        <h4 class="text-base font-bold! text-slate-900!">
            {name}
        </h4>

        <ul class="mt-2 space-y-1 pl-4 text-xs leading-relaxed text-slate-600">
            {degrees.map((degree) => (
                <li>{degree}</li>
            ))}
        </ul>

        <div class="mt-3 space-y-1.5 text-xs leading-relaxed text-slate-600">
            <p>
                <span class="font-bold text-(--color-maroon)">Specialization:</span>{" "}
                {specialization}
            </p>
            <p>
                <span class="font-bold text-(--color-maroon)">Courses:</span>{" "}
                {courses}
            </p>
        </div>
    </div>
</article>