---
import "./tl-styles.css";
---
<!-- HTML file component -->
<div class="org-carousel-controls" aria-label="Student organizations carousel controls" style="padding-bottom: 0.7rem;">
    <button type="button" class="org-carousel-btn" id="orgCarouselPrev" aria-label="Previous organization">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
    </button>

    <button type="button" class="org-carousel-btn" id="orgCarouselNext" aria-label="Next organization">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
    </button>
</div>

<div class="org-carousel" id="orgCarousel" role="region" aria-roledescription="carousel"
              aria-label="Recognized Computer Science Student Organizations">
              <div class="org-carousel-viewport">
                <div class="org-carousel-track" id="orgCarouselTrack">
                  <!-- Slide 1: PUP ASCII -->
                  <article class="ascii-soft-card org-media-card org-carousel-slide">
                    <div class="org-media-wrap">
                      <img src="public/teaching-learning-assets/org-pup-ascii.png" alt="PUP ASCII Kickoff and Oath Taking Event"
                        loading="lazy" />
                    </div>
                    <div class="org-media-body">
                      <div class="org-identity-row">
                        <div class="org-logo-frame">
                          <img src="public/teaching-learning-assets/org-logo-ascii.png" alt="PUP ASCII Official Logo" loading="lazy" />
                        </div>
                        <div class="org-name-block">
                          <span class="org-abbr">PUP ASCII</span>
                          <h3 class="org-full-name">PUP Association of Students for Computer Intelligence Integration
                          </h3>
                        </div>
                      </div>
                      <p>Flagship Computer Science student organization driving hackathons, research, peer mentorship,
                        and student-led technical initiatives.</p>
                    </div>
                  </article>

                  <!-- Slide 2: AWS Student Builder Group PUP -->
                  <article class="ascii-soft-card org-media-card org-carousel-slide">
                    <div class="org-media-wrap">
                      <img src="public/teaching-learning-assets/org-ref-awscc.jpg?v=2" alt="AWS Student Builder Group PUP event"
                        loading="lazy" />
                    </div>
                    <div class="org-media-body">
                      <div class="org-identity-row">
                        <div class="org-logo-frame">
                          <img src="public/teaching-learning-assets/org-logo-awssbg.png" alt="AWS Student Builder Group PUP Official Logo"
                            loading="lazy" />
                        </div>
                        <div class="org-name-block">
                          <span class="org-abbr">AWS SBG PUP</span>
                          <h3 class="org-full-name">AWS Student Builder Group PUP</h3>
                        </div>
                      </div>
                      <p>Student-led cloud engineering community conducting hands-on AWS workshops, architecture labs,
                        and cloud certification study jams.</p>
                    </div>
                  </article>

                  <!-- Slide 3: Cisco NetConnect PUP - Manila -->
                  <article class="ascii-soft-card org-media-card org-carousel-slide">
                    <div class="org-media-wrap">
                      <img src="public/teaching-learning-assets/org-ref-cncp.jpg" alt="Cisco NetConnect PUP - Manila assembly"
                        loading="lazy" />
                    </div>
                    <div class="org-media-body">
                      <div class="org-identity-row">
                        <div class="org-logo-frame">
                          <img src="public/teaching-learning-assets/org-logo-cncp.png" alt="Cisco NetConnect PUP - Manila Official Logo"
                            loading="lazy" />
                        </div>
                        <div class="org-name-block">
                          <span class="org-abbr">CNCP</span>
                          <h3 class="org-full-name">Cisco NetConnect PUP - Manila</h3>
                        </div>
                      </div>
                      <p>Campus networking and infrastructure community advancing routing, switching, network security,
                        and Cisco certification readiness.</p>
                    </div>
                  </article>

                  <!-- Slide 4: GDGoC PUP -->
                  <article class="ascii-soft-card org-media-card org-carousel-slide">
                    <div class="org-media-wrap">
                      <img src="public/teaching-learning-assets/org-dev-cloud.jpg?v=2" alt="Google Developer Groups on Campus PUP"
                        loading="lazy" />
                    </div>
                    <div class="org-media-body">
                      <div class="org-identity-row">
                        <div class="org-logo-frame">
                          <img src="public/teaching-learning-assets/org-logo-gdg.png"
                            alt="Google Developer Groups on Campus PUP Official Logo" loading="lazy" />
                        </div>
                        <div class="org-name-block">
                          <span class="org-abbr">GDG PUP</span>
                          <h3 class="org-full-name">Google Developer Groups on Campus PUP</h3>
                        </div>
                      </div>
                      <p>Campus developer chapter empowering students in AI/ML, web technologies, Android development,
                        and open-source solution challenges.</p>
                    </div>
                  </article>

                  <!-- Slide 5: PUP Language Technologies Society -->
                  <article class="ascii-soft-card org-media-card org-carousel-slide">
                    <div class="org-media-wrap">
                      <img src="public/teaching-learning-assets/org-pup-lts.jpg" alt="PUP Language Technologies Society" loading="lazy" />
                    </div>
                    <div class="org-media-body">
                      <div class="org-identity-row">
                        <div class="org-logo-frame" aria-hidden="true">
                            <img src="public/teaching-learning-assets/org-logo-lts.jpg"
                            alt="PUP Language Technologies Society Official Logo" loading="lazy" />
                        </div>
                        <div class="org-name-block">
                          <span class="org-abbr">PUP LTS</span>
                          <h3 class="org-full-name">PUP Language Technologies Society</h3>
                        </div>
                      </div>
                      <p>A student-led research organization dedicated to Natural Language Processing and language
                        technologies.</p>
                    </div>
                  </article>
                </div>
              </div>

              <div class="org-carousel-footer">
                <div class="org-carousel-dots" id="orgCarouselDots" role="tablist"
                  aria-label="Student organization slides"></div>
                <div class="org-carousel-counter" id="orgCarouselCounter" aria-live="polite">Showing 1–3 of 5</div>
              </div>
            </div>

<!-- CSS FILE COMPONENT -->

<!-- JS FILE COMPONENT -->
<script>
    
// Student Organizations Carousel (#tl-student-orgs)
(function initStudentOrgCarousel() {
  const carousel = document.getElementById('orgCarousel');
  const track = document.getElementById('orgCarouselTrack');
  const prevBtn = document.getElementById('orgCarouselPrev');
  const nextBtn = document.getElementById('orgCarouselNext');
  const dotsWrap = document.getElementById('orgCarouselDots');
  const counterEl = document.getElementById('orgCarouselCounter');
  if (!carousel || !track) return;

  const viewport = carousel.querySelector('.org-carousel-viewport');
  const slides = Array.from(track.querySelectorAll('.org-carousel-slide'));
  if (!viewport || slides.length === 0) return;

  let current = 0;
  let lastMaxIndex = -1;

  function getVisibleCount() {
    if (window.innerWidth <= 640) return 1;
    if (window.innerWidth <= 1024) return 2;
    return 3;
  }

  function renderDots(maxIndex) {
    if (!dotsWrap || maxIndex === lastMaxIndex) return;
    lastMaxIndex = maxIndex;
    const count = maxIndex + 1;
    dotsWrap.innerHTML = Array.from({ length: count }, (_, idx) => {
      const active = idx === current;
      return `<button type="button" class="org-carousel-dot${active ? ' is-active' : ''}" role="tab" aria-label="View organization group ${idx + 1}" aria-selected="${active}"></button>`;
    }).join('');

    dotsWrap.querySelectorAll('.org-carousel-dot').forEach((dot, idx) => {
      dot.addEventListener('click', () => goTo(idx));
    });
  }

  function updateCarousel() {
    const visible = getVisibleCount();
    const maxIndex = Math.max(0, slides.length - visible);
    current = Math.max(0, Math.min(current, maxIndex));

    renderDots(maxIndex);

    const gap = parseFloat(window.getComputedStyle(track).gap) || 24;
    const slideWidth = slides[0].getBoundingClientRect().width;
    if (slideWidth > 0) {
      const offset = current * (slideWidth + gap);
      track.style.transform = `translateX(-${offset}px)`;
    } else {
      track.style.transform = `translateX(-${(current * 100) / visible}%)`;
    }

    if (dotsWrap) {
      dotsWrap.querySelectorAll('.org-carousel-dot').forEach((dot, idx) => {
        const active = idx === current;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', String(active));
      });
    }

    if (counterEl) {
      const start = current + 1;
      const end = Math.min(slides.length, current + visible);
      counterEl.textContent = visible === 1 ? `${start} / ${slides.length}` : `Showing ${start}–${end} of ${slides.length}`;
    }
  }

  function goTo(index) {
    const maxIndex = Math.max(0, slides.length - getVisibleCount());
    if (maxIndex === 0) {
      current = 0;
    } else if (index < 0) {
      current = maxIndex;
    } else if (index > maxIndex) {
      current = 0;
    } else {
      current = index;
    }
    updateCarousel();
  }

  prevBtn?.addEventListener('click', () => goTo(current - 1));
  nextBtn?.addEventListener('click', () => goTo(current + 1));

  carousel.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      goTo(current - 1);
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      goTo(current + 1);
    }
  });

  if (typeof ResizeObserver === 'function') {
    const ro = new ResizeObserver(() => updateCarousel());
    ro.observe(viewport);
  } else {
    window.addEventListener('resize', updateCarousel, { passive: true });
  }

  updateCarousel();
})();
</script>