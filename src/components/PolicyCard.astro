---
import StatusBadge, { type BadgeVariant } from "./StatusBadge.astro";

export interface Props {
  badgeLabel: string;
  badgeVariant?: BadgeVariant;
  codeTag?: string;
  showDot?: boolean;
  title: string;
  description: string;
  class?: string;
}

const {
  badgeLabel,
  badgeVariant = "academic-rigor",
  codeTag,
  showDot = false,
  title,
  description,
  class: className = "",
} = Astro.props;
---

<article
  class={`rounded-2xl border border-[#800000]/22 bg-gradient-to-b from-white via-[#FDFCFC] to-[#FAF4F3] p-5 sm:p-6 shadow-[0_12px_28px_-14px_rgba(128,0,0,0.14)] flex flex-col justify-between transition-transform duration-200 hover:-translate-y-0.5 ${className}`}
>
  <div class="flex items-center justify-between gap-3 mb-4">
    <StatusBadge label={badgeLabel} variant={badgeVariant} />

    {
      codeTag ? (
        <span class="font-mono text-[11px] font-bold tracking-wider text-[#800000]">
          {codeTag}
        </span>
      ) : (
        showDot && (
          <span
            aria-hidden="true"
            class="h-2.5 w-2.5 rounded-full bg-[#DAA520] shadow-[0_0_8px_2px_rgba(218,165,32,0.45)] shrink-0"
          />
        )
      )
    }
  </div>

  <div>
    <h3 class="font-['Montserrat',sans-serif] text-[14px] font-extrabold text-neutral-900 leading-snug">
      {title}
    </h3>
    <p class="mt-2 text-[12px] leading-[1.55] text-neutral-500">
      {description}
    </p>
  </div>
</article>
