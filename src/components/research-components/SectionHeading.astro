---
export interface Props {
  eyebrow: string;
  heading: string;
  id?: string;
  class?: string;
}

const { eyebrow, heading, id, class: className = "" } = Astro.props;
---

<header
  class={`flex flex-wrap items-center justify-between gap-4 mb-8 sm:mb-10 ${className}`}
>
  <div class="flex items-stretch gap-3.5 sm:gap-4">
    <span
      aria-hidden="true"
      class="w-[3.5px] shrink-0 rounded-full bg-[#780000]"
    ></span>
    <div class="flex flex-col justify-center">
      <p
        class="font-['Montserrat',sans-serif] text-[10.5px] sm:text-[11px] font-bold tracking-[0.14em] uppercase text-[#C89416] leading-tight"
      >
        {eyebrow}
      </p>
      <h2
        id={id}
        class="mt-1 font-['Montserrat',sans-serif] text-[26px] sm:text-[32px] font-black tracking-[-0.02em] leading-[1.1] text-[#141414]"
      >
        {heading}
      </h2>
    </div>
  </div>

  {
    Astro.slots.has("action") && (
      <div class="shrink-0">
        <slot name="action" />
      </div>
    )
  }
</header>
