      ],
    },
    {
      id: "mb-dela-fuente",
      name: "Michael B. Dela Fuente",
      researchArea: "DEEP LEARNING",
      status: "INVOLVED IN RESEARCH",
      ctaLabel: "3 refereed publications",
      folderSlug: "dela-fuente-research.folder",
      imageSrc: "/research-asset/delafuente.png",
      publications: [
        {
          authors: "Dela Fuente, Michael B.",
          title: "Job Tier Classification in Applicant Tracking Systems Utilizing One-Dimensional CNN",
