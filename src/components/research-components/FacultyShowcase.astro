---
import { X } from "lucide-react";

export interface PublicationEntry {
  authors: string;
  title: string;
  journal: string;
  datePublished: string;
}

export interface FacultyMember {
  id: string;
  name: string;
  researchArea: string;
  status?: string;
  modalStatus?: string;
  ctaLabel?: string;
  folderSlug: string;
  imageSrc?: string;
  publications?: PublicationEntry[];
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  showHeading?: boolean;
  guidanceLabel?: string;
  faculty?: FacultyMember[];
  modalId?: string;
  class?: string;
}

const {
