          datePublished: "September 23, 2023",
        },
      ],
    },
  ],
  class: className = "",
} = Astro.props;

const defaultFaculty = faculty[0];
const guidancePillClass =
  "inline-flex items-center rounded-full border border-[#D9A41D]/45 badge-faculty-guidance px-4 py-1.5 font-['Montserrat',sans-serif] text-[10px] font-extrabold tracking-[0.07em] uppercase leading-none whitespace-nowrap text-[#800000]";
---

<section class={`w-full ${className}`}>
  {
    showHeading ? (
      <HeadlineComponent
        variant="section"
        kicker={eyebrow}
        headline={heading}
        class="mb-5 sm:mb-6"
      >
        {guidanceLabel && (
          <span slot="action" class={guidancePillClass}>
            {guidanceLabel}
          </span>
        )}
      </HeadlineComponent>
    ) : (
      Boolean(guidanceLabel) && (
        <div class="mb-6 flex justify-end">
          <span class={guidancePillClass}>{guidanceLabel}</span>
        </div>
      )
    )
  }

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
    {
      faculty.map((member) => {
        const initials = member.name
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((part) => part[0]?.toUpperCase() ?? "")
          .join("");
        const gradientId = `folder-pocket-grad-${member.id}`;
        const status = member.status ?? "INVOLVED IN RESEARCH";
        const ctaLabel = member.ctaLabel ?? "Refereed publications";
        const publications = member.publications ?? [];

        return (
          <div class="flex flex-col items-center">
            <button
              type="button"
              data-faculty-open={modalId}
              data-faculty-id={member.id}
              data-faculty-name={member.name}
              data-faculty-area={member.researchArea}
              data-faculty-status={status}
              data-faculty-folder={member.folderSlug}
              data-faculty-image={member.imageSrc ?? ""}
              data-faculty-publications={JSON.stringify(publications)}
              class="group relative w-full text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#780000]"
            >
              <!-- Outer Dark Maroon Frame -->
              <div
                class="rounded-[24px] bg-[#5B0000] p-[8px] shadow-[0_18px_36px_-12px_rgba(70,0,0,0.42)] transition-all duration-300 ease-out group-hover:-translate-y-1.5 group-hover:shadow-[0_26px_46px_-12px_rgba(70,0,0,0.52)]"
              >
                <!-- Inner Full-Bleed Image Sheet + Curved Maroon Pocket -->
                <div class="relative overflow-hidden rounded-[17px] bg-[#3B0000]">
                  <div
                    class="relative overflow-hidden rounded-t-[17px] border-[1.5px] border-b-0 border-white/95 bg-[#EFEAEA] transition-transform duration-300 ease-out group-hover:-translate-y-1.5"
                  >
                    <div class="absolute top-2.5 left-2.5 z-10">
                      <span
                        class="inline-flex items-center rounded-full bg-[#FFE600] px-2.5 py-1 font-['Montserrat',sans-serif] text-[7.5px] font-extrabold tracking-[0.04em] uppercase text-[#4A0000] shadow-sm"
                      >
                        {status}
                      </span>
                    </div>

                    <div class="relative aspect-[10/9] w-full overflow-hidden bg-[#EFEAEA]">
                      {
                        member.imageSrc ? (
                          <img
                            src={member.imageSrc}
                            alt={`Portrait of ${member.name}`}
                            loading="lazy"
                            referrerpolicy="no-referrer"
                            class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
                          />
                        ) : (
                          <div class="flex h-full w-full flex-col items-center justify-center bg-[radial-gradient(circle_at_50%_40%,rgba(128,0,0,0.12),rgba(243,234,234,0.95)_75%)] pt-4 text-center">
                            <span class="font-['Montserrat',sans-serif] text-[28px] font-black tracking-tight text-[#780000]">
                              {initials}
                            </span>
                            <span class="mt-0.5 font-['Montserrat',sans-serif] text-[8px] font-bold tracking-[0.14em] uppercase text-[#800000]/70">
                              PUP-CCIS FACULTY
                            </span>
                          </div>
                        )
                      }
                    </div>
                  </div>

                  <!-- Curved Gold-Rimmed Maroon Front Folder Pocket -->
                  <div class="relative z-10 -mt-7">
                    <svg
                      viewBox="0 0 300 32"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                      class="block h-6 w-full"
                    >
                      <defs>
                        <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#8A0000" />
                          <stop offset="100%" stop-color="#7A0000" />
                        </linearGradient>
                      </defs>
                      <path
                        d="M 0 32 L 0 25 C 2 14, 18 13, 45 12 C 115 10, 210 6, 300 1 L 300 32 Z"
                        fill={`url(#${gradientId})`}
                      />
                      <path
                        d="M 0.75 25 C 2.75 14, 18 13, 45 12 C 115 10, 210 6, 299.25 1"
                        fill="none"
                        stroke="#C89416"
                        stroke-width="1.5"
                        vector-effect="non-scaling-stroke"
                      />
                    </svg>

                    <div
                      class="-mt-px rounded-b-[17px] border-x border-b border-[#C89416]/75 bg-gradient-to-b from-[#7A0000] via-[#680000] to-[#560000] px-3 pt-1 pb-4 text-center"
                    >
                      <h3
                        class="font-['Montserrat',sans-serif] text-[13.5px] font-extrabold text-white leading-tight truncate"
                      >
                        {member.name}
                      </h3>
                      <p
                        class="mt-1 font-['Montserrat',sans-serif] text-[9.5px] font-bold italic tracking-[0.04em] uppercase text-[#FFE600] truncate"
                      >
                        {member.researchArea}
                      </p>

                      <div class="mt-3 flex justify-center">
                        <span
                          class="inline-flex items-center justify-center rounded-full border border-white/35 bg-white/12 px-3.5 py-1 text-[9.5px] font-semibold text-white group-hover:bg-white/22 transition-colors whitespace-nowrap"
                        >
                          {ctaLabel}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </button>
          </div>
        );
      })
    }
  </div>

  <!-- Faculty Profile Modal -->
  <dialog
    id={modalId}
    aria-labelledby={`${modalId}-name`}
    class="m-auto w-[min(94vw,680px)] rounded-2xl border-[1.5px] border-[#780000] bg-white p-0 shadow-[0_28px_60px_-15px_rgba(60,0,0,0.4)] backdrop:bg-black/55 backdrop:backdrop-blur-[2px] overflow-hidden"
  >
    <div class="flex items-center justify-between bg-[#780000] px-5 py-3 text-white">
      <span class="font-['Montserrat',sans-serif] text-[11px] font-extrabold tracking-[0.12em] uppercase">
        FACULTY PROFILE
      </span>
      <button
        type="button"
        data-modal-close
        aria-label="Close faculty profile"
        class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white/85 hover:bg-white/15 hover:text-white transition-colors cursor-pointer"
      >
        <X className="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <div class="p-6 space-y-5 max-h-[82vh] overflow-y-auto">
      <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-5 items-center">
        <div
          class="aspect-[4/4.6] w-full max-w-[155px] mx-auto overflow-hidden rounded-xl border border-neutral-200 bg-[#360000] shadow-sm flex items-center justify-center"
        >
          <img
            data-modal-image
            src={defaultFaculty?.imageSrc ?? ""}
            alt={`Portrait of ${defaultFaculty?.name ?? ""}`}
            referrerpolicy="no-referrer"
            class="h-full w-full object-cover object-top"
          />
          <span
            data-modal-initials
            class="hidden font-['Montserrat',sans-serif] text-[28px] font-black text-[#FFE600]"
          ></span>
        </div>

        <div class="space-y-3">
          <h3
            id={`${modalId}-name`}
            data-modal-name
            class="font-['Montserrat',sans-serif] text-[22px] font-black tracking-tight text-neutral-950 leading-tight"
          >
            {defaultFaculty?.name ?? ""}
          </h3>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <dt class="font-['Montserrat',sans-serif] text-[9.5px] font-extrabold tracking-[0.1em] uppercase text-[#780000]">
                RESEARCH AREA
              </dt>
              <dd data-modal-area class="mt-0.5 text-[12.5px] font-medium text-neutral-700">
                {defaultFaculty?.researchArea ?? ""}
              </dd>
            </div>

            <div>
              <dt class="font-['Montserrat',sans-serif] text-[9.5px] font-extrabold tracking-[0.1em] uppercase text-[#780000]">
                RESEARCH STATUS
              </dt>
              <dd data-modal-status class="mt-0.5 text-[12.5px] font-medium text-neutral-700">
                Involved in Research
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="border-t border-neutral-200 pt-4">
        <div class="flex items-center justify-between gap-3 mb-3">
          <h4 class="font-['Montserrat',sans-serif] text-[10.5px] font-extrabold tracking-[0.1em] uppercase text-[#780000]">
            REFEREED PUBLICATIONS
          </h4>
          <span
            data-modal-pub-count
            class="rounded-full bg-[#F3E8E8] px-2.5 py-0.5 font-['Montserrat',sans-serif] text-[10px] font-bold text-[#780000]"
          >
            0 publications
          </span>
        </div>

        <div data-modal-publications class="space-y-3"></div>
      </div>
    </div>
  </dialog>
</section>

<style>
  .badge-faculty-guidance {
    background-image: linear-gradient(90deg, #fdf3ca 0%, #fae89e 100%);
  }
</style>

<script is:inline define:vars={{ modalId }}>
  (() => {
    const dialog = document.getElementById(modalId);
    if (!dialog) return;

    const imgEl = dialog.querySelector("[data-modal-image]");
    const initialsEl = dialog.querySelector("[data-modal-initials]");
    const nameEl = dialog.querySelector("[data-modal-name]");
    const areaEl = dialog.querySelector("[data-modal-area]");
    const statusEl = dialog.querySelector("[data-modal-status]");
    const pubListEl = dialog.querySelector("[data-modal-publications]");
    const pubCountEl = dialog.querySelector("[data-modal-pub-count]");

    const makeRow = (label, value) => {
      const p = document.createElement("p");
      p.className = "text-[11.5px] leading-[1.45] text-neutral-600";
      const strong = document.createElement("span");
      strong.className = "font-semibold text-neutral-900";
      strong.textContent = `${label}: `;
      p.appendChild(strong);
      p.appendChild(document.createTextNode(value));
      return p;
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest(`[data-faculty-open="${modalId}"]`);
      if (trigger) {
        const name = trigger.getAttribute("data-faculty-name") || "";
        const area = trigger.getAttribute("data-faculty-area") || "";
        const status = trigger.getAttribute("data-faculty-status") || "Involved in Research";
        const image = trigger.getAttribute("data-faculty-image") || "";
        let publications = [];
        try {
          publications = JSON.parse(trigger.getAttribute("data-faculty-publications") || "[]");
        } catch {
          publications = [];
        }

        if (nameEl) nameEl.textContent = name;
        if (areaEl) areaEl.textContent = area;
        if (statusEl) {
          statusEl.textContent =
            status.toUpperCase() === status ? "Involved in Research" : status;
        }

        if (imgEl && initialsEl) {
          if (image) {
            imgEl.setAttribute("src", image);
            imgEl.setAttribute("alt", `Portrait of ${name}`);
            imgEl.classList.remove("hidden");
            initialsEl.classList.add("hidden");
          } else {
            imgEl.classList.add("hidden");
            initialsEl.textContent = name
              .split(/\s+/)
              .filter(Boolean)
              .slice(0, 2)
              .map((part) => (part[0] || "").toUpperCase())
              .join("");
            initialsEl.classList.remove("hidden");
          }
        }

        if (pubCountEl) {
          pubCountEl.textContent = `${publications.length} ${publications.length === 1 ? "publication" : "publications"}`;
        }

        if (pubListEl) {
          pubListEl.innerHTML = "";
          publications.forEach((pub) => {
            const card = document.createElement("article");
            card.className = "rounded-xl border border-neutral-200 bg-neutral-50/75 p-3.5 space-y-1";
            card.appendChild(makeRow("Author(s)", pub.authors || ""));
            card.appendChild(makeRow("Title of Research", pub.title || ""));
            card.appendChild(makeRow("Refereed Journal", pub.journal || ""));
            card.appendChild(makeRow("Date Published", pub.datePublished || ""));
            pubListEl.appendChild(card);
          });
        }

        if (typeof dialog.showModal === "function") {
          dialog.showModal();
        }
        return;
      }

      if (target.closest("[data-modal-close]") || target === dialog) {
        if (typeof dialog.close === "function") {
          dialog.close();
        }
      }
    });
  })();
</script>
