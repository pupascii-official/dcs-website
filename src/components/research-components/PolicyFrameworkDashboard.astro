---
import { ArrowUpRight, ChevronLeft, ChevronRight } from "lucide-react";

export type PolicyBadgeVariant = "faculty-dev" | "academic-rigor" | "core-domains";

export interface PolicySummaryItem {
  badgeLabel: string;
  badgeVariant: PolicyBadgeVariant;
  codeTag?: string;
  showDot?: boolean;
  title: string;
  description: string;
}

export interface FolderPanelItem {
  theme: "darkred" | "white" | "gold" | "red";
  tabLabel: string;
  badge: string;
  badgeVariant: "index" | "eval" | "ethics" | "active";
  eyebrow: string;
  title: string;
  body: string;
  footer: string;
}

export interface Props {
  cards?: PolicySummaryItem[];
  folders?: FolderPanelItem[];
  defaultActiveIndex?: number;
  deckLabel?: string;
  deckBadge?: string;
  manualLabel?: string;
  manualUrl?: string;
  openInNewTab?: boolean;
  sourceNote?: string;
  class?: string;
}

const {
  cards = [
    {
      badgeLabel: "RESEARCH AGENDA",
      badgeVariant: "faculty-dev",
      showDot: true,
      title: "University Research Agenda",
      description:
        "Research priorities aligned with the PDP 2023–2028, DOST HNRDA, and CHED SDG-based framework.",
    },
    {
      badgeLabel: "ACADEMIC RIGOR",
      badgeVariant: "academic-rigor",
      codeTag: "[CS-01]",
      title: "Research Quality Assurance",
      description:
        "Ethics review protects participants; similarity checking supports originality and academic integrity.",
    },
    {
      badgeLabel: "CORE DOMAINS",
      badgeVariant: "core-domains",
      codeTag: "[CS-02]",
      title: "Program Research Agenda",
      description:
        "Educational technology, soft infrastructure, business processing, communication, and green technology.",
    },
  ],
  folders = [
    {
      theme: "darkred",
      tabLabel: "Research Support",
      badge: "INDEXATION SUPPORT",
      badgeVariant: "index",
      eyebrow: "// International Dissemination Pipeline",
      title: "Publication &\nIndexation Support",
      body: "Provides dedicated faculty co-authorship clinics, conference registration grants, and target venue vetting for Scopus, IEEE Xplore, and Web of Science.",
      footer: "BSCS Area 1 — Research • Dissemination & Grant Guidelines",
    },
    {
      theme: "white",
      tabLabel: "CCIS Agenda",
      badge: "EVALUATION RUBRIC",
      badgeVariant: "eval",
      eyebrow: "// Undergraduate Thesis & Capstone Standards",
      title: "CCIS Research &\nInnovation Agenda",
      body: "Defines technical complexity criteria, algorithmic originality benchmarks, and IEEE/ACM manuscript formatting standards required across tracks.",
      footer: "BSCS Area 1 — Research • Programmatic Alignment Matrix",
    },
    {
      theme: "gold",
      tabLabel: "Ethics & Integrity",
      badge: "ETHICS PROTOCOL",
      badgeVariant: "ethics",
      eyebrow: "// Institutional Research Integrity",
      title: "Ethics & Internal\nPeer Review Protocol",
      body: "Ensures all student and faculty studies involving datasets, human participants, or institutional systems undergo rigorous privacy impact assessments.",
      footer: "BSCS Area 1 — Research • RA 10173 Data Privacy & Review Checklist",
    },
    {
      theme: "red",
      tabLabel: "Policy & Evidence",
      badge: "ACTIVE REPOSITORY",
      badgeVariant: "active",
      eyebrow: "// Department of Computer Science",
      title: "Research Agenda\n& Priorities",
      body: "A research agenda aligned with national and University priorities, formulated with faculty, students, administrators, and external stakeholders.",
      footer: "BSCS Area 1 — Research • Narrative and documentary evidence",
    },
  ],
  defaultActiveIndex = 3,
  deckLabel = "RESEARCH AGENDA // SUPPORT & QUALITY ASSURANCE",
  deckBadge = "BSCS AREA 1 • RESEARCH EVIDENCE",
  manualLabel = "ACCESS FULL PUP RESEARCH & DEVELOPMENT MANUAL",
  manualUrl = "",
  openInNewTab = true,
  sourceNote = "BSCS AREA 1 — RESEARCH",
  class: className = "",
} = Astro.props;

const manualDialogId = "pup-research-manual-modal";

const cardBadgeClasses: Record<PolicyBadgeVariant, string> = {
  "faculty-dev": "badge-faculty-dev border border-[#D4A017]/55 text-[#800000] px-3.5 py-1",
  "academic-rigor": "bg-[#F3E6E6] border border-[#800000]/10 text-[#800000] px-3.5 py-1",
  "core-domains": "bg-[#FFE97A] border border-[#E5B82E]/40 text-[#800000] px-3.5 py-1",
};

const folderThemes = {
  darkred: {
    bg: "#420000",
    tabText: "#ffffff",
    arrow: "#ffdf00",
    eyebrow: "#ffffffcc",
    title: "#ffffff",
    body: "#ffffffe5",
    divider: "#ffffff4d",
    footer: "#ffdf00",
  },
  white: {
    bg: "#ffffff",
    tabText: "#800000",
    arrow: "#daa520",
    eyebrow: "#78716c",
    title: "#800000",
    body: "#44403c",
    divider: "#80000033",
    footer: "#800000",
  },
  gold: {
    bg: "#8b6508",
    tabText: "#ffdf00",
    arrow: "#ffdf00",
    eyebrow: "#ffffffd9",
    title: "#ffffff",
    body: "#fffffff2",
    divider: "#ffffff4d",
    footer: "#ffdf00",
  },
  red: {
    bg: "#800000",
    tabText: "#ffdf00",
    arrow: "#ffdf00",
    eyebrow: "#ffffffcc",
    title: "#ffffff",
    body: "#ffffffe5",
    divider: "#ffffff4d",
    footer: "#ffdf00",
  },
} as const;

const tabGeometry = [
  { left: 490, width: 365 },
  { left: 109, width: 350 },
  { left: 434, width: 375 },
  { left: 59, width: 355 },
];

const folderBadgeClasses = {
  index: "bg-[#ffdf00] text-[#420000] text-[9.5px]",
  eval: "bg-[#800000] text-[#ffdf00] text-[9.7px]",
  ethics: "bg-[#ffdf00] text-[#800000] text-[9.4px]",
  active: "bg-[#ffdf00] text-[#800000] text-[9.7px]",
} as const;
---

<div class={`space-y-4 ${className}`} data-policy-dashboard>
  <!-- Main Outer Maroon-Bordered Card -->
  <div
    class="policy-dashboard-shell rounded-3xl border-[1.5px] border-[#800000] p-4 sm:p-5 shadow-[0_24px_56px_-14px_rgba(128,0,0,0.16)] space-y-4"
  >
    <!-- Top 3 Policy Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
      {
        cards.map((card) => (
          <article
            class="policy-summary-card rounded-2xl border border-[#800000]/22 p-4 sm:p-5 shadow-[0_12px_28px_-14px_rgba(128,0,0,0.14)] flex flex-col justify-between transition-transform duration-200 hover:-translate-y-0.5"
          >
            <div class="flex items-center justify-between gap-3 mb-3">
              <span
                class={`inline-flex items-center rounded-full font-['Montserrat',sans-serif] text-[10px] font-extrabold tracking-[0.07em] uppercase leading-none whitespace-nowrap ${cardBadgeClasses[card.badgeVariant]}`}
              >
                {card.badgeLabel}
              </span>

              {
                card.codeTag ? (
                  <span class="font-mono text-[11px] font-bold tracking-wider text-[#800000]">
                    {card.codeTag}
                  </span>
                ) : (
                  card.showDot && (
                    <span
                      aria-hidden="true"
                      class="h-2.5 w-2.5 rounded-full bg-[#DAA520] shadow-[0_0_8px_2px_rgba(218,165,32,0.45)] shrink-0"
                    />
                  )
                )
              }
            </div>

            <div>
              <h3 class="font-['Montserrat',sans-serif] text-[14px] font-extrabold text-neutral-900 leading-snug">
                {card.title}
              </h3>
              <p class="mt-1.5 text-[12px] leading-[1.5] text-neutral-500">
                {card.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- BSCS AREA 1 • RESEARCH EVIDENCE Stacked Folder Container -->
    <div class="policy-deck-well rounded-2xl border border-[#800000]/20 p-3.5 sm:p-5 shadow-[0_12px_28px_-16px_rgba(128,0,0,0.1)]">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
        <div
          class="flex items-center gap-2 font-heading text-[10px] font-extrabold tracking-[0.12em] uppercase text-[#800000]"
        >
          <span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-[#800000]"></span>
          <span>{deckLabel}</span>
        </div>
        <span
          class="inline-flex items-center rounded-full bg-[#F3E8E8] px-3.5 py-1 font-heading text-[9.5px] font-bold tracking-[0.08em] uppercase text-[#800000]"
        >
          {deckBadge}
        </span>
      </div>

      <!-- Staggered 4-Layer Folder Stage -->
      <div
        role="tablist"
        aria-label="BSCS Area 1 research evidence"
        data-folder-stack
        class="relative flex flex-col gap-4 lg:block lg:h-[400px] lg:overflow-hidden lg:rounded-2xl"
      >
        {
          folders.map((folder, idx) => {
            const t = folderThemes[folder.theme];
            const g = tabGeometry[idx] ?? tabGeometry[0];
            const isActive = idx === defaultActiveIndex;
            const vars = [
              `--c:${t.bg}`,
              `--tab-text:${t.tabText}`,
              `--arrow:${t.arrow}`,
              `--top:${idx * 32}px`,
              `--tab-left:${g.left}px`,
              `--tab-w:${g.width}px`,
              `--z:${(idx + 1) * 10}`,
            ].join(";");

            return (
              <div class:list={["folder-wrapper", isActive && "active"]} style={vars}>
                <div class="folder-strip" aria-hidden="true"></div>

                <div
                  class="folder-tab"
                  data-tab={idx}
                  role="tab"
                  tabindex="0"
                  aria-selected={isActive ? "true" : "false"}
                >
                  <span class="folder-tab-arrow" aria-hidden="true">
                    <ChevronLeft className="h-3 w-3 stroke-[2.75]" />
                  </span>
                  <span class="font-heading text-[14px] font-[800] tracking-[0.35px]" style={`color:${t.tabText}`}>
                    {folder.tabLabel}
                  </span>
                  <span class="folder-tab-arrow" aria-hidden="true">
                    <ChevronRight className="h-3 w-3 stroke-[2.75]" />
                  </span>
                </div>

                <div class="folder-body" role="tabpanel">
                  <div class="flex flex-wrap items-center gap-3">
                    <div
                      class={`flex h-[23px] items-center justify-center whitespace-nowrap rounded-full px-4 font-[700] leading-[15px] tracking-[0.5px] uppercase ${folderBadgeClasses[folder.badgeVariant]}`}
                    >
                      {folder.badge}
                    </div>
                    <div class="text-[12px] leading-[16px] lg:text-[14px]" style={`color:${t.eyebrow}`}>
                      {folder.eyebrow}
                    </div>
                  </div>

                  <h3
                    class="mt-2.5 whitespace-pre-line font-heading text-[28px] font-[900] leading-[1.08] tracking-[-1px] lg:text-[42px] lg:leading-[44px]"
                    style={`color:${t.title}`}
                  >
                    {folder.title}
                  </h3>

                  <p class="mt-3 whitespace-pre-line text-[13.5px] leading-[22px] lg:text-[15px]" style={`color:${t.body}`}>
                    {folder.body}
                  </p>

                  <div class="mt-4 h-[1px] w-full lg:w-[576px]" style={`background:${t.divider}`}></div>

                  <p class="mt-3 text-[12px] font-[700] leading-[18px] tracking-[0.35px] lg:max-w-[576px] lg:text-[13.5px]" style={`color:${t.footer}`}>
                    {folder.footer}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <!-- Centered Research Narrative CTA -->
  <div class="flex flex-col items-center gap-1.5 pt-0.5 w-full">
    {
      manualUrl ? (
        <a
          href={manualUrl}
          target={openInNewTab ? "_blank" : undefined}
          rel={openInNewTab ? "noopener noreferrer" : undefined}
          aria-label={manualLabel}
          class="btn-research-manual inline-flex items-center justify-between gap-3 sm:gap-4 w-full max-w-[460px] sm:w-auto sm:max-w-none sm:min-w-[380px] rounded-xl px-4 py-3 sm:px-6 font-['Montserrat',sans-serif] text-[10px] sm:text-[11px] font-extrabold tracking-[0.06em] sm:tracking-[0.08em] uppercase text-white text-left leading-snug shadow-[0_10px_24px_-6px_rgba(120,0,0,0.4)] hover:brightness-110 transition-all duration-200 cursor-pointer whitespace-normal sm:whitespace-nowrap"
        >
          <span>{manualLabel}</span>
          <ArrowUpRight className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
        </a>
      ) : (
        <button
          type="button"
          data-modal-open={manualDialogId}
          aria-label={manualLabel}
          class="btn-research-manual inline-flex items-center justify-between gap-3 sm:gap-4 w-full max-w-[460px] sm:w-auto sm:max-w-none sm:min-w-[380px] rounded-xl px-4 py-3 sm:px-6 font-['Montserrat',sans-serif] text-[10px] sm:text-[11px] font-extrabold tracking-[0.06em] sm:tracking-[0.08em] uppercase text-white text-left leading-snug shadow-[0_10px_24px_-6px_rgba(120,0,0,0.4)] hover:brightness-110 transition-all duration-200 cursor-pointer whitespace-normal sm:whitespace-nowrap"
        >
          <span>{manualLabel}</span>
          <ArrowUpRight className="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
        </button>
      )
    }

    {
      sourceNote && (
        <p class="font-heading text-[9.5px] font-semibold tracking-[0.08em] uppercase text-neutral-400">
          {sourceNote}
        </p>
      )
    }
  </div>
</div>

{
  !manualUrl && (
    <dialog
      id={manualDialogId}
      aria-labelledby={`${manualDialogId}-title`}
      class="m-auto w-[min(94vw,680px)] rounded-2xl border-[1.5px] border-[#780000] bg-white p-0 shadow-[0_28px_60px_-15px_rgba(60,0,0,0.4)] backdrop:bg-black/55 backdrop:backdrop-blur-[2px] overflow-hidden"
    >
      <div class="flex items-center justify-between bg-[#780000] px-5 py-3 text-white">
        <span
          id={`${manualDialogId}-title`}
          class="font-['Montserrat',sans-serif] text-[11px] font-extrabold tracking-[0.12em] uppercase"
        >
          PUP RESEARCH &amp; DEVELOPMENT MANUAL
        </span>
        <button
          type="button"
          data-manual-close
          aria-label="Close research manual"
          class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white/85 hover:bg-white/15 hover:text-white transition-colors cursor-pointer"
        >
          ✕
        </button>
      </div>

      <div class="p-6 space-y-4 max-h-[82vh] overflow-y-auto text-neutral-700 text-[13px] leading-relaxed">
        <div>
          <p class="font-['Montserrat',sans-serif] text-[10px] font-extrabold tracking-[0.12em] uppercase text-[#C89416]">
            BSCS AREA 1 — RESEARCH • POLICY &amp; GOVERNANCE
          </p>
          <h3 class="mt-1 font-['Montserrat',sans-serif] text-[20px] font-black text-neutral-950">
            Research Agenda, Ethics &amp; Dissemination Framework
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-xl border border-[#800000]/15 bg-[#FCF9F8] p-3.5">
            <p class="font-['Montserrat',sans-serif] text-[10px] font-extrabold uppercase tracking-wider text-[#800000]">
              01 // University Agenda
            </p>
            <p class="mt-1 text-[12px] text-neutral-600">
              Aligned with PDP 2023–2028, DOST HNRDA, and CHED SDG-based research priorities.
            </p>
          </div>
          <div class="rounded-xl border border-[#800000]/15 bg-[#FCF9F8] p-3.5">
            <p class="font-['Montserrat',sans-serif] text-[10px] font-extrabold uppercase tracking-wider text-[#800000]">
              02 // Quality Assurance
            </p>
            <p class="mt-1 text-[12px] text-neutral-600">
              Internal ethics review, RA 10173 data privacy compliance, and similarity checking.
            </p>
          </div>
          <div class="rounded-xl border border-[#800000]/15 bg-[#FCF9F8] p-3.5">
            <p class="font-['Montserrat',sans-serif] text-[10px] font-extrabold uppercase tracking-wider text-[#800000]">
              03 // Core CCIS Domains
            </p>
            <p class="mt-1 text-[12px] text-neutral-600">
              Educational technology, soft infrastructure, business processing, communication, and green tech.
            </p>
          </div>
          <div class="rounded-xl border border-[#800000]/15 bg-[#FCF9F8] p-3.5">
            <p class="font-['Montserrat',sans-serif] text-[10px] font-extrabold uppercase tracking-wider text-[#800000]">
              04 // Dissemination Support
            </p>
            <p class="mt-1 text-[12px] text-neutral-600">
              Faculty co-authorship clinics, conference grants, and Scopus/IEEE/WoS venue vetting.
            </p>
          </div>
        </div>
      </div>
    </dialog>
  )
}

<style>
  .policy-dashboard-shell {
    background-image: linear-gradient(180deg, #ffffff 0%, #fcf9f8 58%, #f4ecea 100%);
  }

  .policy-summary-card {
    background-image: linear-gradient(180deg, #ffffff 0%, #fdfbfa 58%, #f8f1ef 100%);
  }

  .policy-deck-well {
    background-image: linear-gradient(180deg, #fdfcfc 0%, #faf6f5 58%, #f4ecea 100%);
  }

  .badge-faculty-dev {
    background-image: linear-gradient(90deg, #f9ecc3 0%, #f4e1a2 100%);
  }

  .btn-research-manual {
    background-image: linear-gradient(90deg, #780000 0%, #9c3b0b 52%, #d49e1a 100%);
  }
</style>

<style is:global>
  /* ---------- FOLDER TABS ---------- */
  .folder-wrapper {
    width: 100%;
  }
  .folder-strip {
    display: none;
  }

  .folder-tab {
    display: flex;
    height: 40px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--c);
    cursor: pointer;
    border-radius: 12px 12px 0 0;
  }
  .folder-tab-arrow {
    font-size: 8px;
    font-weight: 800;
    color: var(--arrow);
  }
  .folder-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--c);
    padding: 20px;
  }

  @media (min-width: 1024px) {
    :root {
      --tab-h: 40px;
      --body-top: 136px;
      --flare: 22px;
    }

    .folder-wrapper {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .folder-strip {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: calc(var(--top) + var(--tab-h) - 1px);
      height: calc(var(--body-top) - var(--top) - var(--tab-h) + 2px);
      background: var(--c);
      z-index: var(--z);
      pointer-events: none;
    }
    .folder-wrapper:last-child .folder-strip {
      display: none;
    }

    .folder-tab {
      position: absolute;
      top: var(--top);
      left: min(var(--tab-left), calc(100% - var(--tab-w) - 16px));
      width: min(var(--tab-w), calc(100% - 32px));
      height: var(--tab-h);
      padding-bottom: 0;
      border-radius: 18px 18px 0 0;
      z-index: calc(60 + var(--z) / 10);
      pointer-events: auto;
      box-shadow: 0 -8px 24px #1e000030;
      transition:
        top 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        height 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        padding-bottom 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.2s ease;
    }
    .folder-tab:hover {
      top: calc(var(--top) - 4px);
      height: calc(var(--tab-h) + 4px);
      padding-bottom: 4px;
      box-shadow: 0 -10px 26px #1e000045;
    }
    .folder-wrapper.active .folder-tab {
      top: calc(var(--top) - 2px);
      height: calc(var(--tab-h) + 2px);
      padding-bottom: 2px;
    }
    .folder-wrapper:last-child.active .folder-tab {
      height: calc(var(--tab-h) + 3px);
      padding-bottom: 3px;
    }
    .folder-wrapper.active .folder-tab:hover {
      top: calc(var(--top) - 4px);
      height: calc(var(--tab-h) + 4px);
      padding-bottom: 4px;
    }
    .folder-wrapper:last-child.active .folder-tab:hover {
      height: calc(var(--tab-h) + 5px);
      padding-bottom: 5px;
    }
    .folder-tab:focus-visible {
      outline: 2px solid #ffdf00;
      outline-offset: -2px;
      top: calc(var(--top) - 4px);
      height: calc(var(--tab-h) + 4px);
      padding-bottom: 4px;
    }

    .folder-tab::before,
    .folder-tab::after {
      content: "";
      position: absolute;
      bottom: 0;
      width: var(--flare);
      height: var(--flare);
      pointer-events: none;
    }
    .folder-tab::before {
      left: calc(var(--flare) * -1);
      background: radial-gradient(
        circle at 0 0,
        transparent calc(var(--flare) - 0.5px),
        var(--c) var(--flare)
      );
    }
    .folder-tab::after {
      right: calc(var(--flare) * -1);
      background: radial-gradient(
        circle at 100% 0,
        transparent calc(var(--flare) - 0.5px),
        var(--c) var(--flare)
      );
    }

    .folder-body {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: var(--body-top);
      bottom: 0;
      padding: 20px 44px 0;
      z-index: var(--z);
      pointer-events: auto;
    }

    .folder-wrapper.active .folder-body {
      display: flex;
      z-index: 50;
      animation: folderPanelReveal 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes folderPanelReveal {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .folder-tab,
      .folder-wrapper.active .folder-body {
        transition: none;
        animation: none;
      }
    }
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-policy-dashboard]").forEach((root) => {
      const stack = root.querySelector("[data-folder-stack]");
      if (!stack) return;

      const wrappers = Array.from(stack.querySelectorAll(".folder-wrapper"));
      const total = wrappers.length;

      const activateFolder = (targetIndex) => {
        wrappers.forEach((wrapper, idx) => {
          const tab = wrapper.querySelector(".folder-tab");
          const isActive = idx === targetIndex;
          wrapper.classList.toggle("active", isActive);
          if (tab) {
            tab.setAttribute("aria-selected", String(isActive));
          }
        });
      };

      wrappers.forEach((wrapper, idx) => {
        const tab = wrapper.querySelector(".folder-tab");
        if (!tab) return;

        tab.addEventListener("click", () => activateFolder(idx));
        tab.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            activateFolder(idx);
          } else if (e.key === "ArrowRight" || e.key === "ArrowDown") {
            e.preventDefault();
            activateFolder((idx + 1) % total);
          } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
            e.preventDefault();
            activateFolder((idx - 1 + total) % total);
          }
        });
      });

      const manualBtn = root.querySelector("[data-modal-open]");
      const manualDialogId = manualBtn?.getAttribute("data-modal-open");
      const manualDialog = manualDialogId ? document.getElementById(manualDialogId) : null;
      if (manualBtn && manualDialog) {
        manualBtn.addEventListener("click", () => {
          if (typeof manualDialog.showModal === "function") {
            manualDialog.showModal();
          }
        });
        manualDialog.addEventListener("click", (e) => {
          const t = e.target;
          if (t === manualDialog || (t instanceof Element && t.closest("[data-manual-close]"))) {
            if (typeof manualDialog.close === "function") {
              manualDialog.close();
            }
          }
        });
      }
    });
  })();
</script>
