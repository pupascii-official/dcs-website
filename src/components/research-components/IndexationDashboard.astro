---
import ActionButton from "./ActionButton.astro";
import IndexationRingChart, { type RingYearData } from "./IndexationChart.astro";
import PublicationDeckCard, { type IndexationSourceStat } from "./PublicationDeckCard.astro";

export interface YearDeckItem {
  year: number;
  total: number;
  ringLabel: string;
  scaleLabel: string;
  headline?: string;
  subtitle?: string;
  summary: string;
  sources: IndexationSourceStat[];
}

export interface Props {
  eyebrow?: string;
  subtitle?: string;
  centerUnit?: string;
  sourceNote?: string;
  years?: YearDeckItem[];
  class?: string;
}

const {
  eyebrow = "RESEARCH OUTPUT • 2021–2025",
  subtitle = "39 completed studies; output peaked in 2023 with 13 studies.",
  centerUnit = "STUDIES",
  sourceNote = "BSCS AREA 1 — RESEARCH",
  years = [
    {
      year: 2021,
      total: 5,
      ringLabel: "DECK 2021 • INNER RING",
      scaleLabel: "2021–2025 • 39 STUDIES",
      headline: "Completed Studies in 2021",
      subtitle: "2021 studies are mainly in health and information systems.",
      summary:
        "Completed studies in 2021 focused primarily on health informatics and institutional information systems, laying the foundation for predictive analytics and NLP research.",
      sources: [
        { count: 1, label: "PUBLICATIONS" },
        { count: 2, label: "TALKS" },
        { count: 18, label: "CITATIONS" },
      ],
    },
    {
      year: 2022,
      total: 11,
      ringLabel: "DECK 2022 • RING 02",
      scaleLabel: "2021–2025 • 39 STUDIES",
      headline: "Completed Studies in 2022",
      subtitle: "Eleven completed studies across foundational computing domains.",
      summary:
        "The 2022 studies established machine learning pipelines, campus information systems, and early natural language processing prototypes.",
      sources: [
        { count: 3, label: "PUBLICATIONS" },
        { count: 4, label: "TALKS" },
        { count: 52, label: "CITATIONS" },
      ],
    },
    {
      year: 2023,
      total: 13,
      ringLabel: "DECK 2023 • PEAK OUTPUT",
      scaleLabel: "2021–2025 • 39 STUDIES",
      headline: "Completed Studies in 2023",
      subtitle: "Peak annual research productivity with thirteen completed studies.",
      summary:
        "In 2023, faculty and student researchers produced 13 studies spanning sentiment analysis, healthcare decision support, and automated classification.",
      sources: [
        { count: 6, label: "PUBLICATIONS" },
        { count: 5, label: "TALKS" },
        { count: 64, label: "CITATIONS" },
      ],
    },
    {
      year: 2024,
      total: 6,
      ringLabel: "DECK 2024 • RING 04",
      scaleLabel: "2021–2025 • 39 STUDIES",
      headline: "Completed Studies in 2024",
      subtitle: "Six completed studies in deep learning and cloud systems.",
      summary:
        "The 2024 cohort focused on deep-learning diagnostics, distributed systems resilience, and smart-city predictive analytics.",
      sources: [
        { count: 8, label: "PUBLICATIONS" },
        { count: 3, label: "TALKS" },
        { count: 40, label: "CITATIONS" },
      ],
    },
    {
      year: 2025,
      total: 4,
      ringLabel: "DECK 2025 • OUTER RING",
      scaleLabel: "2021–2025 • 39 STUDIES",
      headline: "Completed Studies in 2025",
      subtitle: "Four completed studies using advanced computational methods.",
      summary:
        "The 2025 studies applied BERT and DistilBERT to Gen Z slang and risk statements, one-dimensional CNNs to job-tier classification, and transformer-based methods to Marikina River forecasting.",
      sources: [
        { count: 6, label: "PUBLICATIONS" },
        { count: 3, label: "TALKS" },
        { count: 69, label: "CITATIONS" },
      ],
    },
  ],
  class: className = "",
} = Astro.props;

const defaultIndex = years.length - 1;
const defaultYear = years[defaultIndex]?.year ?? 2025;
const maxTotal = Math.max(...years.map((y) => y.total), 1);
const palette = ["#780000", "#9E2A1C", "#C89416", "#E5B82E", "#B4690E"];
const ringData: RingYearData[] = [...years]
  .reverse()
  .map((item, i) => ({
    year: item.year,
    count: item.total,
    progress: Math.max(0.32, Math.min(0.88, item.total / maxTotal)),
    color: palette[i % palette.length],
  }));
---

<section
  data-indexation-dashboard
  data-active-index={defaultIndex}
  class={`rounded-3xl border-[1.5px] border-[#780000]/75 bg-white p-6 sm:p-10 shadow-[0_24px_50px_-14px_rgba(120,0,0,0.16)] ${className}`}
>
  <div class="grid grid-cols-1 lg:grid-cols-[310px_1fr] gap-8 lg:gap-10 items-center">
    <!-- Left: Animated Concentric Ring Chart + Year Selector Pills -->
    <div class="flex flex-col items-center">
      <div class="relative">
        <IndexationRingChart
          activeYear={defaultYear}
          unitLabel={centerUnit}
          rings={ringData}
        />
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        {
          years.map((item, idx) => (
            <button
              type="button"
              data-year-select={idx}
              data-year-value={item.year}
              class={`rounded-full px-3.5 py-1.5 font-['Montserrat',sans-serif] text-[10.5px] font-extrabold tracking-[0.04em] tabular-nums transition-all duration-200 cursor-pointer ${
                idx === defaultIndex
                  ? "bg-[#780000] text-[#FFE600] shadow-sm scale-[1.03]"
                  : "border border-neutral-300 bg-white text-neutral-700 hover:border-[#780000]/50 hover:text-[#780000]"
              }`}
            >
              {item.year} • {item.total}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Right: 3D Deck Carousel -->
    <div>
      <div class="flex items-center justify-between gap-4 mb-5">
        <div>
          <p
            class="font-['Montserrat',sans-serif] text-[10.5px] font-extrabold tracking-[0.12em] uppercase text-[#780000]"
          >
            {eyebrow}
          </p>
          <p class="mt-0.5 text-[11.5px] text-neutral-500">
            {subtitle}
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <div data-deck-prev>
            <ActionButton
              variant="icon-nav"
              iconDirection="prev"
              ariaLabel="Previous year"
            />
          </div>
          <div data-deck-next>
            <ActionButton
              variant="icon-nav"
              iconDirection="next"
              ariaLabel="Next year"
            />
          </div>
        </div>
      </div>

      <div class="relative">
        {
          years.map((item, idx) => (
            <div
              data-deck-card={idx}
              data-deck-year={item.year}
              data-deck-total={item.total}
              class={idx === defaultIndex ? "block deck-card-enter" : "hidden"}
            >
              <PublicationDeckCard
                year={item.year}
                deckLabel={item.ringLabel}
                scaleLabel={item.scaleLabel}
                total={item.total}
                headline={item.headline}
                subtitle={item.subtitle}
                summary={item.summary}
                sources={item.sources}
              />
            </div>
          ))
        }
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
        <p class="font-['Montserrat',sans-serif] text-[9.5px] font-semibold tracking-[0.06em] uppercase text-neutral-400">
          {sourceNote}
        </p>
        <div class="flex items-center gap-1.5">
          {
            years.map((item, idx) => (
              <button
                type="button"
                data-deck-dot={idx}
                aria-label={`View ${item.year} research output`}
                class={`h-2 rounded-full transition-all duration-300 cursor-pointer ${
                  idx === defaultIndex
                    ? "w-6 bg-[#780000]"
                    : "w-2 bg-neutral-300 hover:bg-neutral-400"
                }`}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes deckCardEnter {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .deck-card-enter {
    animation: deckCardEnter 0.34s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-card-enter {
      animation: none;
    }
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-indexation-dashboard]").forEach((root) => {
      const cards = Array.from(root.querySelectorAll("[data-deck-card]"));
      const pills = Array.from(root.querySelectorAll("[data-year-select]"));
      const dots = Array.from(root.querySelectorAll("[data-deck-dot]"));
      const ringArcs = Array.from(root.querySelectorAll("[data-ring-arc]"));
      const ringGroups = Array.from(root.querySelectorAll("[data-ring-group]"));
      const centerWrap = root.querySelector("[data-ring-center]");
      const centerYear = root.querySelector("[data-ring-center-year]");
      const centerCount = root.querySelector("[data-ring-center-count]");
      const total = cards.length;
      let active = Number(root.getAttribute("data-active-index") || total - 1);
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const triggerRingSweep = () => {
        if (reducedMotion) return;
        ringArcs.forEach((arc) => {
          const circumference = arc.getAttribute("data-circumference");
          if (circumference) {
            arc.setAttribute("stroke-dashoffset", circumference);
          }
        });
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            ringArcs.forEach((arc) => {
              const target = arc.getAttribute("data-target-offset");
              if (target) {
                arc.setAttribute("stroke-dashoffset", target);
              }
            });
          });
        });
      };

      const update = (nextIndex, animateCenter = true) => {
        active = (nextIndex + total) % total;
        const activeCard = cards[active];
        const activeYear = activeCard?.getAttribute("data-deck-year") || "";
        const activeTotal = activeCard?.getAttribute("data-deck-total") || "";

        cards.forEach((el, i) => {
          const isMatch = i === active;
          el.classList.toggle("hidden", !isMatch);
          el.classList.toggle("block", isMatch);
          if (isMatch) {
            el.classList.remove("deck-card-enter");
            void el.offsetWidth;
            el.classList.add("deck-card-enter");
          }
        });

        ringArcs.forEach((arc) => {
          const isMatch = arc.getAttribute("data-ring-year") === activeYear;
          arc.setAttribute("stroke-width", isMatch ? "11.5" : "10");
          arc.setAttribute("opacity", isMatch ? "1" : "0.52");
        });

        if (centerYear) centerYear.textContent = `YEAR ${activeYear}`;
        if (centerCount) centerCount.textContent = activeTotal;
        if (animateCenter && centerWrap && !reducedMotion) {
          centerWrap.classList.remove("ring-center-pop");
          void centerWrap.offsetWidth;
          centerWrap.classList.add("ring-center-pop");
        }

        pills.forEach((el, i) => {
          el.className =
            i === active
              ? "rounded-full px-3.5 py-1.5 font-['Montserrat',sans-serif] text-[10.5px] font-extrabold tracking-[0.04em] tabular-nums transition-all duration-200 cursor-pointer bg-[#780000] text-[#FFE600] shadow-sm scale-[1.03]"
              : "rounded-full px-3.5 py-1.5 font-['Montserrat',sans-serif] text-[10.5px] font-extrabold tracking-[0.04em] tabular-nums transition-all duration-200 cursor-pointer border border-neutral-300 bg-white text-neutral-700 hover:border-[#780000]/50 hover:text-[#780000]";
        });

        dots.forEach((el, i) => {
          el.className =
            i === active
              ? "h-2 rounded-full transition-all duration-300 cursor-pointer w-6 bg-[#780000]"
              : "h-2 rounded-full transition-all duration-300 cursor-pointer w-2 bg-neutral-300 hover:bg-neutral-400";
        });
      };

      pills.forEach((p, i) => p.addEventListener("click", () => update(i)));
      dots.forEach((d, i) => d.addEventListener("click", () => update(i)));
      ringGroups.forEach((g) => {
        g.addEventListener("click", () => {
          const y = g.getAttribute("data-ring-year");
          const matchIdx = cards.findIndex((c) => c.getAttribute("data-deck-year") === y);
          if (matchIdx !== -1) update(matchIdx);
        });
      });

      root
        .querySelector("[data-deck-prev]")
        ?.addEventListener("click", () => update(active - 1));
      root
        .querySelector("[data-deck-next]")
        ?.addEventListener("click", () => update(active + 1));

      if ("IntersectionObserver" in window) {
        let hasAnimated = false;
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !hasAnimated) {
                hasAnimated = true;
                triggerRingSweep();
                observer.disconnect();
              }
            });
          },
          { threshold: 0.25 }
        );
        observer.observe(root);
      } else {
        triggerRingSweep();
      }
    });
  })();
</script>
