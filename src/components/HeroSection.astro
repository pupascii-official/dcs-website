---
interface Props {
    title: string;
    subtitle: string;
}

const {title, subtitle} = Astro.props;
---

<section class="scroll-section hero">
    <div class="hero-content">
        <h1 class="title">{title}</h1>
        <p class="subtitle">{subtitle}</p>

        <div class="hero-slot-content">
            <slot/>
        </div>
    </div>
</section>

<style>
    .hero {
        background: linear-gradient(to bottom, var(--color-dark-maroon), var(--color-maroon));
        color: var(--color-white);
        padding: 2rem;

        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .title {
        font-size: clamp(3rem, 8vw, 6rem);
        margin: 1rem 0;
    }

    .subtitle {
        color: var(--color-dark-gold);
        font-size: medium;
        font-family: var(--font-inter), system-ui, sans-serif;
        font-weight: 600;
        margin: 0 0 1rem;
    }

    .hero-content {
        max-width: 1100px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

	.hero-orb-3 {
		top: 28%;
		left: -4rem;
		width: 288px;
		height: 288px;
		background: rgba(128, 0, 0, 0.6);
		filter: blur(88px);
	}

	.hero-card {
		position: relative;
		margin: auto;
		width: 100%;
		max-width: 1024px;
		border-radius: 24px;
		padding: 2rem 1.5rem;
	}

	.hero-glass-surface {
		position: absolute;
		inset: 0;
		border-radius: 24px;
		pointer-events: none;
		background-color: rgba(255, 255, 255, 0.1);
		background-image: linear-gradient(
			155deg,
			rgba(255, 255, 255, 0.15) 0%,
			rgba(128, 0, 0, 0.3) 50%,
			rgba(74, 0, 0, 0.5) 100%
		);
		border: 1px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		box-shadow: 0 30px 80px -10px rgba(0, 0, 0, 0.65);
	}

	.hero-content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	h1.hero-title {
		margin: 0;
		font-family: var(--font-montserrat), "Montserrat", ui-sans-serif, system-ui, sans-serif;
		font-size: 32px;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: var(--color-white, #ffffff);
		text-wrap: balance;
	}

	.hero-title-accent {
		color: var(--color-dark-gold, #daa520);
	}

	p.hero-subtitle {
		margin: 0.75rem 0 0;
		max-width: 800px;
		color: var(--color-dark-gold, #daa520);
		font-size: medium;
		font-family: var(--font-inter), "Plus Jakarta Sans", system-ui, sans-serif;
		font-weight: 600;
	}

	.hero-slot-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		width: 100%;
		max-width: 800px;
		margin-top: 1.25rem;
		font-family: var(--font-inter), "Plus Jakarta Sans", system-ui, sans-serif;
	}

	.hero-slot-content:empty {
		display: none;
	}

	.hero-slot-content :global(p) {
		margin-top: 0;
		margin-bottom: 0.75rem;
	}

	.hero-slot-content :global(p:last-child) {
		margin-bottom: 0;
	}

	.hero-slot-content :global(h2),
	.hero-slot-content :global(h3),
	.hero-slot-content :global(h4) {
		color: inherit;
	}

	@media (min-width: 640px) {
		.hero-gradient-canvas {
			padding: 8rem 2.5rem 3.5rem;
		}

		.hero-card {
			padding: 3.5rem;
		}

		h1.hero-title {
			font-size: 52px;
		}
	}

	@media (min-width: 768px) {
		h1.hero-title {
			font-size: 58px;
		}
	}
</style>