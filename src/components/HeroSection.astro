---
export interface Props {
	title: string;
	accentTitle?: string;
	subtitle?: string;
	class?: string;
}

const {
	title,
	accentTitle,
	subtitle,
	class: className = "",
} = Astro.props;
---

<section
	id="top"
	class={`scroll-section hero-gradient-canvas ${className}`}
>
	<!-- Ambient blurred maroon/gold mesh orbs (isolated behind content with no stacking trap) -->
	<div aria-hidden="true" class="hero-orbs">
		<div class="hero-orb hero-orb-1"></div>
		<div class="hero-orb hero-orb-2"></div>
		<div class="hero-orb hero-orb-3"></div>
	</div>

	<slot name="top" />

	<!-- Centered Frosted Glass Card Wrapper -->
	<div class="hero-card">
		<div aria-hidden="true" class="hero-glass-surface"></div>

		<div class="hero-content">
			<h1 class="hero-title">
				<span>{title}</span>{accentTitle && <span class="hero-title-accent"> {accentTitle}</span>}
			</h1>

			{subtitle && <p class="hero-subtitle">{subtitle}</p>}

			<div class="hero-slot-content"><slot /></div>
		</div>
	</div>
</section>

<style>
	.hero-gradient-canvas {
		position: relative;
		width: 100%;
		min-height: 100dvh;
		overflow-x: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 7rem 1rem 2.5rem;
		text-align: center;
		color: var(--color-white, #ffffff);
		background-color: #4a0000;
		background-image:
			radial-gradient(ellipse 68% 66% at 50% 48%, rgba(128, 0, 0, 0.75) 0%, rgba(128, 0, 0, 0) 60%),
			radial-gradient(ellipse 85% 95% at 24% 85%, rgba(90, 0, 0, 0.9) 0%, rgba(90, 0, 0, 0) 50%),
			radial-gradient(ellipse 85% 90% at 75% 80%, rgba(255, 223, 0, 0.22) 0%, rgba(255, 223, 0, 0) 55%),
			radial-gradient(ellipse 95% 85% at 85% 25%, rgba(218, 165, 32, 0.35) 0%, rgba(218, 165, 32, 0) 50%),
			radial-gradient(ellipse 95% 90% at 15% 20%, rgba(128, 0, 0, 0.95) 0%, rgba(128, 0, 0, 0) 55%);
	}

	.hero-orbs {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.hero-orb {
		position: absolute;
		border-radius: 9999px;
	}

	.hero-orb-1 {
		top: -6rem;
		left: 55%;
		width: 384px;
		height: 384px;
		background: rgba(255, 223, 0, 0.15);
		filter: blur(96px);
	}

	.hero-orb-2 {
		bottom: -8rem;
		left: 32%;
		width: 448px;
		height: 448px;
		background: rgba(218, 165, 32, 0.2);
		filter: blur(96px);
	}

	.hero-orb-3 {
		top: 28%;
		left: -4rem;
		width: 288px;
		height: 288px;
		background: rgba(128, 0, 0, 0.6);
		filter: blur(88px);
	}

	.hero-card {
		position: relative;
		margin: auto;
		width: 100%;
		max-width: 1024px;
		border-radius: 24px;
		padding: 2rem 1.5rem;
	}

	.hero-glass-surface {
		position: absolute;
		inset: 0;
		border-radius: 24px;
		pointer-events: none;
		background-color: rgba(255, 255, 255, 0.1);
		background-image: linear-gradient(
			155deg,
			rgba(255, 255, 255, 0.15) 0%,
			rgba(128, 0, 0, 0.3) 50%,
			rgba(74, 0, 0, 0.5) 100%
		);
		border: 1px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		box-shadow: 0 30px 80px -10px rgba(0, 0, 0, 0.65);
	}

	.hero-content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	h1.hero-title {
		margin: 0;
		font-family: var(--font-montserrat), "Montserrat", ui-sans-serif, system-ui, sans-serif;
		font-size: 32px;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.06;
		color: var(--color-white, #ffffff);
		text-wrap: balance;
	}

	.hero-title-accent {
		color: var(--color-dark-gold, #daa520);
	}

	p.hero-subtitle {
		margin: 0.75rem 0 0;
		max-width: 800px;
		color: var(--color-dark-gold, #daa520);
		font-size: medium;
		font-family: var(--font-inter), "Plus Jakarta Sans", system-ui, sans-serif;
		font-weight: 600;
	}

	.hero-slot-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		width: 100%;
		max-width: 800px;
		margin-top: 1.25rem;
		font-family: var(--font-inter), "Plus Jakarta Sans", system-ui, sans-serif;
	}

	.hero-slot-content:empty {
		display: none;
	}

	.hero-slot-content :global(p) {
		margin-top: 0;
		margin-bottom: 0.75rem;
	}

	.hero-slot-content :global(p:last-child) {
		margin-bottom: 0;
	}

	.hero-slot-content :global(h2),
	.hero-slot-content :global(h3),
	.hero-slot-content :global(h4) {
		color: inherit;
	}

	@media (min-width: 640px) {
		.hero-gradient-canvas {
			padding: 8rem 2.5rem 3.5rem;
		}

		.hero-card {
			padding: 3.5rem;
		}

		h1.hero-title {
			font-size: 52px;
		}
	}

	@media (min-width: 768px) {
		h1.hero-title {
			font-size: 58px;
		}
	}
</style>
