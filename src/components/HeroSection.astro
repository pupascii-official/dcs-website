---
interface Props {
    title: string
    subtitle: string
}

const { titleL, titleR, subtitle } = Astro.props;
---

<section class="scroll-section hero">
    <div class="hero-content">
        <div class="eyebrow">
            <slot  name="eyebrow"/>
        </div>
        
        <h1>{titleL}<span class="titleR"> {titleR}</span></h1>
        <h2 class="subtitle">{subtitle}</h2>

        <div class="actions">
            <slot name="actions"/>
        </div>
        
    </div>
</section>

<style>
    .hero {
        background: linear-gradient(to bottom, var(--color-dark-maroon), var(--color-maroon));
        /* I adapted this linear-gradient code from Elijah */
        color: white;
        padding: 2rem;

        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    .eyebrow {
        color: var(--color-gold);
        margin-block-end: 1em;
        opacity: 0.8;
    }

    .titleR {
        color: var(--color-gold);
    }

    .subtitle {
        color: var(--color-white);
        opacity: 0.8;
        font-size: medium;
        font-family: var(--font-inter), system-ui, sans-serif;
        font-weight: 600;
        margin: 0;
    }

    .hero-content {
        max-width: 800px;
    }
</style>