---
interface Props {
    kicker?: string;
    display?: string;
}

const {kicker, display} = Astro.props;
---

<div class="spotlight-banner">
    <div class="spotlight-media">
        <slot name="media"/>
        <div class="edge-fade"></div>
    </div>

    <div class="spotlight-text">
        {kicker ? <small class="kicker">{kicker}</small> :
                <slot name="kicker"/>}
        {display && <h3 class="display">{display}</h3>}
        <slot name="content"/>
    </div>
</div>

<style>
    .spotlight-banner {
        background-color: var(--color-maroon);
        border: 1.5px solid var(--color-maroon);
        color: var(--color-white);
        border-radius: 1.25rem;
        box-shadow: 0 8px 24px color-mix(in srgb, var(--color-drop-shadow) 25%, transparent);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    @media (min-width: 900px) {
        .spotlight-banner {
            flex-direction: row;
            align-items: stretch;
        }
    }

    .spotlight-media {
        position: relative;
        flex: 1 1 52%;
        min-height: 260px;
    }

    .spotlight-media :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 0;
    }

    .edge-fade {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent 55%, var(--color-maroon) 100%);
        pointer-events: none;
    }

    @media (min-width: 900px) {
        .edge-fade {
            background: linear-gradient(to right, transparent 55%, var(--color-maroon) 100%);
        }
    }

    .spotlight-text {
        position: relative;
        z-index: 2;
        flex: 1 1 48%;
        padding: 2.5rem 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.75rem;
    }

    .kicker {
        color: var(--color-white);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .display {
        font-size: clamp(1.75rem, 3vw, 3rem);
        background: linear-gradient(to right, var(--color-gold), var(--color-white));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0;
    }

    .spotlight-text :global(p) {
        margin: 0;
    }
</style>