---

<section class={`w-full ${className}`}>
  {
    showHeading ? (
      <HeadlineComponent
        variant="section"
        kicker={eyebrow}
        headline={heading}
        class="mb-5 sm:mb-6"
      >
        <StatusBadge slot="action" label={guidanceLabel} variant="faculty-guidance" />
      </HeadlineComponent>
    ) : (
      Boolean(guidanceLabel) && (
        <div class="mb-6 flex justify-end">
          <StatusBadge label={guidanceLabel} variant="faculty-guidance" />
        </div>
      )
    )
  }

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
    {
      faculty.map((member) => (
        <FacultyFolderCard
          id={member.id}
          name={member.name}
          researchArea={member.researchArea}
          status={member.status}
          ctaLabel={member.ctaLabel}
          folderSlug={member.folderSlug}
          imageSrc={member.imageSrc}
          publications={member.publications}
          modalId={modalId}
        />
      ))
    }
  </div>

  <FacultyProfileModal modalId={modalId} />
</section>
