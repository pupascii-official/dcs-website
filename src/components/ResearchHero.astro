---
import StatusBadge from "./StatusBadge.astro";

export interface Props {
  badgeLabel?: string;
  heading?: string;
  subheading?: string;
  description?: string;
  class?: string;
}

const {
  badgeLabel = "PILLAR 01 // RESEARCH · DEPARTMENT OF COMPUTER SCIENCE",
  heading = "Research & Innovation",
  subheading = "Completed research, disseminated publications, high-impact indexation rates, and faculty research involvement shaping the future of information systems and computer vision.",
  description = "Advancing foundational computing research, ethical AI systems, and collaborative academic innovation across local and international scholarly communities.",
  class: className = "",
} = Astro.props;
---

<section
  class={`relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#6A0000] via-[#4A0000] to-[#260000] px-6 sm:px-14 py-16 sm:py-24 text-center text-white shadow-[0_28px_60px_-20px_rgba(50,0,0,0.55)] ${className}`}
>
  <!-- Subtle warm radial ambient glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_38%,rgba(217,164,29,0.2),transparent_60%)]"
  ></div>

  <div
    class="relative z-10 mx-auto max-w-3xl rounded-3xl border border-white/10 bg-white/[0.04] px-6 sm:px-12 py-10 sm:py-12 backdrop-blur-sm shadow-2xl"
  >
    <StatusBadge label={badgeLabel} variant="research-pillar" />

    <h1
      class="mt-6 font-['Montserrat',sans-serif] text-[34px] sm:text-[52px] font-black tracking-[-0.03em] leading-[1.06] text-white text-balance"
    >
      {heading}
    </h1>

    <p class="mt-4 text-[14px] sm:text-[15.5px] font-medium leading-[1.6] text-white/90">
      {subheading}
    </p>

    <p class="mt-4 text-[12px] sm:text-[13px] leading-[1.65] text-white/65 max-w-xl mx-auto">
      {description}
    </p>
  </div>
</section>
