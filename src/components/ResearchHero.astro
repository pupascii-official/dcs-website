---
import  Navbar from "./Navbar.astro";

export interface Props {
  departmentCode?: string;
  departmentName?: string;
  departmentTag?: string;
  badgeLabel?: string;
  heading?: string;
  accentHeading?: string;
  subheading?: string;
  description?: string;
  class?: string;
}

const {
  departmentCode = "CS",
  departmentName = "Department of Computer Science",
  departmentTag = "[Research]",
  badgeLabel = "Pillar 01 / Research • Department of Computer Science",
  heading = "Research &",
  accentHeading = "Innovation",
  subheading = "39 completed studies, 24 refereed publications, and 225 citations. Research that is published, presented, cited, recognized, and used.",
  description = "The University envisions itself as a premier center of research in social capital and innovation towards inclusive growth for national development. Five active projects have target completion dates from July 2026 to January 2028.",
  class: className = "",
} = Astro.props;
---

<section
  id="top"
  class={`relative w-full overflow-hidden bg-gradient-to-b from-[#4C0000] via-[#360000] to-[#230000] px-6 sm:px-10 pt-7 pb-16 sm:pb-20 text-center text-white ${className}`}
>
  <!-- Ambient radial maroon/gold glow -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_42%,rgba(217,164,29,0.14),transparent_60%)]"
  ></div>

  <div class="relative z-10 mx-auto max-w-4xl flex flex-col items-center">
    <Navbar
      code={departmentCode}
      department={departmentName}
      tag={departmentTag}
    />

    <div class="mt-9">
      <span
        class="inline-flex items-center rounded-full border border-[#D9A41D]/55 bg-[#780000]/65 px-4 py-1.5 font-['Montserrat',sans-serif] text-[10px] font-bold tracking-[0.06em] text-[#FFD94A]"
      >
        {badgeLabel}
      </span>
    </div>

    <h1
      class="mt-6 font-['Montserrat',sans-serif] text-[40px] sm:text-[58px] font-black tracking-[-0.03em] leading-[1.03] text-white text-balance"
    >
      <span class="block">{heading}</span>
      {accentHeading && <span class="block text-[#FFE600]">{accentHeading}</span>}
    </h1>

    <p
      class="mt-6 max-w-xl text-[13px] sm:text-[14px] font-medium leading-[1.6] text-white/90"
    >
      {subheading}
    </p>

    <p
      class="mt-3.5 max-w-xl text-[11.5px] sm:text-[12px] leading-[1.65] text-white/60"
    >
      {description}
    </p>
  </div>
</section>
