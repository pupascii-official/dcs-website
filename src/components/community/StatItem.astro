---
interface Props {
    value: string;
    label: string;
}

const { value, label } = Astro.props;
---

<div class="flex items-center gap-10">
    <span class="font-(family-name:--font-montserrat) text-4xl font-bold text-(--color-maroon)">
        {value}
    </span>
    <span class="text-base font-bold text-(--color-text-body)/75">{label}</span>
</div>
