---
interface Props {
    badge: string;
    badgeClass?: string;
    code?: string;
    title: string;
    description: string;
}

const {
    badge,
    badgeClass = "bg-[#800000]/10",
    code,
    title,
    description,
} = Astro.props;
---

<div class="group rounded-2xl border-2 border-[#800000]/30 bg-white p-6 shadow-[0_18px_40px_-10px_rgba(128,0,0,0.2)]">
    <div class="flex items-center justify-between mb-3">
        <span class={`rounded-full px-3 py-1 text-[10px] font-bold tracking-wider text-(--color-maroon) uppercase ${badgeClass}`}>
            {badge}
        </span>
        <span class="h-2.5 w-2.5 rounded-full bg-(--color-dark-gold) shadow-[0_0_8px_#DAA520] hidden group-hover:inline-block" />
        <span class="text-xs font-bold text-(--color-maroon) group-hover:hidden">{code}</span>
    </div>
    <h4 class="font-(family-name:--font-montserrat) text-lg font-bold text-(--color-text-body) mb-1">
        {title}
    </h4>
    <p class="text-xs leading-relaxed text-(--color-text-body)/75">{description}</p>
</div>
