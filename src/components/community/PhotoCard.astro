---
interface Props {
    src: string;
    alt: string;
    caption: string;
}

const { src, alt, caption } = Astro.props;
---

<div class="flex flex-col gap-3">
    <img
        src={src}
        alt={alt}
        class="aspect-[16/10] w-full rounded-lg object-cover"
    />
    <span class="text-[13px] text-center text-(--color-text-body)/75">
        {caption}
    </span>
</div>
