---
export interface MetricItem {
  tag: string;
  value: string | number;
  title: string;
  description: string;
  variant: "maroon" | "gold" | "featured";
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  metrics?: MetricItem[];
  class?: string;
}

const {
  eyebrow = "SECTION 02 // KEY PERFORMANCE INDICATORS",
  heading = "Research Metrics",
  metrics = [
    {
      tag: "METRIC 01 // OUTPUT",
      value: 39,
      title: "COMPLETED RESEARCH",
      description: "Completed studies, 2021–2025.",
      variant: "maroon",
    },
    {
      tag: "METRIC 02 // REACH",
      value: 24,
      title: "REFEREED PUBLICATIONS",
      description: "Refereed journals, proceedings, and edited volumes, 2021–2025.",
      variant: "gold",
    },
    {
      tag: "METRIC 03 // IMPACT",
      value: 65,
      title: "WURI RESEARCH RANK",
      description: "PUP-CCIS Research Representative Project, WURI 2025.",
      variant: "featured",
    },
  ],
  class: className = "",
} = Astro.props;

const variantStyles = {
  maroon: {
    backLayerOuter: "bg-[#D9A41D]",
    backLayerInner: "bg-[#680000]",
    card: "bg-white border-[1.5px] border-[#780000] shadow-[0_24px_45px_-12px_rgba(120,0,0,0.16)]",
    pill: "bg-[#780000] text-[#FFD94A]",
    halo: "bg-[#780000]/15",
    dot: "bg-[#780000]",
    value: "text-[#780000] [text-shadow:0_6px_14px_rgba(120,0,0,0.18)]",
    divider: "bg-neutral-200/90",
    title: "text-neutral-950",
    description: "text-neutral-500",
  },
  gold: {
    backLayerOuter: "bg-[#D9A41D]",
    backLayerInner: "bg-[#680000]",
    card: "bg-white border-[1.5px] border-[#780000] shadow-[0_24px_45px_-12px_rgba(120,0,0,0.16)]",
    pill: "bg-[#D9A41D] text-[#1C1917]",
    halo: "bg-[#D9A41D]/20",
    dot: "bg-[#D9A41D]",
    value: "text-[#780000] [text-shadow:0_6px_14px_rgba(120,0,0,0.18)]",
    divider: "bg-neutral-200/90",
    title: "text-neutral-950",
    description: "text-neutral-500",
  },
  featured: {
    backLayerOuter: "bg-[#2E0000]",
    backLayerInner: "bg-[#F2C200]",
    card: "bg-gradient-to-br from-[#740000] via-[#560000] to-[#360000] border-[1.5px] border-[#FFE100] shadow-[0_24px_50px_-10px_rgba(120,0,0,0.28)]",
    pill: "bg-[#FFE600] text-[#3B0000]",
    halo: "bg-[#FFE600]/20",
    dot: "bg-[#FFE600]",
    value: "text-[#FFE600] [text-shadow:0_6px_16px_rgba(0,0,0,0.45)]",
    divider: "bg-white/15",
    title: "text-white",
    description: "text-white/75",
  },
} as const;
---

<section
  aria-labelledby="research-metrics-heading"
  class={`w-full max-w-6xl mx-auto px-6 sm:px-10 py-14 sm:py-16 ${className}`}
>
  <!-- Section Header -->
  <header class="flex items-stretch gap-3.5 sm:gap-4 mb-10 sm:mb-12">
    <span
      aria-hidden="true"
      class="w-[3.5px] shrink-0 rounded-full bg-[#780000]"
    ></span>
    <div class="flex flex-col justify-center">
      <p
        class="font-['Montserrat',sans-serif] text-[10.5px] sm:text-[11px] font-bold tracking-[0.14em] uppercase text-[#C89416] leading-tight"
      >
        {eyebrow}
      </p>
      <h2
        id="research-metrics-heading"
        class="mt-1 font-['Montserrat',sans-serif] text-[28px] sm:text-[34px] font-black tracking-[-0.02em] leading-[1.1] text-[#141414]"
      >
        {heading}
      </h2>
    </div>
  </header>

  <!-- 3-Column KPI Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-9 lg:gap-10 pl-2.5 pb-3">
    {
      metrics.map((metric) => {
        const styles = variantStyles[metric.variant];
        return (
          <article class="group relative">
            {/* Back-most offset plate */}
            <div
              aria-hidden="true"
              class={`absolute inset-0 -translate-x-[10px] translate-y-[12px] rounded-[20px] transition-transform duration-200 ease-out group-hover:-translate-x-[12px] group-hover:translate-y-[14px] ${styles.backLayerOuter}`}
            />

            {/* Middle offset plate */}
            <div
              aria-hidden="true"
              class={`absolute inset-0 -translate-x-[5px] translate-y-[6px] rounded-[20px] transition-transform duration-200 ease-out group-hover:-translate-x-[6px] group-hover:translate-y-[7px] ${styles.backLayerInner}`}
            />

            {/* Foreground KPI Card */}
            <div
              class={`relative z-10 flex h-full flex-col justify-between rounded-[20px] p-6 sm:p-7 transition-transform duration-200 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5 ${styles.card}`}
            >
              <div>
                {/* Top Tag + Halo Dot */}
                <div class="flex items-center justify-between gap-3">
                  <span
                    class={`inline-flex items-center rounded-full px-3.5 py-1.5 font-['Montserrat',sans-serif] text-[10px] font-extrabold tracking-[0.06em] uppercase leading-none whitespace-nowrap ${styles.pill}`}
                  >
                    {metric.tag}
                  </span>

                  <span
                    aria-hidden="true"
                    class={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${styles.halo}`}
                  >
                    <span class={`h-2.5 w-2.5 rounded-full ${styles.dot}`} />
                  </span>
                </div>

                {/* Bracketed Metric Value */}
                <p
                  class={`mt-5 sm:mt-6 font-['Montserrat',sans-serif] text-[46px] sm:text-[52px] font-black leading-none tracking-[-0.03em] tabular-nums ${styles.value}`}
                >
                  [{metric.value}]
                </p>
              </div>

              <div class="mt-6">
                <div class={`h-px w-full mb-4 ${styles.divider}`} />

                <h3
                  class={`font-['Montserrat',sans-serif] text-[13px] font-extrabold tracking-[0.04em] uppercase leading-snug ${styles.title}`}
                >
                  {metric.title}
                </h3>

                <p
                  class={`mt-1.5 text-[12px] leading-[1.5] ${styles.description}`}
                >
                  {metric.description}
                </p>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
