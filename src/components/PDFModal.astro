<dialog id="pdf-modal" class="pdf-modal" aria-labelledby="pdf-modal-title">
    <header class="modal-header">
        <h3 id="pdf-modal-title" class="modal-title">Document Preview</h3>

        <button
                type="button"
                id="pdf-close-btn"
                class="close-btn"
                aria-label="Close document preview"
        >
            ×
        </button>
    </header>

    <div id="pdf-viewer-container" class="pdf-viewer-container"></div>
</dialog>

<script>
    import {xorChunk} from "../lib/pdfConfig";

    const dialog = document.getElementById("pdf-modal") as HTMLDialogElement | null;
    const container = document.getElementById("pdf-viewer-container");
    const titleEl = document.getElementById("pdf-modal-title");
    const closeBtn = document.getElementById("pdf-close-btn");

    let activeController: AbortController | null = null;

    function base64ToBytes(b64: string): Uint8Array<ArrayBuffer> {
        const binary = atob(b64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) {
            bytes[i] = binary.charCodeAt(i);
        }
        return bytes;
    }

    function sleep(ms: number, signal?: AbortSignal): Promise<void> {
        return new Promise((resolve, reject) => {
            if (signal?.aborted) {
                reject(new DOMException("Aborted", "AbortError"));
                return;
            }
            const timer = setTimeout(resolve, ms);
            signal?.addEventListener(
                "abort",
                () => {
                    clearTimeout(timer);
                    reject(new DOMException("Aborted", "AbortError"));
                },
                {once: true}
            );
        });
    }

    async function fetchStitchedPdf(
        docRef: string,
        signal?: AbortSignal
    ): Promise<Uint8Array<ArrayBuffer>> {
        const manifestRes = await fetch(`/cache/${docRef}.json`, {signal});
        if (!manifestRes.ok) {
            throw new Error(`Failed to load document metadata (${manifestRes.status})`);
        }

        const {shards} = (await manifestRes.json()) as { shards: string[] };

        const queue = shards.map((id, part) => ({id, part}));
        for (let i = queue.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [queue[i], queue[j]] = [queue[j], queue[i]];
        }

        const orderedChunks = new Array<Uint8Array<ArrayBuffer>>(shards.length);

        await Promise.all(
            queue.map(async ({id, part}) => {
                await sleep(Math.random() * 45, signal);

                const res = await fetch(`/cache/${id}.json`, {signal});
                if (!res.ok) {
                    throw new Error(`Failed to load shard (${res.status})`);
                }

                const {payload} = (await res.json()) as { payload: string };
                orderedChunks[part] = xorChunk(base64ToBytes(payload), part);
            })
        );

        const totalBytes = orderedChunks.reduce(
            (sum, chunk) => sum + chunk.byteLength,
            0
        );
        const merged = new Uint8Array(totalBytes);

        let offset = 0;
        for (const chunk of orderedChunks) {
            merged.set(chunk, offset);
            offset += chunk.byteLength;
        }

        return merged;
    }

    document.addEventListener("click", async (event) => {
        const trigger = (event.target as HTMLElement)?.closest<HTMLElement>(
            "[data-doc-ref]"
        );
        if (!trigger || !dialog || !container) return;

        const docRef = trigger.dataset.docRef;
        if (!docRef) return;

        event.preventDefault();

        activeController?.abort();
        activeController = new AbortController();
        const {signal} = activeController;

        if (titleEl) {
            titleEl.textContent = trigger.dataset.pdfTitle || "Document Preview";
        }

        container.innerHTML = "";
        dialog.showModal();

        try {
            const [{default: EmbedPDF}, merged] = await Promise.all([
                import("@embedpdf/viewer"),
                fetchStitchedPdf(docRef, signal),
            ]);

            if (!dialog.open || signal.aborted) return;

            EmbedPDF.init({
                target: container,
                src: merged,
                theme: {accent: "#800000"},
                features: {
                    "documents.download": false,
                    "documents.print": false,
                },
                readOnly: true,
            });
        } catch (err) {
            if ((err as Error)?.name === "AbortError") return;
            console.error(err);
            container.innerHTML = `<p class="pdf-error">Unable to load document preview.</p>`;
        }
    });

    closeBtn?.addEventListener("click", () => dialog?.close());

    dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
    });

    dialog?.addEventListener("close", () => {
        activeController?.abort();
        if (container) container.innerHTML = "";
    });
</script>

<style>
    .pdf-modal {
        position: fixed;
        inset: 0;
        margin: auto;
        width: min(94vw, 1050px);
        height: 88vh;
        padding: 0;
        border: 1.5px solid var(--color-maroon);
        border-radius: 1.25rem;
        background-color: var(--color-white);
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    .pdf-modal[open] {
        display: flex;
        flex-direction: column;
    }

    .pdf-modal::backdrop {
        background: rgba(26, 20, 20, 0.65);
        backdrop-filter: blur(4px);
    }

    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 1.5rem;
        background-color: var(--color-maroon);
        color: var(--color-white);
    }

    .modal-title {
        margin: 0;
        font-family: var(--font-montserrat), system-ui, sans-serif;
        font-weight: 800;
        font-size: clamp(1rem, 1.6vw, 1.25rem);
        color: var(--color-white);
    }

    .close-btn {
        width: 2rem;
        height: 2rem;
        flex-shrink: 0;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.35);
        background: transparent;
        color: var(--color-white);
        font-size: 1.35rem;
        line-height: 1;
        display: grid;
        place-items: center;
        cursor: pointer;
    }

    .close-btn:hover {
        background-color: rgba(255, 255, 255, 0.15);
    }

    .pdf-viewer-container {
        flex: 1;
        width: 100%;
        min-height: 0;
        display: grid;
    }

    .pdf-viewer-container :global(.pdf-error) {
        place-self: center;
        color: var(--color-maroon);
        font-weight: 600;
    }
</style>