---
export interface Props {
  code?: string;
  department?: string;
  tag?: string;
  href?: string;
  class?: string;
}

const {
  code = "CS",
  department = "Department of Computer Science",
  tag = "[Research]",
  href = "#top",
  class: className = "",
} = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-3 rounded-full border border-neutral-200 bg-white pl-1.5 pr-4 py-1.5 shadow-[0_8px_24px_-6px_rgba(0,0,0,0.28)] hover:border-[#780000]/40 transition-colors duration-150 whitespace-nowrap ${className}`}
>
  <span
    class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-[#780000] font-['Montserrat',sans-serif] text-[10px] font-black text-white"
  >
    {code}
  </span>
  <span class="text-[12px] font-semibold text-neutral-900">
    {department}
  </span>
  {
    tag && (
      <span class="font-['Montserrat',sans-serif] text-[11px] font-extrabold text-[#780000]">
        {tag}
      </span>
    )
  }
</a>
