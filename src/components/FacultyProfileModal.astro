---
import { X } from "lucide-react";

export interface Props {
  modalId?: string;
  headerTitle?: string;
  defaultName?: string;
  defaultArea?: string;
  defaultStatus?: string;
  defaultFolder?: string;
  defaultImage?: string;
}

const {
  modalId = "faculty-profile-modal",
  headerTitle = "FACULTY PROFILE",
  defaultName = "Ria A. Sagum",
  defaultArea = "NLP",
  defaultStatus = "Involved in Research",
  defaultFolder = "sagum-research.folder",
  defaultImage = "/src/assets/images/faculty_maria_santos_1795256249826.jpg",
} = Astro.props;
---

<dialog
  id={modalId}
  aria-labelledby={`${modalId}-name`}
  class="m-auto w-[min(94vw,680px)] rounded-2xl border-[1.5px] border-[#780000] bg-white p-0 shadow-[0_28px_60px_-15px_rgba(60,0,0,0.4)] backdrop:bg-black/55 backdrop:backdrop-blur-[2px] overflow-hidden"
>
  <!-- Maroon Dialog Header -->
  <div
    class="flex items-center justify-between bg-[#780000] px-5 py-3 text-white"
  >
    <span
      class="font-['Montserrat',sans-serif] text-[11px] font-extrabold tracking-[0.12em] uppercase"
    >
      {headerTitle}
    </span>
    <button
      type="button"
      data-modal-close
      aria-label="Close faculty profile"
      class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white/85 hover:bg-white/15 hover:text-white transition-colors cursor-pointer"
    >
      <X className="h-4 w-4" aria-hidden="true" />
    </button>
  </div>

  <!-- Dialog Body -->
  <div class="p-6 space-y-5 max-h-[82vh] overflow-y-auto">
    <div class="grid grid-cols-1 sm:grid-cols-[140px_1fr] gap-5 items-center">
      <div
        class="aspect-[4/4.6] w-full max-w-[155px] mx-auto overflow-hidden rounded-xl border border-neutral-200 bg-[#360000] shadow-sm flex items-center justify-center"
      >
        <img
          data-modal-image
          src={defaultImage}
          alt={`Portrait of ${defaultName}`}
          referrerpolicy="no-referrer"
          class="h-full w-full object-cover object-top"
        />
        <span
          data-modal-initials
          class="hidden font-['Montserrat',sans-serif] text-[28px] font-black text-[#FFE600]"
        ></span>
      </div>

      <div class="space-y-3">
        <h3
          id={`${modalId}-name`}
          data-modal-name
          class="font-['Montserrat',sans-serif] text-[22px] font-black tracking-tight text-neutral-950 leading-tight"
        >
          {defaultName}
        </h3>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <div>
            <dt
              class="font-['Montserrat',sans-serif] text-[9.5px] font-extrabold tracking-[0.1em] uppercase text-[#780000]"
            >
              RESEARCH AREA
            </dt>
            <dd data-modal-area class="mt-0.5 text-[12.5px] font-medium text-neutral-700">
              {defaultArea}
            </dd>
          </div>

          <div>
            <dt
              class="font-['Montserrat',sans-serif] text-[9.5px] font-extrabold tracking-[0.1em] uppercase text-[#780000]"
            >
              RESEARCH STATUS
            </dt>
            <dd data-modal-status class="mt-0.5 text-[12.5px] font-medium text-neutral-700">
              {defaultStatus}
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Refereed Publications Section -->
    <div class="border-t border-neutral-200 pt-4">
      <div class="flex items-center justify-between gap-3 mb-3">
        <h4 class="font-['Montserrat',sans-serif] text-[10.5px] font-extrabold tracking-[0.1em] uppercase text-[#780000]">
          REFEREED PUBLICATIONS
        </h4>
        <span
          data-modal-pub-count
          class="rounded-full bg-[#F3E8E8] px-2.5 py-0.5 font-['Montserrat',sans-serif] text-[10px] font-bold text-[#780000]"
        >
          0 publications
        </span>
      </div>

      <div data-modal-publications class="space-y-3"></div>
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ modalId }}>
  (() => {
    const dialog = document.getElementById(modalId);
    if (!dialog) return;

    const imgEl = dialog.querySelector("[data-modal-image]");
    const initialsEl = dialog.querySelector("[data-modal-initials]");
    const nameEl = dialog.querySelector("[data-modal-name]");
    const areaEl = dialog.querySelector("[data-modal-area]");
    const statusEl = dialog.querySelector("[data-modal-status]");
    const pubListEl = dialog.querySelector("[data-modal-publications]");
    const pubCountEl = dialog.querySelector("[data-modal-pub-count]");

    const makeRow = (label, value) => {
      const p = document.createElement("p");
      p.className = "text-[11.5px] leading-[1.45] text-neutral-600";
      const strong = document.createElement("span");
      strong.className = "font-semibold text-neutral-900";
      strong.textContent = `${label}: `;
      p.appendChild(strong);
      p.appendChild(document.createTextNode(value));
      return p;
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest(`[data-faculty-open="${modalId}"]`);
      if (trigger) {
        const name = trigger.getAttribute("data-faculty-name") || "";
        const area = trigger.getAttribute("data-faculty-area") || "";
        const status = trigger.getAttribute("data-faculty-status") || "Involved in Research";
        const image = trigger.getAttribute("data-faculty-image") || "";
        let publications = [];
        try {
          publications = JSON.parse(trigger.getAttribute("data-faculty-publications") || "[]");
        } catch {
          publications = [];
        }

        if (nameEl) nameEl.textContent = name;
        if (areaEl) areaEl.textContent = area;
        if (statusEl) {
          statusEl.textContent =
            status.toUpperCase() === status ? "Involved in Research" : status;
        }

        if (imgEl && initialsEl) {
          if (image) {
            imgEl.setAttribute("src", image);
            imgEl.setAttribute("alt", `Portrait of ${name}`);
            imgEl.classList.remove("hidden");
            initialsEl.classList.add("hidden");
          } else {
            imgEl.classList.add("hidden");
            initialsEl.textContent = name
              .split(/\s+/)
              .filter(Boolean)
              .slice(0, 2)
              .map((part) => (part[0] || "").toUpperCase())
              .join("");
            initialsEl.classList.remove("hidden");
          }
        }

        if (pubCountEl) {
          pubCountEl.textContent = `${publications.length} ${publications.length === 1 ? "publication" : "publications"}`;
        }

        if (pubListEl) {
          pubListEl.innerHTML = "";
          publications.forEach((pub) => {
            const card = document.createElement("article");
            card.className = "rounded-xl border border-neutral-200 bg-neutral-50/75 p-3.5 space-y-1";
            card.appendChild(makeRow("Author(s)", pub.authors || ""));
            card.appendChild(makeRow("Title of Research", pub.title || ""));
            card.appendChild(makeRow("Refereed Journal", pub.journal || ""));
            card.appendChild(makeRow("Date Published", pub.datePublished || ""));
            pubListEl.appendChild(card);
          });
        }

        if (typeof dialog.showModal === "function") {
          dialog.showModal();
        }
        return;
      }

      if (target.closest("[data-modal-close]") || target === dialog) {
        if (typeof dialog.close === "function") {
          dialog.close();
        }
      }
    });
  })();
</script>
