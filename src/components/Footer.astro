---
const portfolioLinks = [
  { label: "Compliance Report", href: "/compliance" },
  { label: "Narrative Report", href: "/narrative-report" },
  { label: "Curriculum", href: "/curriculum" },
  { label: "Faculty Directory", href: "/faculty" },
];

const pillarLinks = [
  { label: "Research", href: "/research" },
  { label: "Teaching & Learning", href: "/teaching-and-learning" },
  { label: "Community", href: "/community" },
  { label: "Internationalization", href: "/internationalization" },
  { label: "Planning & QA", href: "/planning-and-qa" },
];
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <h3 class="footer-heading">PUP Department of Computer Science</h3>
      <p class="footer-subtext">College of Computer and Information Sciences</p>
      <p class="footer-subtext">Polytechnic University of the Phillippines</p>
    </div>

    <div class="footer-column">
      <h4 class="footer-heading">Portfolio</h4>
      <ul class="footer-list">
        {portfolioLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-column">
      <h4 class="footer-heading">Pillars</h4>
      <ul class="footer-list">
        {pillarLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(
      to bottom,
      var(--color-maroon),
      var(--color-dark-maroon)
    );
    color: var(--color-white);
    font-family: var(--font-inter), system-ui, sans-serif;
    padding: 3.5rem 2rem;
    scroll-snap-align: end;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .footer-heading {
    color: var(--color-gold);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
  }

  .footer-subtext {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 0.35rem 0;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-gold);
  }

  @media (max-width: 768px) {
    .footer {
      padding: 2.5rem 1.5rem;
    }

    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
