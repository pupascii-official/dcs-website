---
export type BadgeVariant =
  | "research-pillar"
  | "faculty-dev"
  | "academic-rigor"
  | "core-domains"
  | "indexation-support"
  | "evaluation-rubric"
  | "ethics-protocol"
  | "active-repository"
  | "faculty-guidance";

export interface Props {
  label: string;
  variant?: BadgeVariant;
  class?: string;
}

const { label, variant = "research-pillar", class: className = "" } = Astro.props;

const variantClasses: Record<BadgeVariant, string> = {
  "research-pillar":
    "bg-[#780000]/90 border border-[#D9A41D]/70 text-[#FFD94A] px-4 py-1.5",
  "faculty-dev":
    "bg-[#FDE68A]/75 border border-[#D9A41D]/45 text-[#680000] px-3 py-1",
  "academic-rigor":
    "bg-neutral-200/85 border border-neutral-300/70 text-neutral-700 px-3 py-1",
  "core-domains":
    "bg-[#E5B82E] border border-[#C89416]/50 text-[#1C1917] px-3 py-1",
  "indexation-support":
    "bg-[#780000] border border-[#780000] text-[#FFD94A] px-3 py-1",
  "evaluation-rubric":
    "bg-[#FDE68A] border border-[#D9A41D]/40 text-[#5C0000] px-3 py-1",
  "ethics-protocol":
    "bg-[#E5B82E] border border-[#C89416]/40 text-[#1C1917] px-3 py-1",
  "active-repository":
    "bg-[#FFE600] border border-[#FFE600] text-[#3B0000] px-3 py-1",
  "faculty-guidance":
    "bg-[#E5B82E]/90 border border-[#C89416]/60 text-[#3B0000] px-4 py-1.5",
};
---

<span
  class={`inline-flex items-center rounded-full font-['Montserrat',sans-serif] text-[10px] font-extrabold tracking-[0.07em] uppercase leading-none whitespace-nowrap ${variantClasses[variant]} ${className}`}
>
  {label}
</span>
