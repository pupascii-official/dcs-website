---
export type BadgeVariant =
  | "research-pillar"
  | "faculty-dev"
  | "academic-rigor"
  | "core-domains"
  | "indexation-support"
  | "evaluation-rubric"
  | "ethics-protocol"
  | "active-repository"
  | "faculty-guidance";

export interface Props {
  label: string;
  variant?: BadgeVariant;
  class?: string;
}

const { label, variant = "research-pillar", class: className = "" } = Astro.props;

const variantClasses: Record<BadgeVariant, string> = {
  "research-pillar":
    "bg-[#780000]/90 border border-[#D9A41D]/70 text-[#FFD94A] px-4 py-1.5",
  "faculty-dev":
    "badge-faculty-dev border border-[#D4A017]/55 text-[#800000] px-3.5 py-1",
  "academic-rigor":
    "bg-[#F3E6E6] border border-[#800000]/10 text-[#800000] px-3.5 py-1",
  "core-domains":
    "bg-[#FFE97A] border border-[#E5B82E]/40 text-[#800000] px-3.5 py-1",
  "indexation-support":
    "bg-[#780000] border border-[#780000] text-[#FFD94A] px-3 py-1",
  "evaluation-rubric":
    "bg-[#FDE68A] border border-[#D9A41D]/40 text-[#5C0000] px-3 py-1",
  "ethics-protocol":
    "bg-[#E5B82E] border border-[#C89416]/40 text-[#1C1917] px-3 py-1",
  "active-repository":
    "bg-[#FFE600] border border-[#FFE600] text-[#3B0000] px-3 py-1",
  "faculty-guidance":
    "badge-faculty-guidance border border-[#D9A41D]/45 text-[#800000] px-4 py-1.5",
};
---

<span
  class={`inline-flex items-center rounded-full font-['Montserrat',sans-serif] text-[10px] font-extrabold tracking-[0.07em] uppercase leading-none whitespace-nowrap ${variantClasses[variant]} ${className}`}
>
  {label}
</span>

<style>
  .badge-faculty-dev {
    background-image: linear-gradient(90deg, #f9ecc3 0%, #f4e1a2 100%);
  }

  .badge-faculty-guidance {
    background-image: linear-gradient(90deg, #fdf3ca 0%, #fae89e 100%);
  }
</style>
