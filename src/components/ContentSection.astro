---
interface Props {
  sectionLabel: string;
  category: string;
  description?: string;
}

const { sectionLabel, category, description } = Astro.props;
---

<section class="scroll-section content-section">
  <div class="section-inner">
    <header class="section-header">
      <div class="header-top">
        <small>{sectionLabel}</small>
        <h2 class="category">{category}</h2>
      </div>
      {description && <p class="description">{description}</p>}
    </header>

    <div class="section-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .content-section {
    background-color: var(--color-bg-canvas);
    padding: 3rem 2rem;
  }

  .category {
    margin-bottom: 1.5rem;
  }

  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .header-top {
    border-left: 3px solid var(--color-maroon);
    padding-left: 1rem;
  }
</style>
