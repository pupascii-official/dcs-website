---
import { internationalData } from "../../data/internationalization/content";

const { qsStars, edurank, theImpact, aunQa, wuri } = internationalData.section2;
---

<div class="rankings-root w-full border-t border-(--color-maroon)/50 pt-5 space-y-6" data-rankings-section>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-0 pb-6 border-b border-(--color-maroon)/50">
    <div class="flex flex-col justify-between md:pr-8">
      <div class="flex items-center justify-between gap-4 mb-3">
        <h3 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-(--color-maroon) tracking-tight">
          {qsStars.title}
        </h3>
        {qsStars.logoPath && (
          <img
            src={qsStars.logoPath}
            alt="QS Stars"
            class="ranking-logo ranking-logo-qs shrink-0"
            loading="lazy"
          />
        )}
      </div>

      <div class="grid grid-cols-2">
        {qsStars.ratings.map((rating, idx) => (
          <div class={`flex flex-col ${idx === 0 ? "pr-4 border-r border-(--color-maroon)/40" : "pl-4 sm:pl-6"}`}>
            <span class="text-xs font-bold text-(--color-maroon) mb-1">{rating.year}</span>
            <div class="flex items-baseline gap-1.5 mb-2">
              <span class="rank-gradient-num bg-gradient-to-b from-[#D99B00] via-[#A64B00] to-[#800000] bg-clip-text text-transparent font-['Montserrat',sans-serif] text-6xl md:text-7xl font-extrabold leading-none">
                {rating.stars}
              </span>
              <span class="font-['Montserrat',sans-serif] text-xl sm:text-2xl font-extrabold text-(--color-maroon)">
                Stars
              </span>
            </div>
            <div class="flex items-center gap-1 mb-2" aria-label={`${rating.stars} out of 5 stars`}>
              {[...Array(5)].map((_, i) => (
                <svg
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill={i < rating.stars ? "#FFDE00" : "none"}
                  stroke={i < rating.stars ? "#E5B800" : "#D99B00"}
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
                  />
                </svg>
              ))}
            </div>
            <p class="text-xs text-neutral-700 font-semibold">{rating.label}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col justify-between border-t md:border-t-0 md:border-l border-(--color-maroon)/50 pt-5 md:pt-0 md:pl-8">
      <div class="flex items-center justify-between gap-4 mb-3">
        <div>
          <h3 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-(--color-maroon) tracking-tight">
            {edurank.title}
          </h3>
          <p class="text-xs font-bold text-(--color-maroon) mt-0.5">{edurank.subtitle}</p>
        </div>
        {edurank.logoPath && (
          <img
            src={edurank.logoPath}
            alt="EduRank Logo"
            class="ranking-logo-edurank shrink-0 shadow-2xs"
            loading="lazy"
          />
        )}
      </div>

      <div class="grid grid-cols-12 items-end">
        <div class="col-span-5 pr-3 border-r border-(--color-maroon)/40">
          <div class="flex items-baseline whitespace-nowrap">
            <span class="rank-gradient-num bg-gradient-to-b from-[#D99B00] via-[#A64B00] to-[#800000] bg-clip-text text-transparent font-['Montserrat',sans-serif] text-6xl md:text-7xl font-extrabold leading-none tracking-tight">
              15
            </span>
            <span class="font-['Montserrat',sans-serif] text-xl sm:text-2xl font-extrabold text-(--color-maroon)">
              th
            </span>
          </div>
          <p class="text-xs sm:text-sm text-neutral-800 font-semibold mt-1.5">{edurank.phContext}</p>
        </div>
        <div class="col-span-7 pl-4 sm:pl-5">
          <div class="flex items-baseline whitespace-nowrap">
            <span class="rank-gradient-num bg-gradient-to-b from-[#D99B00] via-[#A64B00] to-[#800000] bg-clip-text text-transparent font-['Montserrat',sans-serif] text-6xl md:text-7xl font-extrabold leading-none tracking-tight">
              4976
            </span>
            <span class="font-['Montserrat',sans-serif] text-xl sm:text-2xl font-extrabold text-(--color-maroon)">
              th
            </span>
          </div>
          <p class="text-xs sm:text-sm text-neutral-800 font-semibold mt-1.5">{edurank.worldContext}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-0 pb-6 border-b border-(--color-maroon)/50">
    <div class="md:col-span-7 flex flex-col justify-between md:pr-8">
      <div class="flex items-center justify-between gap-4 mb-2">
        <div>
          <h3 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-(--color-maroon) tracking-tight">
            {theImpact.title}
          </h3>
          <p class="text-xs font-bold text-(--color-maroon) mt-0.5">{theImpact.subtitle}</p>
        </div>
        {theImpact.logoPath && (
          <img
            src={theImpact.logoPath}
            alt="THE Impact Ranking"
            class="ranking-logo ranking-logo-the max-h-20 w-auto object-contain shrink-0"
            loading="lazy"
          />
        )}
      </div>
      <div class="flex flex-wrap items-baseline gap-2 mt-2">
        <span class="rank-gradient-num bg-gradient-to-b from-[#D99B00] via-[#A64B00] to-[#800000] bg-clip-text text-transparent font-['Montserrat',sans-serif] text-6xl md:text-7xl font-extrabold leading-none tracking-tight">
          {theImpact.rank}
        </span>
        <span class="font-['Montserrat',sans-serif] text-lg sm:text-xl font-extrabold text-(--color-maroon)">
          {theImpact.context}
        </span>
      </div>
      <p class="text-xs font-semibold text-neutral-700 mt-1.5">{theImpact.note}</p>
    </div>

    <div class="md:col-span-5 flex flex-col justify-center border-t md:border-t-0 md:border-l border-(--color-maroon)/50 pt-5 md:pt-0 md:pl-8">
      <div class="flex items-center justify-between gap-4 mb-1.5">
        <div>
          <h3 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-(--color-maroon) tracking-tight">
            {aunQa.title}
          </h3>
          <span class="text-xs font-bold text-(--color-maroon) block mt-0.5">
            {aunQa.subtitle}
          </span>
        </div>
        {aunQa.logoPath && (
          <img
            src={aunQa.logoPath}
            alt="AUN-QA Logo"
            class="ranking-logo ranking-logo-aun shrink-0"
            loading="lazy"
          />
        )}
      </div>
      <p class="text-xs sm:text-sm text-neutral-700 leading-relaxed mt-1">{aunQa.description}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-5 flex flex-col">
      <div class="mb-2">
        <h3 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-(--color-maroon) tracking-tight">
          {wuri.title}
        </h3>
        <p class="text-xs font-bold text-(--color-maroon) mt-0.5">{wuri.subtitle}</p>
      </div>

      <div class="flex items-baseline mt-1">
        <span class="rank-gradient-num bg-gradient-to-b from-[#D99B00] via-[#A64B00] to-[#800000] bg-clip-text text-transparent font-['Montserrat',sans-serif] text-6xl md:text-7xl font-extrabold leading-none tracking-tight">
          {wuri.rank.replace("th", "")}
        </span>
        <span class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold text-(--color-maroon)">
          th
        </span>
      </div>
      <p class="text-xs font-semibold text-neutral-700 mt-1.5 mb-3">{wuri.previousRank}</p>
      <div class="text-xs text-neutral-700 leading-relaxed space-y-2.5">
        {wuri.narrative.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <div class="lg:col-span-7 flex flex-col space-y-6">
      {wuri.years.map((y, idx) => (
        <div class="flex flex-col">
          <div class="flex items-end justify-between pb-1.5 border-b border-(--color-maroon)/50 mb-4">
            <span class="font-['Montserrat',sans-serif] text-xs font-extrabold text-(--color-maroon) tracking-wide">
              {y.year}
            </span>
            {idx === 0 && wuri.logoPath && (
              <img
                src={wuri.logoPath}
                alt="WURI Logo"
                class="ranking-logo ranking-logo-wuri max-h-20 w-auto object-contain shrink-0"
                loading="lazy"
              />
            )}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            {y.ranks.map((item) => (
              <div class="flex flex-col">
                <div class="flex items-baseline whitespace-nowrap">
                  <span class="rank-gradient-num bg-gradient-to-b from-[#D99B00] via-[#A64B00] to-[#800000] bg-clip-text text-transparent font-['Montserrat',sans-serif] text-6xl md:text-7xl font-extrabold leading-none tracking-tight">
                    {item.rank.replace(/(st|nd|rd|th)/, "")}
                  </span>
                  <span class="font-['Montserrat',sans-serif] text-xl sm:text-2xl font-extrabold text-(--color-maroon)">
                    {item.rank.match(/(st|nd|rd|th)/)?.[0]}
                  </span>
                </div>
                <p class="text-xs font-bold text-(--color-maroon) mt-1.5 leading-snug">
                  {item.label}
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .rankings-root p {
    margin-bottom: 0;
  }

  .rank-gradient-num {
    background-image: linear-gradient(to bottom, #d99b00, #a64b00, #800000);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }

  .ranking-logo {
    width: auto;
    object-fit: contain;
    border-radius: 0;
  }

  .ranking-logo-qs {
    height: 3.25rem;
    max-height: 3.25rem;
  }

  .ranking-logo-edurank {
    height: 3.25rem;
    width: 3.25rem;
    object-fit: contain;
    border-radius: 9999px;
  }

  .ranking-logo-the {
    height: 3rem;
    max-height: 5rem;
    max-width: 11rem;
  }

  .ranking-logo-aun {
    height: 3rem;
    max-height: 3.5rem;
    max-width: 10rem;
  }

  .ranking-logo-wuri {
    height: 3.5rem;
    max-height: 5rem;
    max-width: 11rem;
  }
</style>
