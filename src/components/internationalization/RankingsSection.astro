---
import { internationalData } from "../../data/internationalization/content";

const { qsStars, edurank, theImpact, aunQa, wuri } = internationalData.section2;

const splitRank = (rank: string) => {
  const match = rank.match(/^(\d+)(st|nd|rd|th)$/);
  return match ? { num: match[1], suffix: match[2] } : { num: rank, suffix: "" };
};

const edurankMetrics = [
  {
    ...splitRank(edurank.phRank),
    label: edurank.phContext,
    colClass: "sm:col-span-5 pb-4 sm:pb-0 sm:pr-3 border-b sm:border-b-0 sm:border-r border-(--color-maroon)/40"
  },
  {
    ...splitRank(edurank.worldRank),
    label: edurank.worldContext,
    colClass: "sm:col-span-7 pt-4 sm:pt-0 sm:pl-4 md:pl-5"
  }
];

const wuriMain = splitRank(wuri.rank);
const gradNumClass = "rank-gradient-num font-['Montserrat',sans-serif] text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-none tracking-tight";
const cardTitleClass = "font-['Montserrat',sans-serif] text-xl sm:text-3xl font-extrabold text-(--color-maroon) tracking-tight";
---

<div class="rankings-root w-full border-t border-(--color-maroon)/50 pt-5 space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-0 pb-6 border-b border-(--color-maroon)/50">
    <div class="flex flex-col justify-between md:pr-8 min-w-0">
      <div class="flex items-center justify-between gap-3 mb-3">
        <h3 class={cardTitleClass}>{qsStars.title}</h3>
        <img src={qsStars.logoPath} alt="QS Stars" class="ranking-logo ranking-logo-qs shrink-0" loading="lazy" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2">
        {qsStars.ratings.map((rating, idx) => (
          <div
            class={`flex flex-col ${
              idx === 0
                ? "pb-4 sm:pb-0 sm:pr-4 border-b sm:border-b-0 sm:border-r border-(--color-maroon)/40"
                : "pt-4 sm:pt-0 sm:pl-4 md:pl-6"
            }`}
          >
            <span class="text-xs font-bold text-(--color-maroon) mb-1">{rating.year}</span>
            <div class="flex items-baseline gap-1.5 mb-2">
              <span class={gradNumClass}>{rating.stars}</span>
              <span class="font-['Montserrat',sans-serif] text-lg sm:text-2xl font-extrabold text-(--color-maroon)">
                Stars
              </span>
            </div>
            <div class="flex items-center gap-1 mb-2" aria-label={`${rating.stars} out of 5 stars`}>
              {[...Array(5)].map((_, i) => (
                <svg
                  class="w-6 h-6 shrink-0"
                  viewBox="0 0 24 24"
                  fill={i < rating.stars ? "#FFDE00" : "none"}
                  stroke={i < rating.stars ? "#E5B800" : "#D99B00"}
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
                  />
                </svg>
              ))}
            </div>
            <p class="text-xs text-neutral-700 font-semibold">{rating.label}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col justify-between border-t md:border-t-0 md:border-l border-(--color-maroon)/50 pt-5 md:pt-0 md:pl-8 min-w-0">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div class="min-w-0">
          <h3 class={cardTitleClass}>{edurank.title}</h3>
          <p class="text-xs font-bold text-(--color-maroon) mt-0.5">{edurank.subtitle}</p>
        </div>
        <img src={edurank.logoPath} alt="EduRank Logo" class="ranking-logo-edurank shrink-0 shadow-2xs" loading="lazy" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-12 items-end">
        {edurankMetrics.map((m) => (
          <div class={`${m.colClass} min-w-0`}>
            <div class="flex items-baseline whitespace-nowrap">
              <span class={gradNumClass}>{m.num}</span>
              <span class="font-['Montserrat',sans-serif] text-lg sm:text-2xl font-extrabold text-(--color-maroon)">
                {m.suffix}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-800 font-semibold mt-1.5">{m.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-0 pb-6 border-b border-(--color-maroon)/50">
    <div class="md:col-span-7 flex flex-col justify-between md:pr-8 min-w-0">
      <div class="flex items-center justify-between gap-3 mb-2">
        <div class="min-w-0">
          <h3 class={cardTitleClass}>{theImpact.title}</h3>
          <p class="text-xs font-bold text-(--color-maroon) mt-0.5">{theImpact.subtitle}</p>
        </div>
        <img src={theImpact.logoPath} alt="THE Impact Ranking" class="ranking-logo ranking-logo-the shrink-0" loading="lazy" />
      </div>
      <div class="flex flex-wrap items-baseline gap-2 mt-2">
        <span class={gradNumClass}>{theImpact.rank}</span>
        <span class="font-['Montserrat',sans-serif] text-base sm:text-xl font-extrabold text-(--color-maroon)">
          {theImpact.context}
        </span>
      </div>
      <p class="text-xs font-semibold text-neutral-700 mt-1.5">{theImpact.note}</p>
    </div>

    <div class="md:col-span-5 flex flex-col justify-center border-t md:border-t-0 md:border-l border-(--color-maroon)/50 pt-5 md:pt-0 md:pl-8 min-w-0">
      <div class="flex items-center justify-between gap-3 mb-1.5">
        <div class="min-w-0">
          <h3 class={cardTitleClass}>{aunQa.title}</h3>
          <span class="text-xs font-bold text-(--color-maroon) block mt-0.5">{aunQa.subtitle}</span>
        </div>
        <img src={aunQa.logoPath} alt="AUN-QA Logo" class="ranking-logo ranking-logo-aun shrink-0" loading="lazy" />
      </div>
      <p class="text-xs sm:text-sm text-neutral-700 leading-relaxed mt-1">{aunQa.description}</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-5 flex flex-col min-w-0">
      <div class="mb-2">
        <h3 class={cardTitleClass}>{wuri.title}</h3>
        <p class="text-xs font-bold text-(--color-maroon) mt-0.5">{wuri.subtitle}</p>
      </div>

      <div class="flex items-baseline mt-1">
        <span class={gradNumClass}>{wuriMain.num}</span>
        <span class="font-['Montserrat',sans-serif] text-xl sm:text-3xl font-extrabold text-(--color-maroon)">
          {wuriMain.suffix}
        </span>
      </div>
      <p class="text-xs font-semibold text-neutral-700 mt-1.5 mb-3">{wuri.previousRank}</p>
      <div class="text-xs text-neutral-700 leading-relaxed space-y-2.5">
        {wuri.narrative.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <div class="lg:col-span-7 flex flex-col space-y-6 min-w-0">
      {wuri.years.map((y, idx) => (
        <div class="flex flex-col">
          <div class="flex items-end justify-between gap-3 pb-1.5 border-b border-(--color-maroon)/50 mb-4">
            <span class="font-['Montserrat',sans-serif] text-xs font-extrabold text-(--color-maroon) tracking-wide">
              {y.year}
            </span>
            {idx === 0 && (
              <img src={wuri.logoPath} alt="WURI Logo" class="ranking-logo ranking-logo-wuri shrink-0" loading="lazy" />
            )}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            {y.ranks.map((item) => {
              const parsed = splitRank(item.rank);
              return (
                <div class="flex flex-col min-w-0">
                  <div class="flex items-baseline whitespace-nowrap">
                    <span class={gradNumClass}>{parsed.num}</span>
                    <span class="font-['Montserrat',sans-serif] text-lg sm:text-2xl font-extrabold text-(--color-maroon)">
                      {parsed.suffix}
                    </span>
                  </div>
                  <p class="text-xs font-bold text-(--color-maroon) mt-1.5 leading-snug">{item.label}</p>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .rankings-root p {
    margin-bottom: 0;
  }

  .rank-gradient-num {
    background-image: linear-gradient(to bottom, #d99b00, #a64b00, #800000);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }

  .ranking-logo {
    width: auto;
    object-fit: contain;
    border-radius: 0;
  }

  .ranking-logo-qs {
    height: 2.75rem;
    max-height: 3.25rem;
  }

  .ranking-logo-edurank {
    height: 2.75rem;
    width: 2.75rem;
    object-fit: contain;
    border-radius: 9999px;
  }

  .ranking-logo-the {
    height: 2.5rem;
    max-height: 5rem;
    max-width: 8rem;
  }

  .ranking-logo-aun {
    height: 2.5rem;
    max-height: 3.5rem;
    max-width: 7.5rem;
  }

  .ranking-logo-wuri {
    height: 3rem;
    max-height: 5rem;
    max-width: 9rem;
  }

  @media (min-width: 640px) {
    .ranking-logo-qs {
      height: 3.25rem;
    }

    .ranking-logo-edurank {
      height: 3.25rem;
      width: 3.25rem;
    }

    .ranking-logo-the {
      height: 3rem;
      max-width: 11rem;
    }

    .ranking-logo-aun {
      height: 3rem;
      max-width: 10rem;
    }

    .ranking-logo-wuri {
      height: 3.5rem;
      max-width: 11rem;
    }
  }
</style>
