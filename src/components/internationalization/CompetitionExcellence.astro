---
import { internationalData } from "../../data/internationalization/content";
import SectionHeader from "./SectionHeader.astro";

const { label, title, items, cta } = internationalData.competitions;
---

<div class="competitions-root w-full space-y-6" data-competition-excellence>
  <SectionHeader label={label} title={title} marginClass="mb-0" />

  <div class="flex flex-col gap-6">
    {items.map((item) => (
      <div
        data-competition-card
        class="competition-banner relative rounded-2xl overflow-hidden shadow-lg hover:shadow-xl border border-(--color-maroon)/40 transition-all duration-300 cursor-pointer flex flex-col md:flex-row min-h-[260px] sm:min-h-[280px] group"
      >
        <div class="relative z-10 w-full md:w-[56%] p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <h3 class="competition-gold-text font-['Montserrat',sans-serif] text-2xl sm:text-3xl font-extrabold leading-tight mb-3">
              {item.headline}
            </h3>

            <ul class="space-y-1 text-xs sm:text-sm leading-snug mb-4">
              {item.members.map((m) => (
                <li class={m.highlight ? "text-(--color-gold)" : "text-white/95"}>
                  <strong class="font-bold">{m.name},</strong>{" "}
                  <span class={m.highlight ? "font-normal text-(--color-gold)/95" : "font-normal text-white/90"}>
                    {m.program}
                  </span>
                </li>
              ))}
            </ul>

            <p class="text-xs sm:text-sm font-bold text-white leading-snug">{item.programName}</p>
            <p class="text-[11px] sm:text-xs text-white/85 mt-0.5">{item.theme}</p>
          </div>

          <p class="competition-gold-text font-['Montserrat',sans-serif] text-3xl sm:text-4xl font-extrabold leading-none mt-5">
            {item.award}
          </p>
        </div>

        <div class="relative md:absolute md:inset-y-0 md:right-0 w-full md:w-[50%] h-64 md:h-full overflow-hidden">
          <img
            src={item.imagePath}
            alt={`${item.headline} ${item.award}`}
            class={`competition-banner-img ${item.id === "gold-medalist" ? "competition-focal-gold" : "competition-focal-finalists"} transition-transform duration-500 group-hover:scale-[1.03]`}
            loading="lazy"
          />
          <div class="md:hidden competition-mobile-fade absolute inset-0 pointer-events-none"></div>
        </div>

        <div class="hidden md:block competition-desktop-fade absolute inset-0 pointer-events-none z-[1]"></div>
      </div>
    ))}
  </div>

  <div class="flex justify-end pt-2">
    <a
      href={cta.href}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-(--color-gold) text-[#1A1414] font-['Montserrat',sans-serif] font-bold text-sm tracking-wide shadow-sm hover:bg-(--color-dark-gold) hover:text-white transition-colors duration-200"
    >
      {cta.label}
    </a>
  </div>
</div>

<style>
  .competitions-root p {
    margin-bottom: 0;
  }

  .competition-banner {
    background: linear-gradient(90deg, #5c0000 0%, #800000 60%, #6e0000 100%);
  }

  .competition-gold-text {
    color: var(--color-gold) !important;
  }

  .competition-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }

  .competition-focal-finalists {
    object-position: 50% 22%;
  }

  .competition-focal-gold {
    object-position: 50% 56%;
  }

  .competition-desktop-fade {
    background: linear-gradient(
      90deg,
      #5c0000 0%,
      #800000 44%,
      rgba(128, 0, 0, 0.94) 51%,
      rgba(128, 0, 0, 0.55) 62%,
      rgba(128, 0, 0, 0.14) 76%,
      transparent 90%
    );
  }

  .competition-mobile-fade {
    background: linear-gradient(
      to bottom,
      #800000 0%,
      rgba(128, 0, 0, 0.35) 30%,
      transparent 65%
    );
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-competition-excellence]").forEach((root) => {
      const cards = root.querySelectorAll("[data-competition-card]");
      cards.forEach((card) => {
        card.addEventListener("click", () => {
          const isSelected = card.classList.contains("ring-2");
          cards.forEach((c) => c.classList.remove("ring-2", "ring-[#FFDE00]", "-translate-y-0.5"));
          if (!isSelected) card.classList.add("ring-2", "ring-[#FFDE00]", "-translate-y-0.5");
        });
      });
    });
  })();
</script>
