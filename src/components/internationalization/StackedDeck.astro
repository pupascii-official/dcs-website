---
interface Props {
  desktopHeight?: string;
}

const { desktopHeight = "460px" } = Astro.props;
---

<div data-intl-reveal class="intl-deck" data-deck data-active="-1" style={`--deck-h: ${desktopHeight}; --reveal-delay: 80ms;`}>
  <slot />
</div>

<style>
  :global(.intl-deck) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  :global(.intl-deck-item) {
    position: relative;
    width: 100%;
  }

  :global(.intl-deck-expanded) {
    background-color: var(--color-dark-maroon);
    animation: deckExpandFade 320ms ease-out both;
  }

  @keyframes deckExpandFade {
    from {
      opacity: 0.4;
      transform: scale(0.985);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  :global(.intl-deck-title) {
    color: var(--color-gold) !important;
  }

  :global(.intl-deck-subheading) {
    color: var(--color-white) !important;
  }

  :global(.intl-deck-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
    display: block;
  }

  :global(.intl-deck-fade-desktop) {
    background: linear-gradient(
      90deg,
      var(--color-dark-maroon) 0%,
      var(--color-maroon) 40%,
      rgba(128, 0, 0, 0.94) 48%,
      rgba(128, 0, 0, 0.58) 60%,
      rgba(128, 0, 0, 0.16) 72%,
      transparent 84%
    );
  }

  :global(.intl-deck-fade-mobile) {
    background: linear-gradient(
      to top,
      var(--color-dark-maroon) 0%,
      rgba(66, 0, 0, 0.45) 45%,
      transparent 100%
    );
  }

  @media (min-width: 768px) {
    :global(.intl-deck) {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      height: var(--deck-h, 460px);
      padding: 0.25rem 0;
    }

    :global(.intl-deck-item) {
      flex: 0 0 auto;
      height: 100%;
      width: 32%;
      margin-left: 2%;
      z-index: 10;
      transform: scale(1);
      transition:
        width 500ms ease-out,
        margin-left 500ms ease-out,
        transform 500ms ease-out,
        filter 300ms ease-out;
    }

    :global(.intl-deck-item:first-child) {
      margin-left: 0;
    }

    :global(.intl-deck[data-active="0"] .intl-deck-item[data-index="0"]),
    :global(.intl-deck[data-active="1"] .intl-deck-item[data-index="1"]),
    :global(.intl-deck[data-active="2"] .intl-deck-item[data-index="2"]) {
      width: 75%;
      z-index: 30;
      transform: scale(1);
      filter: none;
    }

    :global(.intl-deck:not([data-active="-1"]) .intl-deck-item:not(:first-child)) {
      margin-left: -15.5%;
    }

    :global(.intl-deck[data-active="0"] .intl-deck-item[data-index="1"]),
    :global(.intl-deck[data-active="1"] .intl-deck-item[data-index="0"]),
    :global(.intl-deck[data-active="1"] .intl-deck-item[data-index="2"]),
    :global(.intl-deck[data-active="2"] .intl-deck-item[data-index="1"]) {
      width: 28%;
      z-index: 20;
      transform: scale(0.95);
      filter: brightness(0.92);
    }

    :global(.intl-deck[data-active="0"] .intl-deck-item[data-index="2"]),
    :global(.intl-deck[data-active="2"] .intl-deck-item[data-index="0"]) {
      width: 28%;
      z-index: 10;
      transform: scale(0.9);
      filter: brightness(0.84);
    }

    :global(.intl-deck:not([data-active="-1"]) .intl-deck-item[data-state="peeking"]:hover) {
      filter: brightness(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.intl-deck-expanded) {
      animation: none;
    }

    :global(.intl-deck-item) {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-deck]").forEach((deck) => {
      if (deck.dataset.deckBound) return;
      deck.dataset.deckBound = "1";

      const items = Array.from(deck.querySelectorAll("[data-deck-item]"));

      const setActive = (activeIdx) => {
        deck.setAttribute("data-active", String(activeIdx));

        items.forEach((item, idx) => {
          const collapsed = item.querySelector("[data-deck-collapsed]");
          const expanded = item.querySelector("[data-deck-expanded]");
          const isActive = idx === activeIdx;

          item.setAttribute("data-state", activeIdx === -1 ? "idle" : isActive ? "active" : "peeking");
          collapsed?.classList.toggle("hidden", isActive);
          collapsed?.setAttribute("aria-expanded", String(isActive));
          expanded?.classList.toggle("hidden", !isActive);
        });
      };

      items.forEach((item, idx) => {
        const collapsed = item.querySelector("[data-deck-collapsed]");
        const expanded = item.querySelector("[data-deck-expanded]");
        const closeBtn = item.querySelector("[data-deck-close]");

        collapsed?.addEventListener("click", () => setActive(idx));
        collapsed?.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            setActive(idx);
          }
        });

        expanded?.addEventListener("click", (e) => {
          if (e.target.closest("[data-deck-close]")) return;
          setActive(-1);
        });
        expanded?.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " " || e.key === "Escape") {
            e.preventDefault();
            setActive(-1);
          }
        });

        closeBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          setActive(-1);
        });
      });
    });
  })();
</script>
