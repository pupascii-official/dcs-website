---
import { studentExchangeData, studentExchangeMore } from "../../data/internationalization/students";
import SectionHeader from "./SectionHeader.astro";
import StackedDeck from "./StackedDeck.astro";
---

<div class="student-experience-root w-full">
  <SectionHeader
    label="SECTION 05"
    title="Global Student Experience"
    description="BSCS students participate in outbound academic exchange programs across partner universities in South Korea, India, and Japan, gaining cross-cultural exposure and international computing coursework."
    marginClass="mb-8"
  />

  <StackedDeck desktopHeight="460px">
    {studentExchangeData.map((student, idx) => (
      <div class="intl-deck-item" data-deck-item data-index={idx} data-state="idle">
        <div
          class="relative w-full aspect-[3/4] md:aspect-auto md:h-full rounded-2xl overflow-hidden border border-neutral-200 hover:border-(--color-maroon) bg-(--color-dark-maroon) shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer group"
          data-deck-collapsed
          role="button"
          tabindex="0"
          aria-expanded="false"
          aria-label={`View exchange story of ${student.name}`}
        >
          <img
            src={student.portraitPath}
            alt={`Student scholar ${student.name}`}
            class="intl-deck-photo collapsed-portrait-img transition-transform duration-300 group-hover:scale-[1.03]"
            loading="lazy"
          />
          <div class="collapsed-overlay absolute inset-0 flex flex-col justify-end p-4 sm:p-5 text-center">
            <h3 class="intl-deck-title font-['Montserrat',sans-serif] text-base sm:text-lg font-extrabold leading-tight">
              {student.displayNameOnPortrait}
            </h3>
            <p class="text-xs font-bold text-white mt-1">{student.university}</p>
            <p class="text-[11px] text-white/85 mt-0.5">{student.cityCountry}</p>
            <span class="inline-flex items-center gap-1 mt-2.5 mx-auto px-3 py-1 rounded-full text-[10px] font-bold text-(--color-gold) bg-white/10 border border-(--color-gold)/35 group-hover:bg-(--color-gold) group-hover:text-[#420000] transition-colors w-fit">
              View highlights →
            </span>
          </div>
        </div>

        <div
          class="intl-deck-expanded hidden relative w-full md:h-full rounded-2xl overflow-hidden shadow-2xl border border-(--color-maroon) cursor-pointer"
          data-deck-expanded
          role="button"
          tabindex="0"
          aria-label={`Collapse exchange story of ${student.name}`}
        >
          <button
            type="button"
            data-deck-close
            aria-label="Collapse card"
            class="absolute top-3.5 right-3.5 z-20 w-9 h-9 rounded-full bg-black/45 hover:bg-black/70 text-white flex items-center justify-center text-xs font-bold backdrop-blur-xs transition-colors cursor-pointer"
          >
            ✕
          </button>

          <div class="md:hidden relative w-full h-52 overflow-hidden">
            <img src={student.groupPhotoPath} alt={`${student.name} exchange group`} class="intl-deck-photo" loading="lazy" />
            <div class="intl-deck-fade-mobile absolute inset-0 pointer-events-none"></div>
          </div>

          <div class="hidden md:block absolute inset-y-0 right-0 w-3/5 h-full overflow-hidden">
            <img src={student.groupPhotoPath} alt={`${student.name} exchange group`} class="intl-deck-photo" loading="lazy" />
          </div>

          <div class="hidden md:block intl-deck-fade-desktop absolute inset-0 pointer-events-none z-[1]"></div>

          <div class="relative z-10 w-full md:w-[55%] md:h-full p-5 sm:p-7 flex flex-col justify-center overflow-y-auto scrollbar-none">
            <h3 class="intl-deck-title font-['Montserrat',sans-serif] text-xl sm:text-2xl font-extrabold leading-tight pr-8 md:pr-0">
              {student.name}
            </h3>
            <p class="expanded-degree text-xs font-medium text-white/90 mt-0.5">{student.degree}</p>
            <p class="text-xs sm:text-[13px] font-bold text-white leading-snug">
              {student.university}, {student.country}
            </p>
            <p class="text-[11px] sm:text-xs text-white/90 leading-snug mt-1">
              <span class="font-bold text-white">Activity:</span> {student.activity}
            </p>
            <p class="expanded-modality text-[11px] sm:text-xs text-white/90 leading-snug mt-0.5">
              <span class="font-bold text-white">Modality:</span> {student.modality}
            </p>

            <div class="space-y-2.5 pt-2.5 border-t border-white/20">
              {student.sections.map((sec) => (
                <div>
                  <h4 class="intl-deck-subheading font-['Montserrat',sans-serif] text-xs font-bold tracking-wide">
                    {sec.heading}
                  </h4>
                  <ul class="space-y-1 text-[11px] sm:text-xs text-white/90 leading-snug list-disc pl-4 mt-1">
                    {sec.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </StackedDeck>

  <div class="mt-6 pt-4 border-t border-neutral-200">
    <h3 class="font-['Montserrat',sans-serif] text-sm sm:text-base font-extrabold text-(--color-maroon) mb-1">
      {studentExchangeMore.heading}
    </h3>
    <p class="upcoming-lead text-sm text-neutral-800 font-medium">
      {studentExchangeMore.lead}
    </p>
    <ul class="space-y-1.5 text-xs sm:text-sm font-bold text-(--color-maroon)">
      {studentExchangeMore.list.map((item) => (
        <li class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-(--color-maroon) shrink-0"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .student-experience-root p {
    margin-bottom: 0;
  }

  .student-experience-root .upcoming-lead,
  .student-experience-root .expanded-degree {
    margin-bottom: 0.625rem;
  }

  .student-experience-root .expanded-modality {
    margin-bottom: 0.75rem;
  }

  .collapsed-portrait-img {
    object-position: top center;
  }

  .collapsed-overlay {
    background: linear-gradient(
      to top,
      var(--color-dark-maroon) 0%,
      var(--color-maroon) 18%,
      rgba(128, 0, 0, 0.92) 26%,
      rgba(128, 0, 0, 0.25) 42%,
      transparent 60%
    );
  }
</style>
