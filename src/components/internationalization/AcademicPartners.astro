---
import { internationalData } from "../../data/internationalization/content";
import SectionHeader from "./SectionHeader.astro";
import StackedDeck from "./StackedDeck.astro";

const { label, title, description, partners } = internationalData.section3;
---

<div class="partners-root w-full">
  <SectionHeader label={label} title={title} description={description} marginClass="mb-8" />

  <StackedDeck desktopHeight="430px">
    {partners.map((partner, idx) => (
      <div class="intl-deck-item" data-deck-item data-index={idx} data-state="idle">
        <div
          class="relative w-full min-h-[340px] md:min-h-0 md:h-full p-7 sm:p-8 rounded-2xl border border-(--color-maroon)/45 hover:border-(--color-maroon) bg-white shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer flex flex-col justify-between items-center group"
          data-deck-collapsed
          role="button"
          tabindex="0"
          aria-expanded="false"
          aria-label={`View partnership highlights for ${partner.name}`}
        >
          <div class="w-full flex-1 flex items-center justify-center py-3">
            <img
              src={partner.imagePath}
              alt={partner.name}
              class="partner-logo transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="w-full text-center pt-3">
            <h3 class="font-['Montserrat',sans-serif] text-lg sm:text-xl font-extrabold text-(--color-maroon) leading-snug">
              {partner.name}
            </h3>
            <p class="text-xs sm:text-sm text-neutral-500 mt-1.5 font-medium">{partner.location}</p>
            <span class="inline-flex items-center gap-1 mt-3 px-3 py-1 rounded-full text-[11px] font-bold text-(--color-maroon) bg-(--color-maroon)/5 group-hover:bg-(--color-maroon) group-hover:text-(--color-gold) transition-colors">
              View highlights →
            </span>
          </div>
        </div>

        <div
          class="expanded-partner-card hidden relative w-full md:h-full rounded-2xl overflow-hidden shadow-2xl border border-(--color-maroon) cursor-pointer"
          data-deck-expanded
          role="button"
          tabindex="0"
          aria-label={`Collapse partnership highlights for ${partner.name}`}
        >
          <button
            type="button"
            data-deck-close
            aria-label="Collapse card"
            class="absolute top-3.5 right-3.5 z-20 w-8 h-8 rounded-full bg-black/40 hover:bg-black/65 text-white flex items-center justify-center text-xs font-bold backdrop-blur-xs transition-colors cursor-pointer"
          >
            ✕
          </button>

          <div class="md:hidden relative w-full h-48 overflow-hidden">
            <img src={partner.meetingPhotoPath} alt={`${partner.name} partnership meeting`} class="partner-meeting-img" loading="lazy" />
            <div class="partner-mobile-gradient absolute inset-0 pointer-events-none"></div>
          </div>

          <div class="hidden md:block absolute inset-y-0 right-0 w-3/5 h-full overflow-hidden">
            <img src={partner.meetingPhotoPath} alt={`${partner.name} partnership meeting`} class="partner-meeting-img" loading="lazy" />
          </div>

          <div class="hidden md:block partner-desktop-gradient absolute inset-0 pointer-events-none z-[1]"></div>

          <div class="relative z-10 w-full md:w-[60%] md:h-full p-6 sm:p-8 flex flex-col justify-center overflow-y-auto scrollbar-none">
            <span class="text-[11px] font-bold uppercase tracking-widest text-white/85 block mb-1">
              {partner.location}
            </span>

            <h3 class="expanded-partner-title font-['Montserrat',sans-serif] text-xl sm:text-2xl font-extrabold leading-tight pr-8 md:pr-0">
              {partner.name}
            </h3>

            <p class="partner-focus-line text-xs text-white/95 mt-2 leading-snug">
              <span class="font-bold text-(--color-gold)">Focus:</span> {partner.focus}
            </p>

            <div class="pt-2.5 border-t border-white/20">
              <h4 class="expanded-partner-subheading font-['Montserrat',sans-serif] text-[11px] font-extrabold uppercase tracking-wider mb-1.5">
                Partnership Highlights
              </h4>
              <ul class="space-y-1.5 text-[11px] sm:text-xs text-white/90 leading-snug list-disc pl-4">
                {partner.highlights.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    ))}
  </StackedDeck>
</div>

<style>
  .partners-root p {
    margin-bottom: 0;
  }

  .partners-root .partner-focus-line {
    margin-bottom: 0.75rem;
  }

  .partner-logo {
    height: 8rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    border-radius: 0;
    display: block;
  }

  @media (min-width: 768px) {
    .partner-logo {
      height: 9.5rem;
    }
  }

  .expanded-partner-card {
    background-color: var(--color-dark-maroon);
  }

  .expanded-partner-title {
    color: var(--color-gold) !important;
  }

  .expanded-partner-subheading {
    color: var(--color-white) !important;
  }

  .partner-meeting-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
    display: block;
  }

  .partner-desktop-gradient {
    background: linear-gradient(
      90deg,
      var(--color-dark-maroon) 0%,
      var(--color-maroon) 42%,
      rgba(128, 0, 0, 0.94) 50%,
      rgba(128, 0, 0, 0.6) 62%,
      rgba(128, 0, 0, 0.18) 74%,
      transparent 86%
    );
  }

  .partner-mobile-gradient {
    background: linear-gradient(
      to top,
      var(--color-dark-maroon) 0%,
      rgba(66, 0, 0, 0.45) 45%,
      transparent 100%
    );
  }
</style>
