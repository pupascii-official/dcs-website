---
import { internationalData } from "../../data/internationalization/content";

const { title, items } = internationalData.conferencesDelegations;
---

<div class="conferences-root w-full space-y-6">
  <h3 class="font-['Montserrat',sans-serif] text-xl sm:text-2xl font-extrabold text-(--color-maroon) tracking-tight">
    {title}
  </h3>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
    {items.map((event) => (
      <article class="rounded-2xl overflow-hidden border border-(--color-maroon)/30 hover:border-(--color-maroon) bg-white shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col group">
        <div
          data-lightbox-trigger
          data-lightbox-src={event.imagePath}
          data-lightbox-title={event.title}
          data-lightbox-subtitle={`${event.date} • ${event.location}`}
          class="relative w-full h-48 bg-neutral-900 overflow-hidden shrink-0 cursor-pointer"
        >
          <img
            src={event.imagePath}
            alt={event.title}
            class="conf-card-img transition-transform duration-300 group-hover:scale-[1.03]"
            loading="lazy"
          />
          <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-(--color-maroon)/90 text-(--color-gold) font-['Montserrat',sans-serif] text-[10px] font-extrabold shadow-sm backdrop-blur-xs">
            {event.date}
          </span>
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
          <div class="space-y-2">
            <h3 class="font-['Montserrat',sans-serif] text-sm sm:text-[15px] font-extrabold text-(--color-maroon) leading-snug">
              {event.title}
            </h3>
            <p class="text-xs font-semibold text-neutral-700 leading-snug">{event.location}</p>
            <p class="text-[11px] text-neutral-600 leading-relaxed">
              <span class="font-bold text-neutral-800">Organizers:</span> {event.organizers}
            </p>
          </div>

          <div class="pt-3 border-t border-neutral-100">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-(--color-maroon) block mb-1">
              Key Participants
            </span>
            <p class="text-[11px] text-neutral-700 leading-relaxed">{event.participants}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .conferences-root p {
    margin-bottom: 0;
  }

  .conf-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    border-radius: 0;
    display: block;
  }
</style>
