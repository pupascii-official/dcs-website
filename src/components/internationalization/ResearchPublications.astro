---
import { internationalData } from "../../data/internationalization/content";

const { label, title, description, publications, selectedConferenceHeading, selectedConferenceList } =
  internationalData.section5;
---

<div class="w-full space-y-8" data-research-publications>
  <div class="border-l-[3px] border-(--color-maroon) pl-4">
    <small class="text-(--color-dark-gold) font-semibold text-xs tracking-wider uppercase block mb-1">
      {label}
    </small>
    <h2 class="font-['Montserrat',sans-serif] text-2xl sm:text-3xl lg:text-4xl font-extrabold text-(--color-maroon) tracking-tight">
      {title}
    </h2>
    <p class="text-sm text-neutral-700 max-w-4xl mt-2 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 w-full">
    {publications.map((pub) => (
      <div class="rounded-2xl border border-(--color-maroon) bg-white p-6 sm:p-8 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow duration-200">
        <div>
          <span class="text-[11px] font-bold text-(--color-maroon) tracking-wider uppercase block mb-3">
            {pub.typeBadge}
          </span>
          <h3 class="pub-card-title font-['Montserrat',sans-serif] text-base sm:text-lg font-extrabold text-[#1A1414] leading-snug mb-3">
            {pub.title}
          </h3>
          <p class="text-xs text-neutral-600 mb-4">{pub.journal}</p>
        </div>
        <p class="text-xs font-bold text-(--color-maroon) pt-4 border-t border-neutral-100">
          {pub.faculty}
        </p>
      </div>
    ))}
  </div>

  <div class="w-full space-y-4 pt-2">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 w-full">
      <h3 class="font-['Montserrat',sans-serif] text-lg sm:text-xl font-bold text-(--color-maroon)">
        {selectedConferenceHeading}
      </h3>
      <div class="relative w-full sm:w-64 shrink-0">
        <input
          type="text"
          data-filter-input
          placeholder="Filter papers or authors..."
          class="w-full text-xs px-3.5 py-2 rounded-full border border-neutral-300 focus:outline-none focus:border-(--color-maroon) bg-white shadow-2xs"
        />
        <button
          type="button"
          data-filter-clear
          class="hidden absolute right-3 top-2 text-neutral-400 hover:text-neutral-700 text-xs font-bold cursor-pointer"
        >
          ✕
        </button>
      </div>
    </div>

    <div class="w-full h-auto rounded-2xl border border-neutral-300 bg-white py-5 px-6 shadow-sm">
      <div class="conference-list-scroll h-auto max-h-[340px] overflow-y-auto pr-2 space-y-5">
        {selectedConferenceList.map((paper, idx) => (
          <div
            data-paper-row
            data-paper-title={paper.title.toLowerCase()}
            data-paper-authors={paper.authors.toLowerCase()}
            class={idx !== selectedConferenceList.length - 1 ? "pb-5 border-b border-neutral-200" : "pb-0"}
          >
            <h4 class="paper-row-title font-['Montserrat',sans-serif] text-sm sm:text-base font-bold text-[#1A1414] leading-snug mb-1.5">
              {paper.title}
            </h4>
            <p class="text-xs font-bold text-(--color-maroon)">{paper.authors}</p>
          </div>
        ))}
        <p data-no-results class="hidden text-xs text-neutral-500 py-4 text-center">
          No papers found matching your query.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .pub-card-title,
  .paper-row-title {
    color: var(--color-text-body) !important;
  }

  [data-research-publications] p {
    margin-bottom: 0;
  }

  .conference-list-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(128, 0, 0, 0.45) #f1f1f1;
    scrollbar-gutter: stable;
  }

  .conference-list-scroll::-webkit-scrollbar {
    width: 6px;
  }

  .conference-list-scroll::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 9999px;
  }

  .conference-list-scroll::-webkit-scrollbar-thumb {
    background-color: rgba(128, 0, 0, 0.45);
    border-radius: 9999px;
  }

  .conference-list-scroll::-webkit-scrollbar-thumb:hover {
    background-color: rgba(128, 0, 0, 0.7);
  }
</style>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-research-publications]").forEach((root) => {
      const input = root.querySelector("[data-filter-input]");
      const clearBtn = root.querySelector("[data-filter-clear]");
      const rows = root.querySelectorAll("[data-paper-row]");
      const noResults = root.querySelector("[data-no-results]");

      if (!input) return;

      const filter = () => {
        const query = input.value.trim().toLowerCase();
        let visibleCount = 0;

        clearBtn?.classList.toggle("hidden", query === "");

        rows.forEach((row) => {
          const title = row.getAttribute("data-paper-title") || "";
          const authors = row.getAttribute("data-paper-authors") || "";
          const isMatch = title.includes(query) || authors.includes(query);

          row.classList.toggle("hidden", !isMatch);
          if (isMatch) visibleCount++;
        });

        if (noResults) {
          noResults.classList.toggle("hidden", visibleCount > 0);
        }
      };

      input.addEventListener("input", filter);
      clearBtn?.addEventListener("click", () => {
        input.value = "";
        filter();
      });
    });
  })();
</script>
