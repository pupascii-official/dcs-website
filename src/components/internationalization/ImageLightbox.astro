<dialog
  data-intl-lightbox
  class="backdrop:bg-black/70 backdrop:backdrop-blur-xs p-0 rounded-2xl border-0 shadow-2xl max-w-4xl w-[92vw] m-auto bg-transparent"
>
  <div class="bg-white rounded-2xl p-5 sm:p-6">
    <div class="flex justify-between items-start gap-4 mb-4">
      <div>
        <h4 data-lightbox-title class="font-['Montserrat',sans-serif] text-base sm:text-lg font-extrabold text-(--color-maroon)"></h4>
        <p data-lightbox-subtitle class="text-xs text-neutral-600 mt-1 mb-0!"></p>
      </div>
      <button
        type="button"
        data-lightbox-close
        aria-label="Close preview"
        class="w-8 h-8 rounded-full bg-neutral-100 text-neutral-600 hover:bg-neutral-200 flex items-center justify-center font-bold text-sm shrink-0 cursor-pointer"
      >
        ✕
      </button>
    </div>
    <div class="rounded-xl overflow-hidden border border-neutral-200 bg-neutral-950">
      <img data-lightbox-img src="" alt="" class="intl-lightbox-img" />
    </div>
  </div>
</dialog>

<style>
  .intl-lightbox-img {
    width: 100%;
    max-height: 72vh;
    height: auto;
    object-fit: contain;
    border-radius: 0;
    display: block;
    margin: 0 auto;
  }
</style>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-intl-lightbox]");
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = "1";

    const imgEl = dialog.querySelector("[data-lightbox-img]");
    const titleEl = dialog.querySelector("[data-lightbox-title]");
    const subtitleEl = dialog.querySelector("[data-lightbox-subtitle]");
    const closeBtn = dialog.querySelector("[data-lightbox-close]");

    document.addEventListener("click", (e) => {
      const trigger = e.target.closest("[data-lightbox-trigger]");
      if (!trigger) return;

      const src = trigger.getAttribute("data-lightbox-src") || "";
      const title = trigger.getAttribute("data-lightbox-title") || "";
      const subtitle = trigger.getAttribute("data-lightbox-subtitle") || "";

      if (imgEl) {
        imgEl.setAttribute("src", src);
        imgEl.setAttribute("alt", title);
      }
      if (titleEl) titleEl.textContent = title;
      if (subtitleEl) subtitleEl.textContent = subtitle;
      if (typeof dialog.showModal === "function") dialog.showModal();
    });

    closeBtn?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      const rect = dialog.getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
        dialog.close();
      }
    });
  })();
</script>
