---
import ScrollSnapLayout from "../layouts/ScrollSnapLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import ContentCard from "../components/ContentCard.astro";

import SectionHeader from "../components/internationalization/SectionHeader.astro";
import ImageLightbox from "../components/internationalization/ImageLightbox.astro";
import AccreditationSection from "../components/internationalization/AccreditationSection.astro";
import RankingsSection from "../components/internationalization/RankingsSection.astro";
import AcademicPartners from "../components/internationalization/AcademicPartners.astro";
import FeaturedResearchProject from "../components/internationalization/FeaturedResearchProject.astro";
import ResearchPublications from "../components/internationalization/ResearchPublications.astro";
import ConferencesDelegations from "../components/internationalization/ConferencesDelegations.astro";
import StudentExperience from "../components/internationalization/StudentExperience.astro";
import CompetitionExcellence from "../components/internationalization/CompetitionExcellence.astro";

import { internationalData } from "../data/internationalization/content";

const sectionBase = "scroll-section scrollbar-none flex flex-col px-4 sm:px-6 md:px-8 pb-12 max-w-6xl mx-auto w-full overflow-x-hidden";
const { picabSpotlight } = internationalData.section2;
---

<ScrollSnapLayout
  title="Internationalization | PUP Department of Computer Science"
  description="Showcasing PUP BSCS's international recognition, academic partnerships, research innovation, and global engagement."
>
  <HeroSection
    title={internationalData.hero.title}
    subtitle={internationalData.hero.lead}
  >
    <p>
      {internationalData.hero.subtext}
    </p>
  </HeroSection>

  <section class={sectionBase}>
    <div class="my-auto w-full min-w-0">
      <AccreditationSection />
    </div>
  </section>

  <section class={`${sectionBase} pb-14`}>
    <SectionHeader label={internationalData.section2.label} title={internationalData.section2.title} marginClass="mb-6" />
    <div class="picab-spotlight mb-10 md:mb-12">
      <ContentCard kicker={picabSpotlight.kicker} display={picabSpotlight.display}>
        <img slot="media" src={picabSpotlight.imagePath} alt={picabSpotlight.imageAlt} loading="lazy" />

        <div slot="content" class="picab-cic-content">
          <b>{picabSpotlight.date}</b>
          {picabSpotlight.paragraphs.map((text) => (
            <p>{text}</p>
          ))}
        </div>
      </ContentCard>
    </div>
    <RankingsSection />
  </section>

  <section class={sectionBase}>
    <div class="my-auto w-full min-w-0">
      <AcademicPartners />
    </div>
  </section>

  <section class={sectionBase}>
    <div class="my-auto w-full min-w-0">
      <FeaturedResearchProject />
    </div>
  </section>

  <section class={`${sectionBase} pb-14`}>
    <ResearchPublications />
  </section>

  <section class={`${sectionBase} pb-14`}>
    <ConferencesDelegations />
  </section>

  <section class={sectionBase}>
    <div class="my-auto w-full min-w-0">
      <StudentExperience />
    </div>
  </section>

  <section class={`${sectionBase} pb-14`}>
    <div class="my-auto w-full min-w-0">
      <CompetitionExcellence />
    </div>
  </section>

  <ImageLightbox />
</ScrollSnapLayout>

<style>
  .picab-spotlight :global(.content-card) {
    margin-bottom: 0;
  }

  .picab-cic-content b {
    display: block;
    margin-bottom: 0.75rem;
  }

  .picab-cic-content p:not(:last-child) {
    margin-bottom: 1rem;
  }
</style>
