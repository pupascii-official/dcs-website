---
import ScrollSnapLayout from "../layouts/ScrollSnapLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import HeroButton from "../components/HeroButton.astro";

import ImageLightbox from "../components/internationalization/ImageLightbox.astro";
import NarrativeReportModal from "../components/internationalization/NarrativeReportModal.astro";
import AccreditationSection from "../components/internationalization/AccreditationSection.astro";
import RankingsSection from "../components/internationalization/RankingsSection.astro";
import AcademicPartners from "../components/internationalization/AcademicPartners.astro";
import FeaturedResearchProject from "../components/internationalization/FeaturedResearchProject.astro";
import ResearchPublications from "../components/internationalization/ResearchPublications.astro";
import ConferencesDelegations from "../components/internationalization/ConferencesDelegations.astro";
import StudentExperience from "../components/internationalization/StudentExperience.astro";
import CompetitionExcellence from "../components/internationalization/CompetitionExcellence.astro";

import area4NarrativePdf from "../assets/pdfs/area-4-internationalization.pdf";
import { internationalData } from "../data/internationalization/content";

const sectionBase = "scroll-section flex flex-col px-4 sm:px-6 md:px-8 pb-12 max-w-6xl mx-auto w-full overflow-x-hidden";
const sectionWide = `${sectionBase} pb-14`;
---

<ScrollSnapLayout
  title="Internationalization | PUP Department of Computer Science"
  description={internationalData.hero.lead}
>
  <HeroSection title={internationalData.hero.title}>
    <p class="text-white font-normal">{internationalData.hero.lead}</p>
    <div
      data-area4-pdf-trigger
      data-pdf-src={area4NarrativePdf}
      data-pdf-title="Area 4: Internationalization Narrative Report"
    >
      <HeroButton label="Area 4 Narrative Report" href={area4NarrativePdf} />
    </div>
  </HeroSection>

  <section class={sectionWide}>
    <AccreditationSection />
  </section>

  <section class={sectionWide}>
    <RankingsSection />
  </section>

  <section class={sectionBase}>
    <AcademicPartners />
  </section>

  <section class={sectionBase}>
    <FeaturedResearchProject />
  </section>

  <section class={sectionWide}>
    <ResearchPublications />
  </section>

  <section class={sectionWide}>
    <ConferencesDelegations />
  </section>

  <section class={sectionBase}>
    <StudentExperience />
  </section>

  <section class={sectionWide}>
    <CompetitionExcellence />
  </section>

  <ImageLightbox />
  <NarrativeReportModal />
</ScrollSnapLayout>

<style>
  :global([data-intl-reveal=""]) {
    opacity: 0;
    transform: translateY(1rem);
  }

  :global([data-intl-reveal=""]),
  :global([data-intl-reveal="visible"]) {
    transition:
      opacity 550ms ease-out var(--reveal-delay, 0ms),
      transform 550ms ease-out var(--reveal-delay, 0ms);
  }

  :global([data-intl-reveal="visible"]) {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-intl-reveal=""]) {
      opacity: 1;
      transform: none;
    }

    :global([data-intl-reveal=""]),
    :global([data-intl-reveal="visible"]) {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const targets = document.querySelectorAll("[data-intl-reveal]");
    if (!targets.length) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion || !("IntersectionObserver" in window)) {
      targets.forEach((el) => el.setAttribute("data-intl-reveal", "done"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          el.setAttribute("data-intl-reveal", "visible");
          const finish = (e) => {
            if (e.propertyName === "opacity") {
              el.setAttribute("data-intl-reveal", "done");
              el.removeEventListener("transitionend", finish);
            }
          };
          el.addEventListener("transitionend", finish);
          observer.unobserve(el);
        });
      },
      { threshold: 0.12 }
    );

    targets.forEach((el) => observer.observe(el));
  })();
</script>
