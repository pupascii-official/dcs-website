---
import ScrollSnapLayout from "../layouts/ScrollSnapLayout.astro";
import HeroSection from "../components/HeroSection.astro";

const areas = [
	{
		title: "Area I: Vision, Mission, Goals & Objectives",
		short: "Area I: VMGO",
		driveUrl:
			"https://drive.google.com/file/d/1lKMExs7J2gClx-ZkpOA76MlSRC0DPf-O/view?usp=sharing",
	},
	{
		title: "Area II: Faculty",
		short: "Area II: Faculty",
		driveUrl:
			"https://drive.google.com/file/d/1TgYhDQIc-ATvkDCIlnE7uCSX9655iK5Y/view?usp=drive_link",
	},
	{
		title: "Area III: Curriculum & Instruction",
		short: "Area III: Curriculum",
		driveUrl:
			"https://drive.google.com/file/d/1ybhzd1S5Zmxpk0QzFqmPgPswaY_fMhuC/view?usp=sharing",
	},
	{
		title: "Area IV: Support to Students",
		short: "Area IV: Student Support",
		driveUrl:
			"https://drive.google.com/file/d/1YYBc8ztr2yijF-sqLIjb9uOx1V6W1TvG/view?usp=sharing",
	},
	{
		title: "Area V: Research",
		short: "Area V: Research",
		driveUrl:
			"https://drive.google.com/file/d/1rYkpMNk95JgRMx1Ov74IN2_yy5XqaLwm/view?usp=sharing",
	},
	{
		title: "Area VI: Extension & Community Involvement",
		short: "Area VI: Extension",
		driveUrl:
			"https://drive.google.com/file/d/1R4J5VFcvTdQYQGlS0XYQCK-UnI_-DcCc/view?usp=drive_link",
	},
	{
		title: "Area VII: Library",
		short: "Area VII: Library",
		driveUrl:
			"https://drive.google.com/file/d/1aoeeNoA-FF3LmaAkikg06-aPVHiCgMQs/view?usp=drive_link",
	},
	{
		title: "Area VIII: Physical Plant & Facilities",
		short: "Area VIII: Physical Plant",
		driveUrl:
			"https://drive.google.com/file/d/1aUfJwRjombZkEg7mbjwsw8Krq0FkE8fg/view?usp=drive_link",
	},
	{
		title: "Area IX: Laboratories",
		short: "Area IX: Laboratories",
		driveUrl:
			"https://drive.google.com/file/d/1unucDHis13c9-bnFbiybCi3XJGcy8RhU/view?usp=drive_link",
	},
	{
		title: "Area X: Administration & PICAB / Narrative",
		short: "Area X: Admin & PICAB",
		driveUrl:
			"https://drive.google.com/file/d/1m8FZLQSDhkwdFH5fI0RwEJiF3_Wo5Vvl/view?usp=drive_link",
	},
];

const sectionNumber = (index: number) => String(index + 1).padStart(2, "0");
---

<ScrollSnapLayout
	title="Compliance"
	description="Accreditation compliance documents of the PUP Department of Computer Science."
>
	<HeroSection title="Compliance" subtitle="" />

	<section class="scroll-section areas-section">
		<div class="areas">
			{areas.map((area, index) => (
				<article class="area-card">
					<div>
						<small class="area-label">
							SECTION {sectionNumber(index)}
						</small>
						<h3 class="area-title">
							<span class="desktop-only">{area.title}</span>
							<span class="mobile-only">{area.short}</span>
						</h3>
					</div>
					<a
						class="drive-button"
						href={area.driveUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Drive →
					</a>
				</article>
			))}
		</div>
	</section>
</ScrollSnapLayout>

<style>
	.mobile-only {
		display: none;
	}

	.areas-section {
		display: flex;
		align-items: center;
		padding: 7rem 1.25rem 3rem;
		background-color: var(--color-bg-canvas);
	}

	.areas {
		width: 100%;
		max-width: 1180px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px 20px;
	}

	.area-card {
		min-height: 82px;
		padding: 0 22px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		background-color: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 10px;
	}

	.area-label {
		display: block;
		margin-bottom: 4px;
	}

	.area-title {
		margin: 0;
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 15px;
		font-weight: 600;
		color: var(--color-text-body);
	}

	.drive-button {
		width: 104px;
		height: 40px;
		display: grid;
		place-items: center;
		flex-shrink: 0;
		background-color: var(--color-maroon);
		border-radius: 8px;
		color: var(--color-white);
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.drive-button:hover {
		background-color: var(--color-dark-maroon);
	}

	@media (max-width: 768px) {
		.desktop-only {
			display: none;
		}

		.mobile-only {
			display: inline;
		}

		.areas-section {
			align-items: flex-start;
			padding: 7rem 1.25rem 2rem;
		}

		.areas {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.area-card {
			min-height: 62px;
			padding: 0 14px 0 16px;
		}

		.area-title {
			font-size: 14px;
		}

		.drive-button {
			width: 78px;
			height: 34px;
			font-size: 12px;
		}
	}
</style>
