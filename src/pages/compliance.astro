---
const areas = [
	{ title: 'Area I: Vision, Mission, Goals & Objectives', short: 'Area I: VMGO', driveUrl: '#' },
	{ title: 'Area II: Faculty', short: 'Area II: Faculty', driveUrl: '#' },
	{ title: 'Area III: Curriculum & Instruction', short: 'Area III: Curriculum', driveUrl: '#' },
	{ title: 'Area IV: Support to Students', short: 'Area IV: Student Support', driveUrl: '#' },
	{ title: 'Area V: Research', short: 'Area V: Research', driveUrl: '#' },
	{ title: 'Area VI: Extension & Community Involvement', short: 'Area VI: Extension', driveUrl: '#' },
	{ title: 'Area VII: Library', short: 'Area VII: Library', driveUrl: '#' },
	{ title: 'Area VIII: Physical Plant & Facilities', short: 'Area VIII: Physical Plant', driveUrl: '#' },
	{ title: 'Area IX: Laboratories', short: 'Area IX: Laboratories', driveUrl: '#' },
	{ title: 'Area X: Administration & PICAB / Narrative', short: 'Area X: Admin & PICAB', driveUrl: '#' },
];

const portfolioLinks = [
	{ label: 'Compliance Report', short: 'Compliance', href: '#' },
	{ label: 'Narrative Report', short: 'Narrative', href: '#' },
	{ label: 'Curriculum', short: 'Curriculum', href: '#' },
	{ label: 'Faculty Directory', short: 'Faculty', href: '#' },
];

const pillarLinks = [
	{ label: 'Research', short: 'Research', href: '#' },
	{ label: 'Teaching & Learning', short: 'T&L', href: '#' },
	{ label: 'Community', short: 'Community', href: '#' },
	{ label: 'Internationalization', short: 'Internationalization', href: '#' },
];

const sectionNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Compliance | PUP Department of Computer Science</title>
		<meta name="description" content="Accreditation compliance documents of the PUP Department of Computer Science." />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Montserrat:wght@700;800&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<header class="banner">
			<nav class="pill-nav">
				<span class="logo">{'{CS}'}</span>
				<span class="nav-title">
					<span class="desktop-only">Department of Computer Science</span>
					<span class="mobile-only">Dept. of Computer Science</span>
				</span>
				<span class="nav-tag desktop-only">[Compliance]</span>
				<span class="nav-tag mobile-only">MENU</span>
			</nav>

			<h1 class="banner-title">Compliance</h1>
		</header>

		<main class="areas">
			{
				areas.map((area, index) => (
					<article class="area-card">
						<div>
							<p class="area-label">SECTION {sectionNumber(index)}</p>
							<h2 class="area-title">
								<span class="desktop-only">{area.title}</span>
								<span class="mobile-only">{area.short}</span>
							</h2>
						</div>
						<a class="drive-button" href={area.driveUrl} target="_blank" rel="noopener noreferrer">
							Drive →
						</a>
					</article>
				))
			}
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<div class="footer-about">
					<p class="footer-heading footer-name">
						<span class="desktop-only">PUP Department of Computer Science</span>
						<span class="mobile-only">PUP Dept. of Computer Science</span>
					</p>
					<p class="footer-text">
						<span class="desktop-only">
							College of Computer and Information Sciences • Polytechnic University of the Philippines
						</span>
						<span class="mobile-only">College of Computer &amp; Information Sciences</span>
					</p>
					<p class="footer-text desktop-only">Built with CCIS visual coherence and Computer Science motifs.</p>
				</div>

				<div>
					<p class="footer-heading">Portfolio</p>
					<ul class="footer-links">
						{
							portfolioLinks.map((link) => (
								<li>
									<a href={link.href}>
										<span class="desktop-only">{link.label}</span>
										<span class="mobile-only">{link.short}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<div>
					<p class="footer-heading">Pillars</p>
					<ul class="footer-links">
						{
							pillarLinks.map((link) => (
								<li>
									<a href={link.href}>
										<span class="desktop-only">{link.label}</span>
										<span class="mobile-only">{link.short}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	:root {
		--maroon: #800000;
		--maroon-dark: #3d0000;
		--red: #a30000;
		--gold: #daa520;
		--yellow: #ffde00;
		--text-dark: #1a1414;
		--text-muted: #d9caca;
		--border: #e6dfdf;
		--page-bg: #fafafa;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--page-bg);
		font-family: 'Inter', sans-serif;
		color: var(--text-dark);
	}

	p,
	h1,
	h2,
	ul {
		margin: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.mobile-only {
		display: none;
	}

	.banner {
		position: relative;
		height: 900px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(to bottom, var(--maroon-dark), var(--maroon));
	}

	.pill-nav {
		position: absolute;
		top: 76px;
		left: 50%;
		transform: translateX(-50%);
		width: 480px;
		height: 52px;
		padding: 0 26px 0 12px;
		display: flex;
		align-items: center;
		gap: 12px;
		background: white;
		border: 1px solid var(--border);
		border-radius: 26px;
		font-weight: 700;
	}

	.logo {
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--maroon);
		color: var(--yellow);
		font-size: 11px;
	}

	.nav-title {
		font-size: 14px;
	}

	.nav-tag {
		margin-left: auto;
		color: var(--maroon);
		font-size: 12px;
	}

	.banner-title {
		font-family: 'Montserrat', sans-serif;
		font-weight: 800;
		font-size: 96px;
		line-height: 90px;
		letter-spacing: -1.5px;
		color: white;
		text-align: center;
	}

	.areas {
		max-width: 1220px;
		margin: 0 auto;
		padding: 50px 20px 58px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px 20px;
	}

	.area-card {
		min-height: 82px;
		padding: 0 22px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		background: white;
		border: 1px solid var(--border);
		border-radius: 10px;
	}

	.area-label {
		margin-bottom: 9px;
		color: var(--gold);
		font-size: 11px;
		font-weight: 700;
	}

	.area-title {
		font-size: 15px;
		font-weight: 700;
	}

	.drive-button {
		width: 104px;
		height: 40px;
		display: grid;
		place-items: center;
		flex-shrink: 0;
		background: var(--maroon);
		border-radius: 8px;
		color: white;
		font-size: 13px;
		font-weight: 700;
	}

	.drive-button:hover {
		background: var(--maroon-dark);
	}

	.footer {
		background: linear-gradient(to bottom, var(--red), var(--maroon-dark));
		color: white;
		padding: 54px 20px 90px;
	}

	.footer-inner {
		max-width: 1180px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 260px 230px;
	}

	.footer-heading {
		margin-bottom: 17px;
		font-family: 'Montserrat', sans-serif;
		font-weight: 700;
		font-size: 15px;
		color: var(--yellow);
	}

	.footer-name {
		font-size: 18px;
		margin-bottom: 16px;
	}

	.footer-text {
		color: var(--text-muted);
		font-size: 14px;
		line-height: 20px;
	}

	.footer-text + .footer-text {
		margin-top: 8px;
	}

	.footer-links {
		padding: 0;
		list-style: none;
		font-size: 14px;
		line-height: 20px;
	}

	.footer-links li + li {
		margin-top: 13px;
	}

	.footer-links a:hover {
		color: var(--yellow);
	}

	@media (max-width: 767px) {
		.desktop-only {
			display: none;
		}

		.mobile-only {
			display: revert;
		}

		.banner {
			height: 244px;
			padding-top: 44px;
		}

		.pill-nav {
			top: 24px;
			left: 20px;
			right: 20px;
			transform: none;
			width: auto;
			height: 44px;
			padding: 0 18px 0 8px;
			gap: 10px;
			border-radius: 22px;
		}

		.logo {
			width: 28px;
			height: 28px;
			font-size: 10px;
		}

		.nav-title {
			font-size: 13px;
		}

		.nav-tag {
			font-size: 11px;
		}

		.banner-title {
			font-size: 40px;
		}

		.areas {
			grid-template-columns: 1fr;
			gap: 12px;
			padding: 28px 20px 44px;
		}

		.area-card {
			min-height: 62px;
			padding: 0 14px 0 16px;
		}

		.area-label {
			margin-bottom: 6px;
			font-size: 10px;
		}

		.area-title {
			font-size: 14px;
		}

		.drive-button {
			width: 78px;
			height: 34px;
			font-size: 12px;
		}

		.footer {
			padding: 28px 20px 71px;
		}

		.footer-inner {
			grid-template-columns: 1fr;
			gap: 26px;
		}

		.footer-heading {
			margin-bottom: 11px;
			font-size: 13px;
			line-height: 16px;
		}

		.footer-name {
			font-size: 16px;
			line-height: 20px;
			margin-bottom: 9px;
		}

		.footer-text {
			font-size: 13px;
			line-height: 16px;
		}

		.footer-links {
			font-size: 12px;
			line-height: 15px;
		}

		.footer-links li {
			display: inline;
		}

		.footer-links li + li {
			margin-top: 0;
		}

		.footer-links li + li::before {
			content: ' • ';
		}
	}
</style>
