---
import ScrollSnapLayout from '../layouts/ScrollSnapLayout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import Footer from '../components/Footer.astro';

const areas = [
	{ title: 'Area I: Vision, Mission, Goals & Objectives', short: 'Area I: VMGO', driveUrl: '#' },
	{ title: 'Area II: Faculty', short: 'Area II: Faculty', driveUrl: '#' },
	{ title: 'Area III: Curriculum & Instruction', short: 'Area III: Curriculum', driveUrl: '#' },
	{ title: 'Area IV: Support to Students', short: 'Area IV: Student Support', driveUrl: '#' },
	{ title: 'Area V: Research', short: 'Area V: Research', driveUrl: '#' },
	{ title: 'Area VI: Extension & Community Involvement', short: 'Area VI: Extension', driveUrl: '#' },
	{ title: 'Area VII: Library', short: 'Area VII: Library', driveUrl: '#' },
	{ title: 'Area VIII: Physical Plant & Facilities', short: 'Area VIII: Physical Plant', driveUrl: '#' },
	{ title: 'Area IX: Laboratories', short: 'Area IX: Laboratories', driveUrl: '#' },
	{ title: 'Area X: Administration & PICAB / Narrative', short: 'Area X: Admin & PICAB', driveUrl: '#' },
];

const sectionNumber = (index: number) => String(index + 1).padStart(2, '0');
---

<ScrollSnapLayout title="Compliance" description="Accreditation compliance documents of the PUP Department of Computer Science.">
	<Navbar />

	<HeroSection title="Compliance" subtitle="" />

	<section class="scroll-section areas-section">
		<div class="areas">
			{
				areas.map((area, index) => (
					<article class="area-card">
						<div>
							<small class="area-label">SECTION {sectionNumber(index)}</small>
							<h3 class="area-title">
								<span class="desktop-only">{area.title}</span>
								<span class="mobile-only">{area.short}</span>
							</h3>
						</div>
						<a class="drive-button" href={area.driveUrl} target="_blank" rel="noopener noreferrer">
							Drive →
						</a>
					</article>
				))
			}
		</div>
	</section>

	<Footer />
</ScrollSnapLayout>

<style>
	.mobile-only {
		display: none;
	}

	.areas-section {
		display: flex;
		align-items: center;
		padding: 7rem 1.25rem 3rem;
		background-color: var(--color-bg-canvas);
	}

	.areas {
		width: 100%;
		max-width: 1180px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px 20px;
	}

	.area-card {
		min-height: 82px;
		padding: 0 22px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		background-color: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 10px;
	}

	.area-label {
		display: block;
		margin-bottom: 4px;
	}

	.area-title {
		margin: 0;
		font-family: var(--font-inter), system-ui, sans-serif;
		font-size: 15px;
		font-weight: 600;
		color: var(--color-text-body);
	}

	.drive-button {
		width: 104px;
		height: 40px;
		display: grid;
		place-items: center;
		flex-shrink: 0;
		background-color: var(--color-maroon);
		border-radius: 8px;
		color: var(--color-white);
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	.drive-button:hover {
		background-color: var(--color-dark-maroon);
	}

	@media (max-width: 768px) {
		.desktop-only {
			display: none;
		}

		.mobile-only {
			display: inline;
		}

		.areas-section {
			align-items: flex-start;
			padding: 7rem 1.25rem 2rem;
		}

		.areas {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.area-card {
			min-height: 62px;
			padding: 0 14px 0 16px;
		}

		.area-title {
			font-size: 14px;
		}

		.drive-button {
			width: 78px;
			height: 34px;
			font-size: 12px;
		}
	}
</style>
