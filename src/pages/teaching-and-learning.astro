---
import ScrollSnapLayout from "../layouts/ScrollSnapLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import SectionContent from "../components/teaching-learning/SectionContent.astro";
import {teachingEvidence} from "../data/teaching-learning/evidence";
import MaroonSection from "../components/teaching-learning/MaroonSection.astro";

import EvidenceShowcase from "../components/teaching-learning/evidence/EvidenceShowcase.astro";
import ElectiveTracks from "../components/teaching-learning/elective/ElectiveTracks.astro";
import CurriculumMap from "../components/teaching-learning/curriculum/CurriculumMap.astro";
import CurriculumExplorer from "../components/teaching-learning/curriculum/CurriculumExplorer.astro";
import StudentOutcomes from "../components/teaching-learning/StudentOutcomes.astro";
import AppliedLearning from "../components/teaching-learning/AppliedLearning.astro";
import StudentOrg from "../components/teaching-learning/StudentOrg.astro";
import StudentAwards from "../components/teaching-learning/StudentAwards.astro";
import StudentsIntl from "../components/teaching-learning/StudentsIntl.astro";
import AccomplishmentReports from "../components/teaching-learning/AccomplishmentReports.astro";
import NotableAlumni from "../components/teaching-learning/NotableAlumni.astro";
import GraduateTracer from "../components/teaching-learning/GraduateTracer.astro";
import PEOScores from "../components/teaching-learning/PEOScores.astro";
import PICAB from "../components/teaching-learning/PICAB.astro";
import ContentSection from "../components/ContentSection.astro";
import FacultyDistribution from "../components/teaching-learning/faculty/FacultyDistribution.astro";
import OutcomesOverview from "../components/teaching-learning/outcomes/OutcomesOverview.astro";
import EvolutionTimeline from "../components/teaching-learning/evolution/EvolutionTimeline.astro";
import CommonCard from "../components/teaching-learning/CommonCard.astro";

import PDFModal from "../components/PDFModal.astro";
import Area2Btn from "../components/Area2Btn.astro";
---

<ScrollSnapLayout
        title="Teaching & Learning"
        description="PUP CCIS Bachelor of Science in Computer Science — outcomes-based education aligned with CHED CMO No. 25, s. 2015 and the 2022 Revised Curriculum (167 Units)."
>
    <!-- HERO -->
    <HeroSection
            title="Teaching &"
            subtitle="AREA 2 • TEACHING AND LEARNING • CODING IDEAS INTO SOLUTIONS"
            accentTitle="Learning"
    >
        <span>
            PUP CCIS Bachelor of Science in Computer Science — outcomes-based education aligned with CHED CMO No. 25, s. 2015 and the 2022 Revised Curriculum (167 Units).
        </span>
        <a
                href="#CurriculumMap"
                class="mt-8 inline-block rounded-full bg-white px-8 py-2 text-lg shadow-md transition-all duration-200 hover:-translate-y-1 hover:shadow-lg"
        >
            <span class="main-button text-center font-bold">Explore 2022 Curriculum &ThinSpace;↗</span>
        </a>
    </HeroSection>

    <!-- EVOLUTION -->
    <ContentSection
            sectionLabel="SECTION 01 • HISTORICAL MILESTONES"
            category="Evolution of PUP’s Computer Science Program"
            description="From 1960s mainframe EDP courses at PCC to a CHED-recognized flagship BSCS degree."
    >
        <EvolutionTimeline/>
    </ContentSection>

    <!-- OUTCOMES-BASED COMPUTING EDUCATION -->
    <section
            class="section-one scroll-section scrollbar-none mx-6 flex max-w-7xl flex-col items-start gap-8 py-8 md:mx-auto md:px-8 xl:flex-row">
        <!-- LEFT CONTENT -->
        <div class="min-w-0 flex-1">
            <SectionContent
                    sectionLabel="SECTION 02 • CMO, OVERVIEW & FRAMEWORK"
                    title="Outcomes-Based Computing Education"
            >
                <p>
                    PUP CCIS delivers a learner-centered, outcomes-based BSCS program built on strong computing theory,
                    analytical problem-solving, and ethical practice.
                </p>
                <p>
                    Anchored on <strong>CHED CMO No. 25, s. 2015</strong> and the <strong>2022 Revised
                    Curriculum</strong> (BOR Res. No. 2825 s. 2022), courses balance lectures, coding labs, research,
                    and capstone projects.
                </p>

                <div class="rounded-2xl border border-(--color-maroon)/20 bg-(--color-muted-maroon) p-4">
                    <div class="mb-2 flex items-center justify-between gap-3">
                        <h3 class="text-sm font-bold text-(--color-maroon)">
                            CHED MEMORANDUM ORDER (CMO)
                        </h3>

                        <span class="shrink-0 rounded-full bg-(--color-gold)/25 px-3 py-1 text-sm font-bold text-(--color-dark-gold)">
                            CMO WILL BE PROVIDED
                        </span>
                    </div>

                    <p class="mb-0 leading-relaxed">
                        Official CHED CMO No. 25, s. 2015 and supporting institutional curriculum policy documents will
                        be provided and linked here.
                    </p>
                </div>
            </SectionContent>
        </div>

        <!-- RIGHT CONTENT -->
        <div class="min-w-0 flex-1">
            <EvidenceShowcase
                    area="AREA 2"
                    category="DOCUMENTARY EVIDENCE"
                    footer="BSCS TEACHING & LEARNING"
                    items={teachingEvidence}
            />
        </div>
    </section>

    <!-- ELECTIVES -->
    <section class="scrollbar-none">
        <MaroonSection
                eyebrow="SECTION 03 • CURRICULUM & ELECTIVE TRACKS"
                title="Four Specialized Elective Tracks"
                description="Implemented AY 2022–2023 (CMO No. 25 s. 2015 & CMO No. 20 s. 2013 aligned) to build deep expertise in AI and data-driven computing."
        >
            <ElectiveTracks/>
        </MaroonSection>
    </section>

    <!-- CURRICULUM MAP -->
    <section id="CurriculumMap" class="scroll-section scrollbar-none mx-6 pt-20 md:pt-24 lg:pt-28">
        <SectionContent
                title="2022 BSCS Curriculum Map"
                sectionLabel="SECTION 04 • CURRICULUM STRUCTURE • 167 UNITS"
        >
            <p>
                Enriched by co-curricular technical seminars, workshops, training programs, research presentations,
                programming competitions, and hackathons.
            </p>

            <CurriculumMap/>
            <CurriculumExplorer/>
        </SectionContent>
    </section>

    <!-- BSCS FACULTY DISTRIBUTION & PROFILES -->
    <ContentSection
            sectionLabel="SECTION 05 • FACULTY MEMBERS & PROFILE"
            category="BSCS Faculty Distribution & Profiles"
            description="24 faculty members — 10 Regular (plantilla, 40 hrs/week, 15-unit regular load) and 14 Part-Time (contractual, 3–12 units) — evaluated under the University's ITEES."
    >
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <div class="min-w-0">
                <FacultyDistribution/>
            </div>

            <div class="min-w-0">
                <CommonCard
                        label="DOCUMENTARY EVIDENCE • PAGE 12"
                        image="/teaching-learning-assets/images/evidence-page12-faculty-meeting.jpg"
                        imageAlt="Faculty Meeting Group Picture"
                        title="CCIS Faculty Meeting (1st Semester, AY 2425)"
                >
                    <p>
                        BSCS faculty members collaborating on curriculum implementation, syllabus enhancement, Student
                        Outcomes assessment, thesis and capstone supervision, research initiatives, and academic
                        mentoring.
                    </p>
                </CommonCard>
            </div>

            <!-- Documentary Evidence -->
            <div class="lg:col-span-2">
                <div class="flex flex-col gap-4 border border-(--color-dark-gold) border-t-4 border-t-(--color-maroon) bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase text-(--color-maroon)">
                            10 Regular • 8 Profiled Part-Time
                        </p>
                        <h3 class="mt-2 text-lg font-bold text-(--color-text-body)">
                            BSCS Faculty Profiles & Qualifications
                        </h3>
                        <p class="mt-1 mb-0 text-sm text-(--color-text-body)">
                            View academic qualifications, specializations, and course assignments of the BSCS faculty on
                            a dedicated page.
                        </p>
                    </div>

                    <a
                            href="/teaching-and-learning/faculty"
                            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-(--color-gold) px-5 py-3 text-sm font-bold text-(--color-maroon) transition hover:bg-(--color-dark-gold)"
                    >
                        View Faculty Profiles →
                    </a>
                </div>
            </div>
        </div>
    </ContentSection>

    <!-- DEVELOPMENT, AWARDS & ITEES -->
    <section class="faculty-development-section scrollbar-none">
        <MaroonSection
                eyebrow="SECTION 06 • DEVELOPMENT, AWARDS & ITEES"
                title="Faculty Development, Awards & ITEES"
                description="Continuous upskilling in instruction, AI/SE research, and quality assurance, alongside PRAISE recognition and semesterly ITEES evaluation (AY 2022–2025)."
        >
            <OutcomesOverview/>
        </MaroonSection>
    </section>

    <!-- INSTRUCTIONAL MATERIALS -->
    <ContentSection
            sectionLabel="SECTION 07 • INSTRUCTIONAL MATERIALS (UTLDO / CIMDA)"
            category="Development of Instructional Materials & Faculty Authors"
            description="Developed in accordance with OBE, CLOs, PLOs, and SOs, and reviewed/endorsed by PUP's UTLDO Center for Instructional Materials Development and Assessment (CIMDA)."
    >
        <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
            <div class="min-w-0">
                <CommonCard
                        label="SAMPLE COURSE SYLLABUS • 2022 CURRICULUM"
                        image="/teaching-learning-assets/images/evidence-page13-syllabus.jpg"
                        imageAlt="Course Syllabus for Automata and Language Theory"
                        title="COSC 302 – Automata and Language Theory (3 Units)"
                >
                    <p>
                        <strong>Outcomes-Based Course Syllabus (OVPAA / CCIS):</strong> Covers formal models in Computer
                        Science including finite automata, regular expressions, properties of regular sets, equivalence
                        and minimization, context-free grammars, pushdown automata, and Turing machines—aligned with PUP
                        Vision, Mission, and Quality Policy.
                    </p>
                </CommonCard>
            </div>

            <div class="min-w-0">
                <CommonCard
                        label="SAMPLE INSTRUCTIONAL MATERIAL • UTLDO"
                        image="/teaching-learning-assets/images/evidence-page13-im.jpg"
                        imageAlt="Automata and Language Theory Instructional Material"
                        title="Automata and Language Theory — Compiled by Ria A. Sagum"
                >
                    <p>
                        <strong>Published & Distributed by PUP CCIS:</strong> Official UTLDO-endorsed learning module
                        for COSC 302 (CCIS 5F South Wing, PUP Main Bldg., Sta. Mesa, Manila), providing structured
                        theoretical discussions and exercises for BSCS students.
                    </p>
                </CommonCard>
            </div>

            <!-- Documentary Evidence -->
            <div class="xl:col-span-2">
                <div class="flex flex-col gap-4 border border-(--color-dark-gold) border-t-4 border-t-(--color-maroon) bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase text-(--color-maroon)">
                            25 COURSES &bull; UTLDO / CIMDA
                        </p>
                        <h3 class="mt-2 text-lg font-bold text-(--color-text-body)">
                            List of Faculty Authors in BSCS Instructional Materials
                        </h3>
                        <p class="mt-1 mb-0 text-sm text-(--color-text-body)">
                            View the complete directory of faculty authors across 25 BSCS courses on a dedicated page.
                        </p>
                    </div>

                    <a
                            href="/teaching-and-learning/faculty-authors"
                            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-(--color-gold) px-5 py-3 text-sm font-bold text-(--color-maroon) transition hover:bg-(--color-dark-gold)"
                    >
                        View Faculty Authors List →
                    </a>
                </div>
            </div>
        </div>
    </ContentSection>

    <!-- PROGRAM EDUCATIONAL OBJECTIVES & STUDENT OUTCOMES -->
    <ContentSection
            sectionLabel="SECTION 08 • STUDENT OUTCOMES & ECO-SYSTEM"
            category="Program Educational Objectives & Student Outcomes"
            description="Purposeful alignment among PEOs, SOs, curriculum, teaching-learning processes, assessment mechanisms, and graduate achievements."
    >
        <StudentOutcomes/>
    </ContentSection>

    <!-- STUDENT ECO-SYSTEM & RESEARCH COLLOQUIUM -->
    <ContentSection
            sectionLabel="SECTION 08B • STUDENT ECO-SYSTEM & RESEARCH COLLOQUIUM"
            category="Applied Learning, BSCS Thesis & Research Colloquium"
            description="Bridging theoretical foundations with real-world problem-solving, scientific inquiry, industry immersion, and scholarly dissemination."
    >
        <AppliedLearning/>
    </ContentSection>

    <!-- STUDENT ORGANIZATIONS -->
    <section class="scroll-section scrollbar-none roomy-section mx-2  pt-8 pb-16">
        <SectionContent
                title="Presentation of Student Organizations"
                sectionLabel="SECTION 08C • STUDENT OUTCOMES & ECO-SYSTEM"
        >
            <p>
                Recognized Computer Science student organizations fostering technical leadership, peer mentoring,
                community building, and co-curricular excellence.
            </p>

            <StudentOrg/>
        </SectionContent>
    </section>

    <!-- STUDENT ACHIEVEMENTS & AWARDS -->
    <section class="scroll-section scrollbar-none roomy-section mx-2  pt-8 pb-16">
        <SectionContent
                title="Student Achievements & Awards"
                sectionLabel="SECTION 09 • STUDENT ACHIEVEMENTS & AWARDS"
        >
            <p>
                National and international recognitions earned by BSCS students in competitions, hackathons, and
                research forums — sourced primarily from recognized student organizations.
            </p>

            <StudentAwards/>
        </SectionContent>
    </section>

    <!-- CS INTERNATIONAL STUDENTS -->
    <section class="scroll-section scrollbar-none roomy-section mx-2 pt-8 pb-16">
        <SectionContent
                title="CS International Students"
                sectionLabel="SECTION 10 • INTERNATIONAL STUDENTS"
        >
            <p>
                Cross-border academic mobility, inbound and outbound exchange cohorts, and international student
                participation in the BSCS program. Detailed data will be included.
            </p>

            <StudentsIntl/>
        </SectionContent>
    </section>

    <!-- ACCOMPLISHMENT REPORTS -->
    <section class="scroll-section scrollbar-none roomy-section mx-2  pt-8 pb-16">
        <SectionContent
                title="Department & Program Accomplishment Reports"
                sectionLabel="SECTION 11 • ACCOMPLISHMENT REPORTS"
        >
            <p>
                Consolidated annual and semesterly accomplishment reports documenting teaching, research, extension, and
                student development milestones.
            </p>

            <AccomplishmentReports/>

            <Area2Btn
                    title="Area 2 • Teaching & Learning • Full Report"
                    pdfSlug="area2-tl"
                    linkLabel="ACCESS FULL REPORT"
            />
        </SectionContent>
    </section>

    <!-- NOTABLE ALUMNI -->
    <section class="scroll-section scrollbar-none roomy-section mx-2  pt-8 pb-5">
        <SectionContent
                title="Notable BSCS Alumni"
                sectionLabel="SECTION 12 • NOTABLE ALUMNI • GRADUATE IMPACT"
        >
            <p>
                Distinguished BSCS graduates leading in software engineering, AI research, cybersecurity, and technology
                entrepreneurship.
            </p>

            <NotableAlumni/>
        </SectionContent>
    </section>

    <!-- GRADUATE TRACER -->
    <section class="scroll-section scrollbar-none roomy-section mx-2  pt-8 pb-10">
        <SectionContent
                title="BSCS Graduate Tracer"
                sectionLabel="SECTION 13 • GRADUATE TRACER"
        >
            <p>
                Longitudinal tracking of BSCS graduates covering employment outcomes, career progression, industry
                alignment, and continuing education.
            </p>

            <GraduateTracer/>
        </SectionContent>
    </section>

    <!-- PEO ATTAINMENT SCORES -->
    <section class="scroll-section scrollbar-none roomy-section mx-2  pt-8 pb-10">
        <SectionContent
                title="PEO Attainment Scores"
                sectionLabel="SECTION 14 • PEO ATTAINMENT SCORES"
        >
            <p>
                Comes from Graduate Tracer Surveys (2017–2022 Data set) measuring how BSCS graduates demonstrate Program
                Educational Objectives 3–5 years post-graduation.
            </p>

            <PEOScores/>
        </SectionContent>
    </section>

    <!-- PICAB -->
    <section class="scroll-section scrollbar-none roomy-section mx-2 pt-8 pb-10">
        <SectionContent
                title="PICAB Accreditation"
                sectionLabel="SECTION 15 • PICAB ACCREDITATION"
        >
            <p>
                Information regarding the Philippine Institute of Computer Engineers (PICAB) accreditation of the BSCS
                program.
            </p>

            <PICAB/>
        </SectionContent>
    </section>

    <PDFModal/>
</ScrollSnapLayout>

<style>
    .main-button {
        background: linear-gradient(90deg, #800000, #B8860B, #5C0000);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }
</style>