---
import "../../styles/global.css"; 
import ResearchHero from "../../components/ResearchHero.astro";
import ResearchMetrics from "../../components/ResearchMetrics.astro";
import FacultyShowcase from "../../components/FacultyShowcase.astro";
import IndexationChart from "../../components/IndexationChart.astro";
import IndexationDashboard from "../../components/IndexationDashboard.astro";
import PolicyFrameworkDashboard from "../../components/PolicyFrameworkDashboard.astro";
import ResearchFooter from "../../components/ResearchFooter.astro";
import SectionHeading from "../../components/SectionHeading.astro"
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Research &amp; Innovation — PUP Department of Computer Science</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-white text-neutral-900 antialiased font-['Plus_Jakarta_Sans',sans-serif]">
    <!-- Top Pill + Full-Bleed Maroon Hero -->
    <ResearchHero
      departmentCode="CS"
      departmentName="Department of Computer Science"
      departmentTag="[Research]"
      badgeLabel="Pillar 01 / Research • Department of Computer Science"
      heading="Research &"
      accentHeading="Innovation"
      subheading="39 completed studies, 24 refereed publications, and 225 citations. Research that is published, presented, cited, recognized, and used."
      description="The University envisions itself as a premier center of research in social capital and innovation towards inclusive growth for national development. Five active projects have target completion dates from July 2026 to January 2028."
    />

    <main class="space-y-20 py-16 sm:py-20">
      <!-- SECTION 01 // Research Agenda & Quality Assurance -->
      <section class="mx-auto max-w-6xl px-6 sm:px-10">
        <SectionHeading
          eyebrow="SECTION 01 // GOVERNANCE & STANDARDS"
          heading="Research Agenda & Quality Assurance"
        />
        <PolicyFrameworkDashboard
          manualLabel="BSCS AREA 1 — RESEARCH NARRATIVE"
          manualUrl="/research"
          sourceNote="SOURCE: BSCS AREA 1 — RESEARCH • UPDATED NOVEMBER 20"
        />
      </section>

      <!-- SECTION 02 // Research Metrics -->
      <ResearchMetrics
        eyebrow="SECTION 02 // KEY PERFORMANCE INDICATORS"
        heading="Research Metrics"
        class="!py-0"
      />

      <!-- SECTION 03 // Research Productivity by Calendar Year -->
      <section class="mx-auto max-w-6xl px-6 sm:px-10">
        <SectionHeading
          eyebrow="SECTION 03 // DATA PRESENTATION"
          heading="Research Productivity by Calendar Year"
        />
        <IndexationDashboard />
      </section>

      <!-- SECTION 04 // Faculty Involved in Research -->
      <section class="mx-auto max-w-6xl px-6 sm:px-10">
        <FacultyShowcase
          eyebrow="SECTION 04 // TEAM & SCHOLARS"
          heading="Faculty Involved in Research"
          guidanceLabel="FACULTY PUBLICATION CONTRIBUTIONS • 2021–2025"
        />
      </section>
    </main>

    <!-- Full-Bleed Institutional Footer -->
    <ResearchFooter />
  </body>
</html>