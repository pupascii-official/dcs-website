---
import "../styles/research.css";
import ScrollSnapLayout from "../layouts/ScrollSnapLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import ContentSection from "../components/ContentSection.astro";
import { SITE_TITLE } from "../consts";
import Navbar from "../components/Navbar.astro"
import PolicyFrameworkDashboard from "../components/research-components/PolicyFrameworkDashboard.astro";
import ResearchMetrics from "../components/research-components/ResearchMetrics.astro";
import IndexationDashboard from "../components/research-components/IndexationDashboard.astro";
import FacultyShowcase from "../components/research-components/FacultyShowcase.astro";
import StatusBadge from "../components/research-components/StatusBadge.astro";
import Footer from "../components/Footer.astro";
---

<ScrollSnapLayout
  title={`Research & Innovation — ${SITE_TITLE}`}
  description="39 completed studies, 24 refereed publications, and 225 citations. PUP Department of Computer Science Area 1: Research."
  bodyClass="research-page bg-white text-neutral-900 antialiased font-sans"
>
  <!-- SNAP 1 // Hero -->
  <HeroSection
    variant="research"
    title="Research & Innovation"
    subtitle="Pillar 01 / Research • Department of Computer Science"
  >
    <Navbar
    />

    <p class="mt-6 mb-0 max-w-xl text-[13px] sm:text-[14px] font-medium leading-[1.6] text-white/90">
      Completed research, disseminated publications, high-impact indexation rates, and faculty
      research involvement shaping the future of information systems and computer vision.
      with 39 completed studies, 24 refereed publications, and 225 citations.
    </p>

    <p class="mt-3.5 mb-0 max-w-xl text-[11.5px] sm:text-[12px] leading-[1.65] text-white/60">
      The College of Computer and Information Sciences translate the University's general research themes
      into program research areas that reflect the role of computing, information technology, and digital Innovation
      in addressing contemporary challenges.
      
    </p>
  </HeroSection>

  <!-- SNAP 2 // Section 01: Research Agenda & Quality Assurance -->
  <ContentSection
    surface="white"
    sectionLabel="SECTION 01 // GOVERNANCE & STANDARDS"
    category="Research Agenda & Quality Assurance"
  >
    <PolicyFrameworkDashboard
      manualLabel="ACCESS FULL PUP RESEARCH & DEVELOPMENT MANUAL"
      manualUrl="https://tinyurl.com/DCSArea1Research"
      openInNewTab={true}
      sourceNote="SOURCE: BSCS AREA 1 — RESEARCH"
    />
  </ContentSection>

  <!-- SNAP 3 // Section 02: Research Metrics -->
  <ContentSection
    surface="white"
    sectionLabel="SECTION 02 // KEY PERFORMANCE INDICATORS"
    category="Research Metrics"
  >
    <ResearchMetrics showHeader={false} class="!py-0" />
  </ContentSection>

  <!-- SNAP 4 // Section 03: Research Productivity by Calendar Year -->
  <ContentSection
    surface="white"
    sectionLabel="SECTION 03 // DATA PRESENTATION"
    category="Research Productivity by Calendar Year"
  >
    <IndexationDashboard />
  </ContentSection>

  <!-- SNAP 5 // Section 04: Faculty Involved in Research + Institutional Footer -->
  <section class="scroll-section w-full bg-white flex flex-col">
    <div class="my-auto w-full py-10 sm:py-12">
      <ContentSection
        surface="white"
        snap={false}
        sectionLabel="SECTION 04 // TEAM & SCHOLARS"
        category="Faculty Involved in Research"
      >
        <StatusBadge
          slot="action"
          label="FACULTY PUBLICATION CONTRIBUTIONS • 2021–2025"
          variant="faculty-guidance"
        />
        <FacultyShowcase showHeading={false} guidanceLabel="" />
      </ContentSection>
    </div>

    <Footer/>
  </section>
</ScrollSnapLayout>