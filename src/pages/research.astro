---
import "../styles/research.css";
import ScrollSnapLayout from "../layouts/ScrollSnapLayout.astro";
import ContentSection from "../components/ContentSection.astro";
import { SITE_TITLE } from "../consts";
import PolicyFrameworkDashboard from "../components/research-components/PolicyFrameworkDashboard.astro";
import ResearchMetrics from "../components/research-components/ResearchMetrics.astro";
import IndexationDashboard from "../components/research-components/IndexationDashboard.astro";
import FacultyShowcase from "../components/research-components/FacultyShowcase.astro";
import HeroSection from "../components/HeroSection.astro";
import PDFModal from "../components/PDFModal.astro";
import LinkCard from "../components/LinkCard.astro";
import HeroButton from "../components/HeroButton.astro";
import { getDocRef } from "../lib/pdfs.server"
const manualDocRef = getDocRef("research-manual");
---

<ScrollSnapLayout
  title={`Research & Innovation — ${SITE_TITLE}`}
  description="39 completed studies, 24 refereed publications, and 225 citations. PUP Department of Computer Science Area 1: Research."
>
  <div class="research-page bg-white text-neutral-900 antialiased font-sans">
    <!-- SNAP 1 // Hero -->
    <HeroSection title="Research &"
    accentTitle="Innovation">
      <p class="mx-auto mt-0 mb-0 max-w-2xl text-[13.5px] sm:text-[16px] font-normal leading-[1.6] text-white/90 text-center">
        39 completed studies, 24 refereed publications, and 225 citations. Research
        that is published, presented, cited, recognized, and used.
      </p>

      <p class="mx-auto mt-3 sm:mt-4 mb-0 max-w-xl text-[12px] sm:text-[13px] font-normal leading-[1.65] text-white/75 text-center">
        The University envisions itself as a premier center of research in social
        capital and innovation towards inclusive growth for national development.
        Five active projects have target completion dates from July 2026 to
        January 2028.
      </p>

    <HeroButton
        label="Area 1 Narrative Report"
        docRef={manualDocRef}
        pdfTitle="PUP Research & Development Manual"
        />
    </HeroSection>

    <!-- SNAP 2 // Section 01: Research Agenda & Quality Assurance -->
    <ContentSection
      sectionLabel="SECTION 01 // GOVERNANCE & STANDARDS"
      category="Research Agenda & Quality Assurance"
    >
      <PolicyFrameworkDashboard />
    </ContentSection>

    <!-- SNAP 3 // Section 02: Research Metrics -->
    <ContentSection
      sectionLabel="SECTION 02 // KEY PERFORMANCE INDICATORS"
      category="Research Metrics"
    >
      <ResearchMetrics showHeader={false} class="!py-0" />
    </ContentSection>

    <!-- SNAP 4 // Section 03: Research Productivity by Calendar Year -->
    <ContentSection
      sectionLabel="SECTION 03 // DATA PRESENTATION"
      category="Research Productivity by Calendar Year"
    >
      <IndexationDashboard />
    </ContentSection>

    <!-- Section 04: Faculty Involved in Research -->
    <section class="scroll-section w-full bg-white py-14 sm:py-18">
      <div class="mx-auto w-full max-w-6xl px-5 sm:px-10">
        <FacultyShowcase/>
      </div>
    </section>
  </div>

  <PDFModal />
</ScrollSnapLayout>